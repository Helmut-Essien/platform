@page "/invoices/{Id}"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@implements IDisposable
<PageTitle>@(_invoice?.InvoiceNumber is { Length: > 0 } num ? $"Invoice {num}" : "Invoice") · HelmutCode Admin</PageTitle>

<div class="invoice-detail-page page-content">
@if (_loading)
{
    <div class="invoice-detail-loading" aria-busy="true" aria-label="Loading invoice">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="3.5rem" Width="40%" Class="mb-4" />
        <div class="invoice-detail-summary-grid">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="11rem" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="11rem" />
        </div>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="12rem" Class="mt-4" />
    </div>
}
else if (_invoice is null)
{
    <header class="invoice-detail-header">
        <div>
            <a href="/invoices" class="invoice-detail-back">← Back to invoices</a>
            @if (_notFound)
            {
                <h1 class="page-title">Invoice not found</h1>
                <p class="page-subtitle">This invoice may have been removed or the link is invalid.</p>
            }
            else
            {
                <h1 class="page-title">Couldn't load invoice</h1>
                <p class="page-subtitle">Something went wrong while loading this invoice. Check your connection and try again.</p>
                <button type="button" class="btn-primary-cta mt-3" @onclick="LoadAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                    Retry
                </button>
            }
        </div>
    </header>
}
else
{
    <header class="invoice-detail-header">
        <div class="invoice-detail-header-main">
            <a href="/invoices" class="invoice-detail-back">← Back to invoices</a>
            <div class="invoice-detail-title-row">
                <h1 class="page-title">@_invoice.InvoiceNumber</h1>
                <StatusBadge InvoiceStatus="_invoice.Status" />
            </div>
            <p class="page-subtitle">
                @_invoice.CustomerName
                @if (!string.IsNullOrEmpty(_invoice.ServiceProductCode))
                {
                    <text> · @_invoice.ServiceProductCode</text>
                }
                @if (!string.IsNullOrEmpty(_invoice.PlanName))
                {
                    <text> · @_invoice.PlanName</text>
                }
            </p>
        </div>
        <div class="invoice-detail-actions" aria-busy="@(_busy ? "true" : "false")">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" aria-label="Working…" />
            }
            @if (_invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Sent or InvoiceStatus.PartiallyPaid or InvoiceStatus.Overdue)
            {
                @* "Send again" is secondary so "Record payment" stays the primary action on sent invoices. *@
                <button type="button" class="@(_invoice.Status == InvoiceStatus.Draft ? "btn-primary-cta" : "btn-secondary-cta")" @onclick="() => RunExclusiveAsync(SendInvoiceAsyncCore)" disabled="@_busy">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />
                    @(_invoice.Status == InvoiceStatus.Draft ? "Send invoice" : "Send again")
                </button>
            }
            @if (_invoice.Status is InvoiceStatus.Sent or InvoiceStatus.PartiallyPaid or InvoiceStatus.Overdue)
            {
                @if (_invoice.AmountDue > 0)
                {
                    <button type="button" class="btn-primary-cta" @onclick="() => RunExclusiveAsync(RecordPaymentAsyncCore)" disabled="@_busy">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                        Record payment
                    </button>
                    @if (CanPayOnline)
                    {
                        <button type="button" class="btn-secondary-cta" @onclick="() => RunExclusiveAsync(PayOnlineAsyncCore)" disabled="@(_busy || _confirming)"
                                title="Open Paystack checkout (card or mobile money) for the outstanding balance">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" />
                            Pay with Paystack
                        </button>
                    }
                }
            }
            @if (_invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Sent or InvoiceStatus.Overdue
                 || (_invoice.Status == InvoiceStatus.PartiallyPaid && _invoice.AmountPaid == 0))
            {
                <button type="button" class="btn-invoice-void" @onclick="() => RunExclusiveAsync(VoidAsyncCore)" disabled="@_busy">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
                    Void
                </button>
            }
        </div>
    </header>

    @if (_confirming)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.HourglassTop">
            Confirming payment with Paystack…
        </MudAlert>
    }
    else if (_paymentNotice is not null)
    {
        <MudAlert Severity="_paymentNoticeSeverity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _paymentNotice = null">
            @_paymentNotice
        </MudAlert>
    }

    <section class="invoice-detail-summary-grid" aria-label="Invoice summary">
        <article class="invoice-detail-panel">
            <h2 class="invoice-detail-panel-title">Details</h2>
            <dl class="invoice-detail-meta">
                <div>
                    <dt>Customer</dt>
                    <dd>@_invoice.CustomerName</dd>
                </div>
                @if (!string.IsNullOrEmpty(_invoice.ServiceProductCode))
                {
                    <div>
                        <dt>Service</dt>
                        <dd class="mono">@_invoice.ServiceProductCode</dd>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_invoice.PlanName))
                {
                    <div>
                        <dt>Plan</dt>
                        <dd>@_invoice.PlanName</dd>
                    </div>
                }
                <div>
                    <dt>Issue date</dt>
                    <dd class="mono">@DateFormat.Date(_invoice.IssueDate)</dd>
                </div>
                <div>
                    <dt>Due date</dt>
                    <dd class="mono">@DateFormat.Date(_invoice.DueDate)</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(_invoice.Description))
                {
                    <div class="invoice-detail-meta-full">
                        <dt>Description</dt>
                        <dd>@_invoice.Description</dd>
                    </div>
                }
            </dl>
        </article>

        <article class="invoice-detail-panel invoice-detail-money-panel">
            <h2 class="invoice-detail-panel-title">Amounts</h2>
            <div class="invoice-detail-money-stack">
                <div class="invoice-detail-money-row">
                    <span>Subtotal</span>
                    <span class="mono">@FormatMoney(_invoice.Subtotal, _invoice.Currency)</span>
                </div>
                <div class="invoice-detail-money-row">
                    <span>Tax</span>
                    <span class="mono">@FormatMoney(_invoice.TaxAmount, _invoice.Currency)</span>
                </div>
                <div class="invoice-detail-money-row invoice-detail-money-total">
                    <span>Total</span>
                    <span class="mono">@FormatMoney(_invoice.TotalAmount, _invoice.Currency)</span>
                </div>
                <div class="invoice-detail-money-row">
                    <span>Paid</span>
                    <span class="mono invoice-detail-money-paid">@FormatMoney(_invoice.AmountPaid, _invoice.Currency)</span>
                </div>
                <div class="invoice-detail-money-row invoice-detail-money-due">
                    <span>Amount due</span>
                    <span class="mono">@FormatMoney(_invoice.AmountDue, _invoice.Currency)</span>
                </div>
            </div>
        </article>
    </section>

    <section class="invoice-detail-receipts-panel" aria-label="Receipts">
        <div class="invoice-detail-section-head">
            <h2>Receipts</h2>
            <span class="invoice-detail-section-count">@_invoice.Receipts.Count</span>
        </div>

        @if (_invoice.Receipts.Count == 0)
        {
            <div class="invoice-detail-empty">
                <p>No payments recorded yet.</p>
                @if (_invoice.Status is InvoiceStatus.Sent or InvoiceStatus.PartiallyPaid or InvoiceStatus.Overdue
                     && _invoice.AmountDue > 0)
                {
                    <button type="button" class="btn-primary-cta" @onclick="() => RunExclusiveAsync(RecordPaymentAsyncCore)" disabled="@_busy">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                        Record payment
                    </button>
                }
            </div>
        }
        else
        {
            <div class="invoice-detail-receipts-table-wrap">
                <table class="invoice-detail-receipts-table">
                    <thead>
                        <tr>
                            <th>Receipt</th>
                            <th class="cell-right">Amount</th>
                            <th>Method</th>
                            <th>Reference</th>
                            <th>Status</th>
                            <th>Paid at</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var receipt in _invoice.Receipts.OrderByDescending(r => r.PaidAt))
                        {
                            <tr class="@(receipt.Status == ReceiptStatus.Reversed ? "is-reversed" : null)">
                                <td class="mono">@receipt.ReceiptNumber</td>
                                <td class="cell-right mono">@FormatMoney(receipt.AmountPaid, _invoice.Currency)</td>
                                <td>@receipt.PaymentMethod</td>
                                <td class="mono">@(string.IsNullOrWhiteSpace(receipt.PaymentReference) ? "—" : receipt.PaymentReference)</td>
                                <td><StatusBadge ReceiptStatus="receipt.Status" /></td>
                                <td class="mono">@DateFormat.DateAndTime(receipt.PaidAt)</td>
                                <td class="cell-right">
                                    @if (receipt.Status == ReceiptStatus.Posted)
                                    {
                                        <button type="button" class="btn-receipt-reverse" @onclick="() => RunExclusiveAsync(() => ReversePaymentAsync(receipt))" disabled="@_busy">
                                            Reverse
                                        </button>
                                    }
                                    else if (!string.IsNullOrEmpty(receipt.ReversalReason))
                                    {
                                        <span class="invoice-detail-reversal-reason" title="@receipt.ReversalReason">
                                            @Truncate(receipt.ReversalReason, 40)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="invoice-detail-delivery-panel" aria-label="Email deliveries">
        <DeliveryTimeline InvoiceId="@_invoice.Id" />
    </section>
}
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    /// <summary>"return" when Paystack sends the payer back; "cancelled" when they cancel checkout.</summary>
    [SupplyParameterFromQuery(Name = "payment")] public string? PaymentQuery { get; set; }

    /// <summary>Paystack appends ?reference=… (and trxref) to the callback URL.</summary>
    [SupplyParameterFromQuery(Name = "reference")] public string? ReferenceQuery { get; set; }

    private readonly CancellationTokenSource _disposeCts = new();
    private OnlinePaymentsStatusDto? _onlinePayments;
    private bool _confirming;
    private string? _paymentNotice;
    private Severity _paymentNoticeSeverity = Severity.Info;
    private string? _handledPaymentQuery;

    private bool CanPayOnline =>
        _onlinePayments?.Enabled == true
        && _invoice is { AmountDue: > 0 } inv
        && string.Equals(inv.Currency, _onlinePayments.Currency, StringComparison.OrdinalIgnoreCase)
        && inv.Status is InvoiceStatus.Sent or InvoiceStatus.PartiallyPaid or InvoiceStatus.Overdue;

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private async Task LoadOnlinePaymentsAsync()
    {
        if (_onlinePayments is not null)
            return;
        try
        {
            _onlinePayments = await Api.GetOnlinePaymentsStatusAsync(_disposeCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PayOnlineAsyncCore()
    {
        if (_invoice is null)
            return;

        var result = await Api.StartCheckoutAsync(_invoice.Id);
        if (!result.IsSuccess || result.Data is null)
        {
            Snackbar.Add(result.ErrorMessage ?? "Couldn't start the Paystack checkout.", Severity.Error);
            return;
        }

        // Full page load: Paystack checkout is an external site and returns to ?payment=return.
        Navigation.NavigateTo(result.Data.AuthorizationUrl, forceLoad: true);
    }

    /// <summary>Handles the Paystack return (?payment=return / cancelled) once, then cleans the URL.</summary>
    private async Task HandlePaymentReturnAsync()
    {
        var payment = PaymentQuery?.Trim().ToLowerInvariant();
        if (payment is not ("return" or "cancelled") || _invoice is null)
            return;

        var key = $"{_invoice.Id}|{payment}|{ReferenceQuery}";
        if (_handledPaymentQuery == key)
            return;
        _handledPaymentQuery = key;

        var invoiceId = _invoice.Id;
        var reference = ReferenceQuery;
        Navigation.NavigateTo($"invoices/{Uri.EscapeDataString(invoiceId)}", replace: true);

        if (payment == "cancelled")
        {
            ShowPaymentNotice("Paystack checkout was cancelled. No payment was taken.", Severity.Warning);
            return;
        }

        _confirming = true;
        StateHasChanged();
        try
        {
            CheckoutStatusDto? last = null;
            for (var attempt = 0; attempt < 6; attempt++)
            {
                if (attempt > 0)
                    await Task.Delay(TimeSpan.FromSeconds(Math.Min(2 * attempt, 6)), _disposeCts.Token);

                var result = await Api.GetCheckoutStatusAsync(invoiceId, reference, _disposeCts.Token);
                if (result.IsSuccess && result.Data is not null)
                {
                    last = result.Data;
                    if (last.Status != PaymentCheckoutStatus.Pending)
                        break;
                }
            }

            _confirming = false;
            await LoadAsync();
            switch (last?.Status)
            {
                case PaymentCheckoutStatus.Paid:
                    ShowPaymentNotice($"Payment of {FormatMoney(last.Amount, last.Currency)} received via Paystack. Receipt recorded.", Severity.Success);
                    break;
                case PaymentCheckoutStatus.Failed:
                    ShowPaymentNotice($"The Paystack payment failed{(string.IsNullOrWhiteSpace(last.Message) ? "." : $": {last.Message}")}", Severity.Error);
                    break;
                case PaymentCheckoutStatus.NeedsReview:
                    ShowPaymentNotice("Paystack reported a payment that doesn't match this invoice (amount, currency or status changed). Check the Paystack dashboard and record it manually.", Severity.Warning);
                    break;
                default:
                    ShowPaymentNotice("Paystack hasn't confirmed the payment yet. It will be recorded automatically once confirmed — refresh in a minute.", Severity.Info);
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // Left the page while polling.
        }
        finally
        {
            _confirming = false;
        }
    }

    private void ShowPaymentNotice(string message, Severity severity)
    {
        _paymentNotice = message;
        _paymentNoticeSeverity = severity;
    }

    private bool _loading = true;
    private bool _loaded;
    private InvoiceDto? _invoice;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadOnlinePaymentsAsync());
        await HandlePaymentReturnAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
            await LoadAsync();
    }

    private bool _busy;
    private int _loadVersion;

    private bool _notFound;
    private bool _loadFailed;

    private async Task LoadAsync()
    {
        var requestedId = Id;
        var version = ++_loadVersion;
        // Keep showing the current invoice while refreshing after an action; a different invoice shows the skeleton.
        if (_invoice?.Id != requestedId)
            _loading = true;

        var lookup = await Api.LookupInvoiceAsync(requestedId);
        if (version != _loadVersion)
            return; // a newer navigation/refresh superseded this response

        var refreshingCurrent = _invoice?.Id == requestedId;
        if (lookup.IsFound)
        {
            _invoice = lookup.Value;
            _notFound = _loadFailed = false;
        }
        else if (refreshingCurrent && lookup.IsError)
        {
            // A transient failure while refreshing keeps the invoice we already show.
            Snackbar.Add("Couldn't refresh the invoice. The details shown may be out of date.", Severity.Warning);
        }
        else
        {
            _invoice = null;
            _notFound = lookup.NotFound;
            _loadFailed = lookup.IsError;
        }

        _loading = false;
        _loaded = true;
    }

    /// <summary>Runs one action at a time so a double click cannot send/void/record twice.</summary>
    private async Task RunExclusiveAsync(Func<Task> action)
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RecordPaymentAsyncCore()
    {
        if (_invoice is null)
            return;

        // Saved inside the dialog (busy state, closes only on success); result captured here for feedback.
        var invoiceId = _invoice.Id;
        ApiResult<ReceiptDto>? apiResult = null;
        Task<ApiResult<ReceiptDto>>? pending = null;
        Func<RecordReceiptRequest, Task<string?>> submit = async request =>
        {
            pending = Api.RecordReceiptAsync(invoiceId, request);
            apiResult = await pending;
            return apiResult.IsSuccess ? null : apiResult.ErrorMessage ?? "Failed to record payment.";
        };
        var dialog = await DialogService.ShowAsync<RecordReceiptDialog>("Record Payment", new DialogParameters
        {
            [nameof(RecordReceiptDialog.AmountDue)] = _invoice.AmountDue,
            [nameof(RecordReceiptDialog.Submit)] = submit
        });
        await dialog.Result;
        if (pending is not null && apiResult is null)
        {
            // Dialog dismissed (Esc/backdrop) while saving: still report the outcome.
            try { apiResult = await pending; } catch { return; }
            if (!apiResult.IsSuccess)
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to record payment.", Severity.Error);
        }
        if (apiResult is not { IsSuccess: true })
            return;

        Snackbar.Add("Payment recorded.", Severity.Success);
        await LoadAsync();
    }

    private async Task ReversePaymentAsync(ReceiptDto receipt)
    {
        if (_invoice is null)
            return;

        // Saved inside the dialog (busy state, closes only on success); result captured here for feedback.
        var invoiceId = _invoice.Id;
        ApiResult<ReceiptDto>? apiResult = null;
        Task<ApiResult<ReceiptDto>>? pending = null;
        Func<ReverseReceiptRequest, Task<string?>> submit = async request =>
        {
            pending = Api.ReverseReceiptAsync(invoiceId, receipt.Id, request);
            apiResult = await pending;
            return apiResult.IsSuccess ? null : apiResult.ErrorMessage ?? "Failed to reverse payment.";
        };
        var dialog = await DialogService.ShowAsync<ReverseReceiptDialog>("Reverse Payment", new DialogParameters
        {
            [nameof(ReverseReceiptDialog.ReceiptNumber)] = receipt.ReceiptNumber,
            [nameof(ReverseReceiptDialog.Amount)] = receipt.AmountPaid,
            [nameof(ReverseReceiptDialog.Submit)] = submit
        });
        await dialog.Result;
        if (pending is not null && apiResult is null)
        {
            // Dialog dismissed (Esc/backdrop) while saving: still report the outcome.
            try { apiResult = await pending; } catch { return; }
            if (!apiResult.IsSuccess)
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to reverse payment.", Severity.Error);
        }
        if (apiResult is not { IsSuccess: true })
            return;

        Snackbar.Add("Payment reversed.", Severity.Success);
        await LoadAsync();
    }

    private async Task SendInvoiceAsyncCore()
    {
        if (_invoice is null)
            return;
        var result = await Api.SendInvoiceAsync(_invoice.Id);
        Snackbar.Add(
            result.IsSuccess ? "Invoice email queued." : result.ErrorMessage ?? "Failed to queue invoice.",
            result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess)
            await LoadAsync();
    }

    private async Task VoidAsyncCore()
    {
        if (_invoice is null)
            return;

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Void Invoice", new DialogParameters
        {
            ["Title"] = "Void Invoice",
            ["Message"] = "This will void the invoice. Continue?",
            ["ConfirmText"] = "Void",
            ["IsDestructive"] = true
        }, PlatformDialogOptions.Confirm);
        var result = await dialog.Result;
        if (result?.Canceled is not false)
            return;

        var apiResult = await Api.VoidInvoiceAsync(_invoice.Id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to void invoice.", Severity.Error);
            return;
        }

        Snackbar.Add("Invoice voided.", Severity.Success);
        await LoadAsync();
    }

    private static string FormatMoney(decimal amount, string currency)
    {
        var code = string.IsNullOrWhiteSpace(currency) ? "USD" : currency.Trim().ToUpperInvariant();
        return code switch
        {
            "USD" => $"${amount:N2}",
            "EUR" => $"€{amount:N2}",
            "GBP" => $"£{amount:N2}",
            "GHS" => $"GH₵{amount:N2}",
            _ => $"{code} {amount:N2}"
        };
    }

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..(max - 1)] + "…";
}
