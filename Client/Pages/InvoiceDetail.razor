@page "/invoices/{Id}"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="page-content">
@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-4" />
}
else if (_invoice is null)
{
    <h1 class="page-title">Invoice not found</h1>
    <MudButton Variant="Variant.Text" Href="/invoices">Back to invoices</MudButton>
}
else
{
    <header class="invoice-detail-header">
        <h1 class="page-title">Invoice @_invoice.InvoiceNumber</h1>
        <div class="d-flex gap-2 flex-wrap">
            @if (_invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Sent or InvoiceStatus.PartiallyPaid or InvoiceStatus.Overdue)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendInvoiceAsync">
                    @(_invoice.Status == InvoiceStatus.Draft ? "Send invoice" : "Send again")
                </MudButton>
            }
            @if (_invoice.Status is InvoiceStatus.Sent or InvoiceStatus.PartiallyPaid or InvoiceStatus.Overdue)
            {
                @if (_invoice.AmountDue > 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RecordPaymentAsync">Record payment</MudButton>
                }
            }
            @if (_invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Sent or InvoiceStatus.Overdue
                 || (_invoice.Status == InvoiceStatus.PartiallyPaid && _invoice.AmountPaid == 0))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="VoidAsync">Void</MudButton>
            }
        </div>
    </header>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="0">
                <MudChip T="string" Size="Size.Small" Variant="@GetStatusVariant(_invoice.Status)" Color="Color.Primary" Class="mb-2">@_invoice.Status</MudChip>
                <MudText><strong>Customer:</strong> @_invoice.CustomerName</MudText>
                @if (!string.IsNullOrEmpty(_invoice.ServiceProductCode))
                {
                    <MudText><strong>Service:</strong> @_invoice.ServiceProductCode</MudText>
                }
                <MudText><strong>Issue date:</strong> @_invoice.IssueDate.ToString("yyyy-MM-dd")</MudText>
                <MudText><strong>Due:</strong> @(_invoice.DueDate?.ToString("yyyy-MM-dd") ?? "—")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="0">
                <MudText>Subtotal: @_invoice.Subtotal.ToString("N2") @_invoice.Currency</MudText>
                <MudText>Tax: @_invoice.TaxAmount.ToString("N2")</MudText>
                <MudText><strong>Total: @_invoice.TotalAmount.ToString("N2")</strong></MudText>
                <MudText>Paid: @_invoice.AmountPaid.ToString("N2")</MudText>
                <MudText Color="Color.Primary"><strong>Due: @_invoice.AmountDue.ToString("N2")</strong></MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-2">Receipts</MudText>
    @if (_invoice.Receipts.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mb-4">No payments recorded.</MudText>
    }
    else
    {
        <MudTable Items="_invoice.Receipts" Dense="true" Hover="true" Class="mb-4">
            <HeaderContent>
                <MudTh>Receipt #</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Method</MudTh>
                <MudTh>Reference</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Paid at</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ReceiptNumber</MudTd>
                <MudTd>@context.AmountPaid.ToString("N2")</MudTd>
                <MudTd>@context.PaymentMethod</MudTd>
                <MudTd>@(context.PaymentReference ?? "—")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd>@context.PaidAt.ToString("g")</MudTd>
                <MudTd>
                    @if (context.Status == ReceiptStatus.Posted)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   OnClick="@(() => ReversePaymentAsync(context))">
                            Reverse
                        </MudButton>
                    }
                    else if (!string.IsNullOrEmpty(context.ReversalReason))
                    {
                        <MudText Typo="Typo.caption">@context.ReversalReason</MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <DeliveryTimeline InvoiceId="@_invoice.Id" />
    </MudPaper>

    <MudButton Variant="Variant.Text" Href="/invoices">Back to invoices</MudButton>
}
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private bool _loading = true;
    private bool _loaded;
    private InvoiceDto? _invoice;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _invoice = await Api.GetInvoiceAsync(Id);
        _loading = false;
        _loaded = true;
    }

    private async Task RecordPaymentAsync()
    {
        if (_invoice is null)
            return;

        var dialog = await DialogService.ShowAsync<RecordReceiptDialog>("Record Payment", new DialogParameters
        {
            [nameof(RecordReceiptDialog.AmountDue)] = _invoice.AmountDue
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not RecordReceiptRequest request)
            return;

        var apiResult = await Api.RecordReceiptAsync(_invoice.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to record payment.", Severity.Error);
            return;
        }

        Snackbar.Add("Payment recorded.", Severity.Success);
        await LoadAsync();
    }

    private async Task ReversePaymentAsync(ReceiptDto receipt)
    {
        if (_invoice is null)
            return;

        var dialog = await DialogService.ShowAsync<ReverseReceiptDialog>("Reverse Payment", new DialogParameters
        {
            [nameof(ReverseReceiptDialog.ReceiptNumber)] = receipt.ReceiptNumber,
            [nameof(ReverseReceiptDialog.Amount)] = receipt.AmountPaid
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not ReverseReceiptRequest request)
            return;

        var apiResult = await Api.ReverseReceiptAsync(_invoice.Id, receipt.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to reverse payment.", Severity.Error);
            return;
        }

        Snackbar.Add("Payment reversed.", Severity.Success);
        await LoadAsync();
    }

    private async Task SendInvoiceAsync()
    {
        if (_invoice is null)
            return;
        var result = await Api.SendInvoiceAsync(_invoice.Id);
        Snackbar.Add(
            result.IsSuccess ? "Invoice email queued." : result.ErrorMessage ?? "Failed to queue invoice.",
            result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess)
            await LoadAsync();
    }

    private async Task VoidAsync()
    {
        if (_invoice is null)
            return;

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Void Invoice", new DialogParameters
        {
            ["Title"] = "Void Invoice",
            ["Message"] = "This will void the invoice. Continue?",
            ["ConfirmText"] = "Void",
            ["IsDestructive"] = true
        }, PlatformDialogOptions.Confirm);
        var result = await dialog.Result;
        if (result?.Canceled is not false)
            return;

        var apiResult = await Api.VoidInvoiceAsync(_invoice.Id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Failed to void invoice.", Severity.Error);
            return;
        }

        Snackbar.Add("Invoice voided.", Severity.Success);
        await LoadAsync();
    }

    private static Variant GetStatusVariant(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => Variant.Filled,
        InvoiceStatus.Sent => Variant.Outlined,
        InvoiceStatus.PartiallyPaid => Variant.Outlined,
        InvoiceStatus.Overdue => Variant.Filled,
        InvoiceStatus.Void => Variant.Text,
        InvoiceStatus.Draft => Variant.Text,
        _ => Variant.Text
    };
}
