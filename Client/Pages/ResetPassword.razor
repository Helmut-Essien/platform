@page "/reset-password"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject PlatformApiClient Api
@inject NavigationManager Navigation

<MudPaper Class="login-card pa-5 pa-sm-8" Elevation="0">
    <div class="login-brand">
        <img src="images/login-logo.png" alt="HelmutCode" class="login-logo" />
        <MudText Typo="Typo.body2" Class="login-subtitle">
            Choose a new password
        </MudText>
    </div>

    <MudDivider Class="login-divider" />

    @if (_completed)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="login-error">
            Password updated. You can sign in with your new password.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="login-submit mt-4"
                   OnClick="@(() => Navigation.NavigateTo("/login"))">
            Sign in
        </MudButton>
    }
    else
    {
        @if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="login-error"
                      CloseIconClicked="@(() => _hasError = false)"
                      ShowCloseIcon="true">
                @_errorMessage
            </MudAlert>
        }

        <form class="login-form" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
            <MudTextField Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          FullWidth="true"
                          Disabled="true" />

            <MudTextField @bind-Value="_newPassword"
                          Label="New password"
                          Variant="Variant.Outlined"
                          InputType="@(_passwordVisible ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _passwordVisible = !_passwordVisible"
                          FullWidth="true"
                          Required="true"
                          Disabled="_busy" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm password"
                          Variant="Variant.Outlined"
                          InputType="@(_passwordVisible ? InputType.Text : InputType.Password)"
                          FullWidth="true"
                          Required="true"
                          Disabled="_busy" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="login-submit"
                       Disabled="@(_busy || !CanSubmit)">
                @if (_busy)
                {
                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Updating...</span>
                }
                else
                {
                    <span>Update password</span>
                }
            </MudButton>
        </form>
    }

    <MudLink Href="/login" Class="mt-4 d-block">Back to sign in</MudLink>
</MudPaper>

@code {
    private bool _busy;
    private bool _passwordVisible;
    private bool _hasError;
    private bool _completed;
    private string _errorMessage = "";
    private string _email = "";
    private string _token = "";
    private string _newPassword = "";
    private string _confirmPassword = "";

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_newPassword)
        && _newPassword.Length >= 8
        && string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal);

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2)
                continue;

            var key = Uri.UnescapeDataString(pair[0]);
            var value = Uri.UnescapeDataString(pair[1]);
            if (key.Equals("email", StringComparison.OrdinalIgnoreCase))
                _email = value;
            else if (key.Equals("token", StringComparison.OrdinalIgnoreCase))
                _token = value;
        }

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_token))
        {
            _hasError = true;
            _errorMessage = "Invalid or missing reset link. Request a new reset email.";
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (_busy || !CanSubmit)
            return;

        _busy = true;
        _hasError = false;
        try
        {
            var result = await Api.ResetPasswordAsync(new ResetPasswordRequest
            {
                Email = _email.Trim(),
                Token = _token,
                NewPassword = _newPassword
            });

            if (!result.IsSuccess)
            {
                _hasError = true;
                _errorMessage = result.ErrorMessage ?? "Password reset failed.";
                return;
            }

            _completed = true;
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = "Reset failed. Check that the API is running and try again.";
            Console.Error.WriteLine($"Reset password error: {ex}");
        }
        finally
        {
            _busy = false;
        }
    }
}
