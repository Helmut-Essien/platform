@page "/"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject NavigationManager Navigation
<PageTitle>Dashboard · HelmutCode Admin</PageTitle>

<div class="dashboard-page page-content">
    <header class="dashboard-header">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Overview of customers, licenses, and billing.</p>
    </header>

    @if (_loading)
    {
        <div class="dashboard-kpi-grid">
            @for (var i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="dashboard-skeleton-kpi" />
            }
        </div>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="dashboard-skeleton-main mt-4" />
    }
    else
    {
        @if (_statsFailed || _auditFailed)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" ContentAlignment="HorizontalAlignment.Left">
                @(_statsFailed ? "Couldn't load the dashboard figures; the numbers below may be out of date." : "Couldn't load recent activity.")
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="ml-2" OnClick="RetryAsync">Retry</MudButton>
            </MudAlert>
        }
        <section class="dashboard-kpi-grid" aria-label="Key metrics">
            <a class="kpi-card" href="/customers">
                <div class="kpi-card-head">
                    <span class="kpi-card-label">Total Customers</span>
                    <MudIcon Icon="@Icons.Material.Filled.Group" Class="kpi-card-icon" />
                </div>
                <div class="kpi-card-value">@_customerCount</div>
                <div class="kpi-card-foot">
                    <span class="highlight-primary">Registered</span>
                    <span>organizations</span>
                </div>
            </a>

            <a class="kpi-card" href="/licenses">
                <div class="kpi-card-head">
                    <span class="kpi-card-label">Active Licenses</span>
                    <MudIcon Icon="@Icons.Material.Filled.VpnKey" Class="kpi-card-icon" />
                </div>
                <div class="kpi-card-value">@_activeLicenses</div>
                <div class="kpi-card-foot">
                    <span class="highlight-primary">Status: Active</span>
                    <span>(excludes suspended customers)</span>
                </div>
            </a>

            <a class="kpi-card" href="/licenses?filter=expiring">
                <div class="kpi-card-head">
                    <span class="kpi-card-label">Expiring in 30 Days</span>
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="kpi-card-icon" />
                </div>
                <div class="kpi-card-value">@_expiringSoon</div>
                <div class="kpi-card-foot">
                    @if (_expiringSoon > 0)
                    {
                        <span class="highlight-attention">Attention</span>
                        <span>required</span>
                    }
                    else
                    {
                        <span class="highlight-primary">All clear</span>
                    }
                </div>
            </a>

            <a class="kpi-card" href="/invoices?filter=unpaid">
                <div class="kpi-card-head">
                    <span class="kpi-card-label">Unpaid Invoices</span>
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="kpi-card-icon" />
                </div>
                <div class="kpi-card-value">@_unpaidInvoices</div>
                <div class="kpi-card-foot">
                    @if (_unpaidInvoices > 0)
                    {
                        <span>Pending</span>
                        <span>reconciliation</span>
                    }
                    else
                    {
                        <span class="highlight-primary">Fully</span>
                        <span>reconciled</span>
                    }
                </div>
            </a>
        </section>

        <div class="dashboard-main-grid">
            <section class="dashboard-timeline-panel" aria-label="Recent activity">
                <div class="timeline-panel-head">
                    <h2>Recent Activity</h2>
                </div>

                @if (_recentAudit.Count == 0)
                {
                    <p class="timeline-empty">No recent activity yet. Actions across customers, licenses, and invoices will appear here.</p>
                }
                else
                {
                    <div class="dashboard-timeline">
                        @foreach (var (entry, index) in _recentAudit.Select((e, i) => (e, i)))
                        {
                            var faded = index >= 5;
                            <div class="timeline-event @(faded ? "timeline-event-faded" : "")">
                                <div class="timeline-dot @GetTimelineDotClass(entry, index)"></div>
                                <div class="timeline-event-body">
                                    <p class="timeline-event-title">
                                        @AuditDisplay.ActionLabel(entry.Action)
                                        @if (!string.IsNullOrEmpty(GetTargetLabel(entry)))
                                        {
                                            <text> — <span class="target">@GetTargetLabel(entry)</span></text>
                                        }
                                    </p>
                                    <p class="timeline-event-summary">@AuditDisplay.Summary(entry)</p>
                                    <p class="timeline-event-time">@FormatRelativeTime(entry.Timestamp)</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                <button type="button" class="view-audit-btn" @onclick="GoToAudit">View Full Audit Log</button>
            </section>

            <aside class="dashboard-sidebar">
                @if (_payments is { Enabled: true, CollectionCap: > 0 } payments)
                {
                    var used = Math.Min(100d, (double)(payments.CollectedTotal / payments.CollectionCap * 100m));
                    <div class="dashboard-sidebar-card">
                        <h2 class="sidebar-card-title">
                            Paystack collections
                            @if (payments.TestMode)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Test mode</MudChip>
                            }
                        </h2>
                        <p class="sidebar-card-copy">
                            <strong class="mono">GH₵@payments.CollectedTotal.ToString("N2")</strong>
                            of <span class="mono">GH₵@payments.CollectionCap.ToString("N2")</span> starter limit
                        </p>
                        <MudProgressLinear Value="used" Color="@(used >= 80 ? Color.Warning : Color.Primary)" Rounded="true" Size="Size.Medium"
                                           aria-label="@($"{used:0}% of the Paystack starter limit used")" />
                        @if (used >= 80)
                        {
                            <p class="sidebar-card-copy">Close to the limit — upgrade the Paystack account to a registered business to keep collecting.</p>
                        }
                    </div>
                }
                <div class="dashboard-sidebar-card dashboard-ops-note">
                    <h2 class="sidebar-card-title">Operational notes</h2>
                    <p class="sidebar-card-copy">
                        When auto-suspend on overdue invoices is enabled, licenses may remain active for up to
                        one overdue-check interval (<strong>60 minutes</strong> by default) after an invoice becomes overdue.
                        Lost license keys cannot be recovered — use <strong>Rotate key</strong> to issue a replacement.
                    </p>
                </div>
                <div class="dashboard-sidebar-card">
                    <h2 class="sidebar-card-title">Quick Actions</h2>
                    <div class="quick-actions-stack">
                        <button type="button" class="quick-action-primary" @onclick="GoToNewCustomer">
                            <span>+ New Customer</span>
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        </button>
                        <button type="button" class="quick-action-secondary" @onclick="GoToIssueLicense">
                            <span>Issue License</span>
                            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Small" />
                        </button>
                        <button type="button" class="quick-action-secondary" @onclick="GoToIntegrationKeys">
                            <span>Generate Integration Key</span>
                            <MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Small" />
                        </button>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private int _customerCount;
    private int _activeLicenses;
    private int _expiringSoon;
    private int _unpaidInvoices;
    private List<AuditLogDto> _recentAudit = [];
    private OnlinePaymentsStatusDto? _payments;

    private bool _statsFailed;
    private bool _auditFailed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task RetryAsync()
    {
        _loading = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var statsTask = LoadStatsSafeAsync();
        var auditTask = LoadAuditSafeAsync();

        var paymentsTask = LoadPaymentsSafeAsync();

        await Task.WhenAll(statsTask, auditTask, paymentsTask);

        var stats = await statsTask;
        _statsFailed = stats is null;
        if (stats is not null)
        {
            _customerCount = stats.CustomerCount;
            _activeLicenses = stats.ActiveLicenses;
            _expiringSoon = stats.ExpiringWithin30Days;
            _unpaidInvoices = stats.UnpaidInvoices;
        }

        _loading = false;
    }

    private async Task<Platform.Shared.Dtos.Dashboard.DashboardStatsDto?> LoadStatsSafeAsync()
    {
        try
        {
            return await Api.GetDashboardStatsAsync();
        }
        catch
        {
            return null;
        }
    }

    private async Task LoadPaymentsSafeAsync()
    {
        try
        {
            _payments = await Api.GetOnlinePaymentsStatusAsync();
        }
        catch
        {
            _payments = null; // optional card; never blocks the dashboard
        }
    }

    private async Task LoadAuditSafeAsync()
    {
        try
        {
            _recentAudit = await Api.GetAuditLogsAsync(limit: 10);
            _auditFailed = false;
        }
        catch
        {
            _recentAudit = [];
            _auditFailed = true;
        }
    }

    // Customer names arrive with each audit entry (no separate, size-capped customer lookup).
    private static string? GetTargetLabel(AuditLogDto entry) => entry.CustomerName;

    private static string GetTimelineDotClass(AuditLogDto entry, int index)
    {
        if (index == 0)
            return "timeline-dot-active";

        return entry.Action is AuditAction.LicenseRevoked
            or AuditAction.LicenseSuspended
            or AuditAction.CustomerSuspended
            or AuditAction.IntegrationKeyRevoked
            or AuditAction.InvoiceVoided
            or AuditAction.EmailDeliveryFailed
            ? "timeline-dot-attention"
            : "timeline-dot-neutral";
    }

    private static string FormatRelativeTime(DateTime timestamp)
    {
        var utc = timestamp.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(timestamp, DateTimeKind.Utc)
            : timestamp.ToUniversalTime();
        var delta = DateTime.UtcNow - utc;

        if (delta.TotalMinutes < 1)
            return "Just now";
        if (delta.TotalMinutes < 60)
            return $"{(int)delta.TotalMinutes} minute{((int)delta.TotalMinutes == 1 ? "" : "s")} ago";
        if (delta.TotalHours < 24)
            return $"{(int)delta.TotalHours} hour{((int)delta.TotalHours == 1 ? "" : "s")} ago";
        if (delta.TotalDays < 7)
            return $"{(int)delta.TotalDays} day{((int)delta.TotalDays == 1 ? "" : "s")} ago";

        return DateFormat.DateAndTime(utc);
    }


    private void GoToNewCustomer() => Navigation.NavigateTo("/customers?add=true");
    private void GoToIssueLicense() => Navigation.NavigateTo("/licenses?add=true");
    private void GoToIntegrationKeys() => Navigation.NavigateTo("/integration-keys");
    private void GoToAudit() => Navigation.NavigateTo("/audit");
}
