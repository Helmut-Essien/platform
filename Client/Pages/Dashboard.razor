@page "/"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject NavigationManager Navigation

<PageHeader Title="Dashboard" />

@if (_loading)
{
    <MudGrid>
        @for (var i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="88px" Class="rounded-lg" />
            </MudItem>
        }
    </MudGrid>
    <MudSkeleton Width="40%" Height="32px" Class="mt-8 mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4 dashboard-card" @onclick="GoToCustomers">
                <MudText Typo="Typo.subtitle2">Total Customers</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary">@_customerCount</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4 dashboard-card" @onclick="GoToLicenses">
                <MudText Typo="Typo.subtitle2">Active Licenses</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary">@_activeLicenses</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4 dashboard-card" @onclick="GoToLicenses">
                <MudText Typo="Typo.subtitle2">Expiring in 30 Days</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary">@_expiringSoon</MudText>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="pa-4 dashboard-card" @onclick="GoToInvoices">
                <MudText Typo="Typo.subtitle2">Unpaid Invoices</MudText>
                <MudText Typo="Typo.h4" Color="Color.Primary">@_unpaidInvoices</MudText>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5" Class="mt-8 mb-4">Quick Actions</MudText>
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="GoToNewCustomer">New Customer</MudButton>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.VpnKey" OnClick="GoToIssueLicense">Issue License</MudButton>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Key" OnClick="GoToIntegrationKeys">New Integration Key</MudButton>
        </MudItem>
    </MudGrid>

    @if (_recentAudit is { Count: > 0 })
    {
        <div class="d-flex align-center justify-space-between mt-8 mb-4">
            <MudText Typo="Typo.h5">Recent Activity</MudText>
            <MudButton Variant="Variant.Text" Href="/audit">View full audit log</MudButton>
        </div>
        <MudTimeline TimelinePosition="TimelinePosition.Start">
            @foreach (var entry in _recentAudit)
            {
                <MudTimelineItem Color="Color.Primary">
                    <ItemContent>
                        <MudText Typo="Typo.body2"><strong>@entry.Action</strong> — @entry.PerformedBy</MudText>
                        <MudText Typo="Typo.caption">@entry.Timestamp.ToString("g")</MudText>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
}

@code {
    private bool _loading = true;
    private int _customerCount;
    private int _activeLicenses;
    private int _expiringSoon;
    private int _unpaidInvoices;
    private List<AuditLogDto> _recentAudit = [];

    protected override async Task OnInitializedAsync()
    {
        var stats = await Api.GetDashboardStatsAsync();
        if (stats is not null)
        {
            _customerCount = stats.CustomerCount;
            _activeLicenses = stats.ActiveLicenses;
            _expiringSoon = stats.ExpiringWithin30Days;
            _unpaidInvoices = stats.UnpaidInvoices;
        }

        try { _recentAudit = await Api.GetAuditLogsAsync(limit: 10); } catch { /* optional */ }

        _loading = false;
    }

    private void GoToCustomers() => Navigation.NavigateTo("/customers");
    private void GoToNewCustomer() => Navigation.NavigateTo("/customers?add=true");
    private void GoToLicenses() => Navigation.NavigateTo("/licenses");
    private void GoToIssueLicense() => Navigation.NavigateTo("/licenses?add=true");
    private void GoToInvoices() => Navigation.NavigateTo("/invoices");
    private void GoToIntegrationKeys() => Navigation.NavigateTo("/integration-keys");
}
