@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject PlatformApiClient Api
@inject TokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudPaper Class="login-card pa-5 pa-sm-8" Elevation="0">
    <div class="login-brand">
        <img src="images/login-logo.png" alt="HelmutCode" class="login-logo" />
        <MudText Typo="Typo.body2" Class="login-subtitle">
            Sign in to manage licenses and customers
        </MudText>
    </div>

    <MudDivider Class="login-divider" />

    @if (_hasError)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="login-error"
                  CloseIconClicked="@(() => _hasError = false)">
            @_errorMessage
        </MudAlert>
    }

    <MudForm @ref="_form" Model="_login" @bind-IsValid="_formValid" Class="login-form">
        <MudTextField @bind-Value="_login.Email"
                      For="@(() => _login.Email)"
                      Label="Email"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      FullWidth="true"
                      Disabled="_busy"
                      autocomplete="email"
                      spellcheck="false"
                      OnKeyUp="OnKeyUp" />
        <MudTextField @bind-Value="_login.Password"
                      For="@(() => _login.Password)"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="@(_passwordVisible ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_passwordVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="TogglePasswordVisibility"
                      FullWidth="true"
                      Disabled="_busy"
                      autocomplete="current-password"
                      OnKeyUp="OnKeyUp" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="login-submit"
                   Disabled="@(_busy || !_formValid)"
                   OnClick="LoginAsync">
            @if (_busy)
            {
                <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign in</span>
            }
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    private MudForm? _form;
    private bool _formValid;
    private bool _busy;
    private bool _passwordVisible;
    private bool _hasError;
    private string _errorMessage = "";
    private LoginRequest _login = new() { Email = "", Password = "" };

    private void TogglePasswordVisibility() => _passwordVisible = !_passwordVisible;

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        _hasError = false;
        if (e.Key is "Enter" && !_busy)
            await LoginAsync();
    }

    private async Task LoginAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _busy = true;
        _hasError = false;
        try
        {
            var result = await Api.LoginAsync(_login);
            if (!result.IsSuccess)
            {
                _hasError = true;
                _errorMessage = result.ErrorMessage ?? "Invalid email or password.";
                return;
            }

            await TokenStorage.SetAsync(result.Data!.Token, result.Data.Email);
            AuthState.NotifyStateChanged();
            Navigation.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }
}
