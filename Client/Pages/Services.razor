@page "/services"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="services-page">
    @if (_showKeyPrompt)
    {
        <div class="services-success-banner">
            <div class="services-success-banner-content">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                <div>
                    <p class="services-success-banner-title">Service "@_createdServiceName" created successfully.</p>
                    <p class="services-success-banner-text">Ready for deployment. You need a secure key for API access.</p>
                </div>
            </div>
            <button type="button" class="btn-generate-key" @onclick="GenerateKeyForServiceAsync">
                <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" />
                Generate Integration Key
            </button>
        </div>
    }

    <header class="services-header">
        <div>
            <h1>Service Catalog</h1>
            <p>Manage microservices, API endpoints, and system-level integrations.</p>
        </div>
        <button type="button" class="btn-add-service" @onclick="OpenCreateDialogAsync">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Add Service
        </button>
    </header>

    @if (_loading)
    {
        <div class="services-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        @if (_products.Count > 0)
        {
            <section class="services-stats-grid" aria-label="Service statistics">
                <div class="services-stat-card">
                    <span class="services-stat-label">Active Services</span>
                    <span class="services-stat-value">@ActiveServiceCount</span>
                </div>
                <div class="services-stat-card">
                    <span class="services-stat-label">System Uptime</span>
                    <span class="services-stat-value services-stat-value-neutral">99.98%</span>
                </div>
                <div class="services-stat-card">
                    <span class="services-stat-label">Total Licenses</span>
                    <span class="services-stat-value services-stat-value-neutral">@TotalLicenseCount</span>
                </div>
                <div class="services-stat-card">
                    <span class="services-stat-label">Key Coverage</span>
                    <div class="services-stat-bar-wrap">
                        <span class="services-stat-value services-stat-value-neutral">@KeyCoveragePercent%</span>
                        <div class="services-stat-bar">
                            <div class="services-stat-bar-fill" style="width: @(KeyCoveragePercent)%"></div>
                        </div>
                    </div>
                </div>
            </section>
        }

        <div class="services-table-panel">
            @if (_products.Count == 0)
            {
                <div class="services-empty">
                    <h2>No services configured</h2>
                    <p>Add your first service product to issue licenses and integration keys.</p>
                    <button type="button" class="btn-add-service" @onclick="OpenCreateDialogAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        Add Service
                    </button>
                </div>
            }
            else
            {
                <MudTable Items="_products" Hover="false" Dense="false" Class="services-table">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Code</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Available</MudTh>
                        <MudTh Class="cell-center">Int. Key</MudTh>
                        <MudTh Class="cell-right">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var product = context;
                            var toggling = _togglingId == product.Id;
                        }
                        <MudTd>
                            <div class="service-name-cell">
                                <span class="service-status-dot @(product.IsAvailableForSale ? "active" : "inactive")"></span>
                                <span class="service-name-text">@product.Name</span>
                            </div>
                        </MudTd>
                        <MudTd>
                            <code class="service-code-badge">@product.Code</code>
                        </MudTd>
                        <MudTd>@(string.IsNullOrWhiteSpace(product.Description) ? "—" : product.Description)</MudTd>
                        <MudTd>
                            <MudSwitch Value="product.IsAvailableForSale"
                                       ValueChanged="@(async (bool v) => await ToggleAvailabilityAsync(product, v))"
                                       Color="Color.Primary"
                                       Disabled="toggling" />
                        </MudTd>
                        <MudTd Class="cell-center">
                            @if (product.HasActiveIntegrationKey)
                            {
                                <span class="key-chip key-chip-active" @onclick="() => ViewKeys(product.Id)" @onclick:stopPropagation="true">
                                    @GetKeyLabel(product)
                                </span>
                            }
                            else
                            {
                                <span class="key-chip key-chip-none">None</span>
                            }
                        </MudTd>
                        <MudTd Class="cell-right">
                            <div class="service-row-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               aria-label="Edit service"
                                               OnClick="@(() => EditAsync(product))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Key"
                                               Size="Size.Small"
                                               aria-label="View integration keys"
                                               OnClick="@(() => ViewKeys(product.Id))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <div class="services-table-footer">
                    <span>Showing 1–@_products.Count of @_products.Count results</span>
                </div>
            }
        </div>

        @if (_products.Count > 0)
        {
            <section class="services-insights">
                <div class="services-insight-card">
                    <h3>Service Performance Matrix</h3>
                    <div class="services-chart-placeholder" aria-hidden="true">
                        @foreach (var height in _chartHeights)
                        {
                            <div class="services-chart-bar" style="height: @(height)%"></div>
                        }
                    </div>
                    <p>License volume distribution across catalog services.</p>
                </div>
                <div class="services-insight-card services-glass-card">
                    <div class="services-glass-icon">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                    </div>
                    <h3>Automated Health Checks</h3>
                    <p>All active services are monitored. Integration keys and availability status reflect live catalog health.</p>
                </div>
            </section>
        }
    }
</div>

@code {
    private bool _loading = true;
    private bool _showKeyPrompt;
    private string? _createdServiceName;
    private string? _createdServiceId;
    private string? _togglingId;
    private List<ServiceProductDto> _products = [];
    private readonly int[] _chartHeights = [40, 65, 50, 85, 70, 90, 75];

    [SupplyParameterFromQuery] public string? Add { get; set; }

    private int ActiveServiceCount => _products.Count(p => p.IsAvailableForSale);
    private int TotalLicenseCount => _products.Sum(p => p.LicenseCount);
    private int KeyCoveragePercent => _products.Count == 0
        ? 0
        : (int)Math.Round(_products.Count(p => p.HasActiveIntegrationKey) * 100.0 / _products.Count);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Add))
            await OpenCreateDialogAsync();

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        StateHasChanged();
        _products = (await Api.GetServiceProductsAsync()).ToList();
        _loading = false;
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<ServiceProductCreateDialog>("Add Service");
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not CreateServiceProductRequest request)
            return;

        var result = await Api.CreateServiceProductAsync(request);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to create service.", Severity.Error);
            return;
        }

        Snackbar.Add("Service created.", Severity.Success);
        _createdServiceName = result.Data!.Name;
        _createdServiceId = result.Data.Id;
        _showKeyPrompt = true;
        await ReloadAsync();
    }

    private void GenerateKeyForServiceAsync()
    {
        _showKeyPrompt = false;
        if (!string.IsNullOrEmpty(_createdServiceId))
            Navigation.NavigateTo($"/integration-keys?productId={Uri.EscapeDataString(_createdServiceId)}");
    }

    private async Task ToggleAvailabilityAsync(ServiceProductDto product, bool available)
    {
        if (product.IsAvailableForSale == available)
            return;

        _togglingId = product.Id;
        try
        {
            var request = new UpdateServiceProductRequest
            {
                Name = product.Name,
                Description = product.Description,
                IsAvailableForSale = available
            };

            var result = await Api.UpdateServiceProductAsync(product.Id, request);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to update availability.", Severity.Error);
                return;
            }

            product.IsAvailableForSale = available;
        }
        finally
        {
            _togglingId = null;
        }
    }

    private async Task EditAsync(ServiceProductDto product)
    {
        var dialog = await DialogService.ShowAsync<ServiceProductEditDialog>("Edit Service", new DialogParameters
        {
            [nameof(ServiceProductEditDialog.Product)] = product
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not UpdateServiceProductRequest request)
            return;

        var result = await Api.UpdateServiceProductAsync(product.Id, request);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to update service.", Severity.Error);
            return;
        }

        Snackbar.Add("Service updated.", Severity.Success);
        await ReloadAsync();
    }

    private void ViewKeys(string productId) =>
        Navigation.NavigateTo($"/integration-keys?productId={Uri.EscapeDataString(productId)}");

    private static string GetKeyLabel(ServiceProductDto product) =>
        product.Code.Length <= 8 ? $"{product.Code}_KEY" : $"{product.Code[..8]}…";
}
