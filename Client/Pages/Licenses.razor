@page "/licenses"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageHeader Title="Licenses" />

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="Issue license" Expanded="_addPanelExpanded">
        <MudForm @ref="_form" Model="_issue" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_issue.CustomerId"
                       Label="Customer"
                       Variant="Variant.Outlined"
                       Required="true"
                       RequiredError="Customer is required"
                       Disabled="_busy"
                       Class="mb-2">
                @foreach (var c in _customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_issue.ServiceProductId"
                       Label="Service"
                       Variant="Variant.Outlined"
                       Required="true"
                       RequiredError="Service is required"
                       Disabled="_busy"
                       Class="mb-2">
                @foreach (var p in _products)
                {
                    <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_issue.PlanName"
                          For="@(() => _issue.PlanName)"
                          Label="Plan"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Plan is required"
                          Disabled="_busy"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_issue.ExpiresAt"
                           Label="Expires"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Expiry date is required"
                           Disabled="_busy"
                           Class="mb-2" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_busy"
                       OnClick="IssueAsync">
                @(_busy ? "Issuing..." : "Issue (Pending)")
            </MudButton>
        </MudForm>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string" @bind-Value="_filterCustomerId" Label="Customer" Variant="Variant.Outlined" Clearable="true">
            @foreach (var c in _customers)
            {
                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string" @bind-Value="_filterServiceId" Label="Service" Variant="Variant.Outlined" Clearable="true">
            @foreach (var p in _products)
            {
                <MudSelectItem Value="@p.Id">@p.Code</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="LicenseStatus?" @bind-Value="_filterStatus" Label="Status" Variant="Variant.Outlined" Clearable="true">
            @foreach (var status in Enum.GetValues<LicenseStatus>())
            {
                <MudSelectItem Value="@((LicenseStatus?)status)">@status</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudTextField @bind-Value="_search" Label="Search" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </MudItem>
    <MudItem xs="12" Class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Outlined" OnClick="ReloadGrid">Apply filters</MudButton>
        @if (_selected.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="BulkSuspendAsync">Suspend selected (@_selected.Count)</MudButton>
        }
    </MudItem>
</MudGrid>

<MudDataGrid @ref="_grid"
             T="LicenseDto"
             ServerData="LoadServerData"
             Hover="true"
             Dense="true"
             MultiSelection="true"
             @bind-SelectedItems="_selected"
             RowsPerPage="25">
    <Columns>
        <SelectColumn T="LicenseDto" />
        <PropertyColumn Property="x => x.CustomerName" Title="Customer" />
        <PropertyColumn Property="x => x.ServiceProductCode" Title="Service" />
        <PropertyColumn Property="x => x.PlanName" Title="Plan" />
        <TemplateColumn Title="Status">
            <CellTemplate>
                <LicenseStatusChip Status="context.Item.Status" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Expires">
            <CellTemplate>
                @(context.Item.ExpiresAt?.ToString("yyyy-MM-dd") ?? "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Key Sent">
            <CellTemplate>
                @(context.Item.LicenseKeySentAt?.ToString("yyyy-MM-dd") ?? "—")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <CellTemplate>
                @{
                    var license = context.Item;
                }
                @if (license.Status == LicenseStatus.Pending)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => ActivateAsync(license))">Activate</MudButton>
                }
                @if (license.Status == LicenseStatus.Active)
                {
                    <MudButton Size="Size.Small" OnClick="@(() => RenewAsync(license))">Renew</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(license))">Edit</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="@(() => SuspendAsync(license.Id))">Suspend</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => RevokeAsync(license.Id))">Revoke</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Typo="Typo.subtitle1" Class="pa-4">No licenses found.</MudText>
        <MudText Typo="Typo.body2" Class="px-4 pb-2">Issue a license for a customer and service product.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ma-4" OnClick="OpenAddPanel">Issue License</MudButton>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="LicenseDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private sealed class IssueLicenseModel
    {
        public string? CustomerId { get; set; }
        public string? ServiceProductId { get; set; }
        public string PlanName { get; set; } = "Pro";
        public DateTime? ExpiresAt { get; set; } = DateTime.UtcNow.AddYears(1);
    }

    private bool _busy;
    private bool _formValid;
    private bool _addPanelExpanded;
    private MudForm? _form;
    private MudDataGrid<LicenseDto>? _grid;
    private HashSet<LicenseDto> _selected = [];
    private List<CustomerDto> _customers = [];
    private List<ServiceProductDto> _products = [];
    private IssueLicenseModel _issue = new();
    private string? _filterCustomerId;
    private string? _filterServiceId;
    private LicenseStatus? _filterStatus;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("add=", StringComparison.OrdinalIgnoreCase))
            _addPanelExpanded = true;

        if (uri.Query.Contains("customerId=", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = part.Split('=', 2);
                if (kv.Length == 2 && kv[0].Equals("customerId", StringComparison.OrdinalIgnoreCase))
                    _filterCustomerId = Uri.UnescapeDataString(kv[1]);
            }
        }

        var customersTask = Api.GetCustomersPagedAsync(page: 1, pageSize: 200);
        var productsTask = Api.GetServiceProductsAsync();
        await Task.WhenAll(customersTask, productsTask);

        _customers = customersTask.Result.Items.ToList();
        _products = await productsTask;
        _issue.CustomerId ??= _customers.FirstOrDefault()?.Id;
        _issue.ServiceProductId ??= _products.FirstOrDefault()?.Id;
    }

    private async Task<GridData<LicenseDto>> LoadServerData(GridState<LicenseDto> state)
    {
        var result = await Api.GetLicensesPagedAsync(
            _filterCustomerId,
            page: state.Page + 1,
            pageSize: state.PageSize);

        var items = result.Items.AsEnumerable();

        if (!string.IsNullOrEmpty(_filterServiceId))
            items = items.Where(l => l.ServiceProductId == _filterServiceId);

        if (_filterStatus is not null)
            items = items.Where(l => l.Status == _filterStatus);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            items = items.Where(l =>
                (l.CustomerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.ServiceProductCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                l.PlanName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }

        return new GridData<LicenseDto>
        {
            Items = items.ToList(),
            TotalItems = _filterServiceId is null && _filterStatus is null && string.IsNullOrWhiteSpace(_search)
                ? result.TotalCount
                : items.Count()
        };
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private void OpenAddPanel() => _addPanelExpanded = true;

    private async Task IssueAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
        {
            Snackbar.Add("Please fix the errors in the form.", Severity.Warning);
            return;
        }

        if (string.IsNullOrEmpty(_issue.CustomerId) || string.IsNullOrEmpty(_issue.ServiceProductId))
        {
            Snackbar.Add("Please select a customer and service.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.CreateLicenseAsync(new CreateLicenseRequest
            {
                CustomerId = _issue.CustomerId,
                ServiceProductId = _issue.ServiceProductId,
                PlanName = _issue.PlanName,
                ExpiresAt = _issue.ExpiresAt ?? DateTime.UtcNow.AddYears(1)
            });

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to issue license.", Severity.Error);
                return;
            }

            Snackbar.Add("License issued (Pending).", Severity.Success);
            await ReloadGrid();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ActivateAsync(LicenseDto license)
    {
        var dialog = await DialogService.ShowAsync<ActivateLicenseDialog>("Activate License");
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not ActivateLicenseRequest request)
            return;

        var apiResult = await Api.ActivateLicenseAsync(license.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Activation failed.", Severity.Error);
            return;
        }

        await ShowResultDialog(apiResult.Data!, "License activated");
        await ReloadGrid();
    }

    private async Task RenewAsync(LicenseDto license)
    {
        var dialog = await DialogService.ShowAsync<RenewLicenseDialog>("Renew License", new DialogParameters
        {
            [nameof(RenewLicenseDialog.CurrentExpiresAt)] = license.ExpiresAt
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not RenewLicenseRequest request)
            return;

        var apiResult = await Api.RenewLicenseAsync(license.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Renewal failed.", Severity.Error);
            return;
        }

        await ShowResultDialog(apiResult.Data!, "License renewed");
        await ReloadGrid();
    }

    private async Task EditAsync(LicenseDto license)
    {
        var dialog = await DialogService.ShowAsync<LicenseEditDialog>("Edit License", new DialogParameters
        {
            [nameof(LicenseEditDialog.License)] = license
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not UpdateLicenseRequest request)
            return;

        var apiResult = await Api.UpdateLicenseAsync(license.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Update failed.", Severity.Error);
            return;
        }

        Snackbar.Add("License updated.", Severity.Success);
        await ReloadGrid();
    }

    private async Task ShowResultDialog(LicenseDto license, string title)
    {
        await DialogService.ShowAsync<LicenseActionResultDialog>(title, new DialogParameters
        {
            [nameof(LicenseActionResultDialog.License)] = license,
            [nameof(LicenseActionResultDialog.Title)] = title
        });
    }

    private async Task SuspendAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend License", new DialogParameters
        {
            ["Title"] = "Suspend License",
            ["Message"] = "This will temporarily disable this license. Continue?",
            ["ConfirmText"] = "Suspend"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var apiResult = await Api.SuspendLicenseAsync(id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Suspend failed.", Severity.Error);
            return;
        }

        Snackbar.Add("License suspended.", Severity.Warning);
        await ReloadGrid();
    }

    private async Task RevokeAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Revoke License", new DialogParameters
        {
            ["Title"] = "Revoke License",
            ["Message"] = "This will permanently revoke this license. This cannot be undone. Continue?",
            ["ConfirmText"] = "Revoke"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var apiResult = await Api.RevokeLicenseAsync(id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Revoke failed.", Severity.Error);
            return;
        }

        Snackbar.Add("License revoked.", Severity.Error);
        await ReloadGrid();
    }

    private async Task BulkSuspendAsync()
    {
        var active = _selected.Where(l => l.Status == LicenseStatus.Active).ToList();
        if (active.Count == 0)
        {
            Snackbar.Add("No active licenses selected.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend Licenses", new DialogParameters
        {
            ["Title"] = "Suspend Licenses",
            ["Message"] = $"Suspend {active.Count} active license(s)?",
            ["ConfirmText"] = "Suspend"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var success = 0;
        foreach (var license in active)
        {
            var apiResult = await Api.SuspendLicenseAsync(license.Id);
            if (apiResult.IsSuccess)
                success++;
        }

        Snackbar.Add($"Suspended {success} of {active.Count} license(s).", success == active.Count ? Severity.Success : Severity.Warning);
        _selected.Clear();
        await ReloadGrid();
    }
}
