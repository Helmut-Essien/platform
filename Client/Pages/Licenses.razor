@page "/licenses"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Licenses</MudText>

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="Issue license" Expanded="_addPanelExpanded">
        <MudForm @ref="_form" Model="_issue" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_issue.CustomerId"
                       Label="Customer"
                       Variant="Variant.Outlined"
                       Required="true"
                       RequiredError="Customer is required"
                       Disabled="_busy"
                       Class="mb-2">
                @foreach (var c in _customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_issue.ServiceProductId"
                       Label="Service"
                       Variant="Variant.Outlined"
                       Required="true"
                       RequiredError="Service is required"
                       Disabled="_busy"
                       Class="mb-2">
                @foreach (var p in _products)
                {
                    <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_issue.PlanName"
                          For="@(() => _issue.PlanName)"
                          Label="Plan"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Plan is required"
                          Disabled="_busy"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_issue.ExpiresAt"
                           Label="Expires"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Expiry date is required"
                           Disabled="_busy"
                           Class="mb-2" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_busy"
                       OnClick="IssueAsync">
                @(_busy ? "Issuing..." : "Issue (Pending)")
            </MudButton>
        </MudForm>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudTable @ref="_table" ServerData="LoadServerData" Hover="true" Dense="true" Loading="_loading" RowsPerPage="25">
    <HeaderContent>
        <MudTh>Customer</MudTh>
        <MudTh>Service</MudTh>
        <MudTh>Plan</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Expires</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.CustomerName</MudTd>
        <MudTd>@context.ServiceProductCode</MudTd>
        <MudTd>@context.PlanName</MudTd>
        <MudTd><LicenseStatusChip Status="context.Status" /></MudTd>
        <MudTd>@(context.ExpiresAt?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
        <MudTd>
            @if (context.Status == LicenseStatus.Pending)
            {
                <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => ActivateAsync(context.Id)">Activate</MudButton>
            }
            @if (context.Status == LicenseStatus.Active)
            {
                <MudButton Size="Size.Small" Color="Color.Warning" OnClick="() => SuspendAsync(context.Id)">Suspend</MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RevokeAsync(context.Id)">Revoke</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.subtitle1" Class="pa-4">No licenses found.</MudText>
        <MudText Typo="Typo.body2" Class="px-4 pb-2">Issue a license for a customer and service product.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ma-4" OnClick="OpenAddPanel">Issue License</MudButton>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private sealed class IssueLicenseModel
    {
        public string? CustomerId { get; set; }
        public string? ServiceProductId { get; set; }
        public string PlanName { get; set; } = "Pro";
        public DateTime? ExpiresAt { get; set; } = DateTime.UtcNow.AddYears(1);
    }

    private bool _loading;
    private bool _busy;
    private bool _formValid;
    private bool _addPanelExpanded;
    private MudForm? _form;
    private MudTable<LicenseDto>? _table;
    private List<CustomerDto> _customers = [];
    private List<ServiceProductDto> _products = [];
    private IssueLicenseModel _issue = new();

    protected override async Task OnInitializedAsync()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.Contains("add=", StringComparison.OrdinalIgnoreCase))
            _addPanelExpanded = true;

        var customersTask = Api.GetCustomersPagedAsync(page: 1, pageSize: 200);
        var productsTask = Api.GetServiceProductsAsync();
        await Task.WhenAll(customersTask, productsTask);

        _customers = customersTask.Result.Items.ToList();
        _products = await productsTask;
        _issue.CustomerId ??= _customers.FirstOrDefault()?.Id;
        _issue.ServiceProductId ??= _products.FirstOrDefault()?.Id;
    }

    private async Task<TableData<LicenseDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        _loading = true;
        var result = await Api.GetLicensesPagedAsync(page: state.Page + 1, pageSize: state.PageSize, ct: ct);
        _loading = false;
        return new TableData<LicenseDto> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private void OpenAddPanel() => _addPanelExpanded = true;

    private async Task IssueAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
        {
            Snackbar.Add("Please fix the errors in the form.", Severity.Warning);
            return;
        }

        if (string.IsNullOrEmpty(_issue.CustomerId) || string.IsNullOrEmpty(_issue.ServiceProductId))
        {
            Snackbar.Add("Please select a customer and service.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.CreateLicenseAsync(new CreateLicenseRequest
            {
                CustomerId = _issue.CustomerId,
                ServiceProductId = _issue.ServiceProductId,
                PlanName = _issue.PlanName,
                ExpiresAt = _issue.ExpiresAt ?? DateTime.UtcNow.AddYears(1)
            });

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to issue license.", Severity.Error);
                return;
            }

            Snackbar.Add("License issued (Pending).", Severity.Success);
            if (_table is not null)
                await _table.ReloadServerData();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ActivateAsync(string id)
    {
        var ok = await Api.ActivateLicenseAsync(id, new ActivateLicenseRequest
        {
            Subtotal = 99m,
            TaxAmount = 0m,
            Currency = "USD",
            DueDate = DateTime.UtcNow.AddDays(30),
            Description = "Activation"
        });
        Snackbar.Add(ok ? "License activated." : "Activation failed.",
            ok ? Severity.Success : Severity.Error);
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task SuspendAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend License", new DialogParameters
        {
            ["Title"] = "Suspend License",
            ["Message"] = "This will temporarily disable this license. Continue?",
            ["ConfirmText"] = "Suspend"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false) return;

        if (await Api.SuspendLicenseAsync(id))
        {
            Snackbar.Add("License suspended.", Severity.Warning);
            if (_table is not null)
                await _table.ReloadServerData();
        }
    }

    private async Task RevokeAsync(string id)
    {
        var dialog2 = await DialogService.ShowAsync<ConfirmDialog>("Revoke License", new DialogParameters
        {
            ["Title"] = "Revoke License",
            ["Message"] = "This will permanently revoke this license. This cannot be undone. Continue?",
            ["ConfirmText"] = "Revoke"
        });
        var dialogResult2 = await dialog2.Result;
        if (dialogResult2?.Canceled is not false) return;

        if (await Api.RevokeLicenseAsync(id))
        {
            Snackbar.Add("License revoked.", Severity.Error);
            if (_table is not null)
                await _table.ReloadServerData();
        }
    }
}
