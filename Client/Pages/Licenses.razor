@page "/licenses"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="licenses-page page-content">
    <header class="licenses-header">
        <div>
            <h1 class="page-title">Licenses</h1>
            <p class="page-subtitle">Manage software entitlements and API access keys.</p>
        </div>
        <button type="button" class="btn-issue-license" @onclick="OpenIssueDialogAsync">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Issue License
        </button>
    </header>

    <section class="licenses-filters-grid" aria-label="Filters">
        <div class="licenses-filter-field">
            <span class="licenses-filter-label">Customer</span>
            <MudSelect T="string" Value="_filterCustomerId" ValueChanged="OnCustomerFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@((string?)null)">All Customers</MudSelectItem>
                @foreach (var c in _customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="licenses-filter-field">
            <span class="licenses-filter-label">Service</span>
            <MudSelect T="string" Value="_filterServiceId" ValueChanged="OnServiceFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@((string?)null)">All Services</MudSelectItem>
                @foreach (var p in _products)
                {
                    <MudSelectItem Value="@p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="licenses-filter-field">
            <span class="licenses-filter-label">Status</span>
            <MudSelect T="LicenseStatus?" Value="_filterStatus" ValueChanged="OnStatusFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@((LicenseStatus?)null)">All Statuses</MudSelectItem>
                @foreach (var status in Enum.GetValues<LicenseStatus>())
                {
                    <MudSelectItem Value="@((LicenseStatus?)status)">@status</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="licenses-filter-actions">
            <button type="button" class="btn-more-filters" @onclick="ToggleMoreFilters">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                More Filters
            </button>
        </div>
    </section>

    @if (_showMoreFilters)
    {
        <section class="licenses-more-filters" aria-label="Additional filters">
            <MudTextField @bind-Value="_search"
                          Placeholder="Search customer, service, or plan..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1"
                          Immediate="true"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="ReloadGrid" />
            <MudButton Variant="Variant.Outlined" OnClick="ReloadGrid">Apply</MudButton>
        </section>
    }

    <div class="licenses-table-panel">
        <MudDataGrid @ref="_grid"
                     T="LicenseDto"
                     Class="licenses-grid"
                     ServerData="LoadServerData"
                     Hover="false"
                     Dense="false"
                     MultiSelection="true"
                     @bind-SelectedItems="_selected"
                     RowsPerPage="25">
            <Columns>
                <SelectColumn T="LicenseDto" />
                <TemplateColumn Title="Customer">
                    <CellTemplate>
                        @{
                            var license = context.Item;
                        }
                        <div class="license-customer-cell">
                            <span class="license-customer-name">@(license.CustomerName ?? "—")</span>
                            <span class="license-customer-id">@FormatCustomerRef(license)</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Service">
                    <CellTemplate>
                        @GetServiceLabel(context.Item)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.PlanName" Title="Plan" />
                <TemplateColumn Title="Status">
                    <CellTemplate>
                        <span class="license-status-badge @GetStatusClass(context.Item.Status)">
                            @context.Item.Status
                        </span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Expires">
                    <CellTemplate>
                        @{
                            var expires = context.Item.ExpiresAt;
                        }
                        @if (expires is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <span class="license-expires-mono @(context.Item.Status == LicenseStatus.Expired ? "license-expires-expired" : "")">
                                @expires.Value.ToString("yyyy-MM-dd")
                            </span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Key Sent">
                    <CellTemplate>
                        @if (KeyWasSent(context.Item))
                        {
                            <span class="key-sent-chip key-sent-yes">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                YES
                            </span>
                        }
                        else
                        {
                            <span class="key-sent-chip key-sent-no">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" />
                                NO
                            </span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <CellTemplate>
                        @{
                            var license = context.Item;
                        }
                        <div class="cell-right" @onclick:stopPropagation="true">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                @if (license.Status is LicenseStatus.Pending or LicenseStatus.Suspended or LicenseStatus.Expired)
                                {
                                    <MudMenuItem OnClick="@(() => ActivateAsync(license))">Activate</MudMenuItem>
                                }
                                @if (license.Status == LicenseStatus.Active)
                                {
                                    <MudMenuItem OnClick="@(() => RenewAsync(license))">Renew</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => EditAsync(license))">Edit</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => SuspendAsync(license.Id))">Suspend</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => RevokeAsync(license.Id))">Revoke</MudMenuItem>
                                }
                                @if (license.Status == LicenseStatus.Suspended)
                                {
                                    <MudMenuItem OnClick="@(() => RevokeAsync(license.Id))">Revoke</MudMenuItem>
                                }
                                @if (license.Status is LicenseStatus.Expired)
                                {
                                    <MudMenuItem OnClick="@(() => RenewAsync(license))">Renew</MudMenuItem>
                                }
                            </MudMenu>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="licenses-empty">
                    <h2>No licenses found</h2>
                    <p>Issue a license for a customer and service product.</p>
                    <button type="button" class="btn-issue-license" @onclick="OpenIssueDialogAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        Issue License
                    </button>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="LicenseDto" />
            </PagerContent>
        </MudDataGrid>
    </div>
</div>

<div class="licenses-bulk-bar @(_selected.Count > 0 ? "visible" : "")">
    <div class="licenses-bulk-count">
        <span class="licenses-bulk-count-badge">@_selected.Count</span>
        <span class="licenses-bulk-count-text">Items selected</span>
    </div>
    <div class="licenses-bulk-divider"></div>
    <div class="licenses-bulk-actions">
        <button type="button" class="licenses-bulk-btn" @onclick="BulkResendKeysAsync">
            <MudIcon Icon="@Icons.Material.Filled.Mail" Size="Size.Small" />
            Resend Keys
        </button>
        <button type="button" class="licenses-bulk-btn" @onclick="BulkRenewAsync">
            <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" />
            Renew
        </button>
        <button type="button" class="licenses-bulk-btn licenses-bulk-btn-danger" @onclick="BulkRevokeAsync">
            <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
            Revoke
        </button>
    </div>
    <button type="button" class="licenses-bulk-close" aria-label="Clear selection" @onclick="ClearSelection">
        <MudIcon Icon="@Icons.Material.Filled.Close" />
    </button>
</div>

@code {
    private bool _showMoreFilters;
    private MudDataGrid<LicenseDto>? _grid;
    private HashSet<LicenseDto> _selected = [];
    private List<CustomerDto> _customers = [];
    private List<ServiceProductDto> _products = [];
    private string? _filterCustomerId;
    private string? _filterServiceId;
    private LicenseStatus? _filterStatus;
    private string _search = "";

    [SupplyParameterFromQuery] public string? Add { get; set; }
    [SupplyParameterFromQuery] public string? CustomerId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var customersTask = Api.GetCustomersPagedAsync(page: 1, pageSize: 200);
        var productsTask = Api.GetServiceProductsAsync();
        await Task.WhenAll(customersTask, productsTask);

        _customers = customersTask.Result.Items.ToList();
        _products = (await productsTask).ToList();

        if (!string.IsNullOrEmpty(CustomerId))
            _filterCustomerId = CustomerId;

        if (!string.IsNullOrEmpty(Add))
            await OpenIssueDialogAsync();
    }

    private async Task<GridData<LicenseDto>> LoadServerData(GridState<LicenseDto> state)
    {
        var result = await Api.GetLicensesPagedAsync(
            _filterCustomerId,
            page: state.Page + 1,
            pageSize: state.PageSize);

        var items = result.Items.AsEnumerable();

        if (!string.IsNullOrEmpty(_filterServiceId))
            items = items.Where(l => l.ServiceProductId == _filterServiceId);

        if (_filterStatus is not null)
            items = items.Where(l => l.Status == _filterStatus);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            items = items.Where(l =>
                (l.CustomerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.ServiceProductCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                l.PlanName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }

        var unfiltered = _filterServiceId is null && _filterStatus is null && string.IsNullOrWhiteSpace(_search);

        return new GridData<LicenseDto>
        {
            Items = items.ToList(),
            TotalItems = unfiltered ? result.TotalCount : items.Count()
        };
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private void ToggleMoreFilters() => _showMoreFilters = !_showMoreFilters;

    private async Task OnCustomerFilterChanged(string? value)
    {
        _filterCustomerId = value;
        await ReloadGrid();
    }

    private async Task OnServiceFilterChanged(string? value)
    {
        _filterServiceId = value;
        await ReloadGrid();
    }

    private async Task OnStatusFilterChanged(LicenseStatus? value)
    {
        _filterStatus = value;
        await ReloadGrid();
    }

    private void ClearSelection() => _selected.Clear();

    private async Task OpenIssueDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<LicenseIssueDialog>("Issue License", new DialogParameters
        {
            [nameof(LicenseIssueDialog.Customers)] = _customers,
            [nameof(LicenseIssueDialog.Products)] = _products,
            [nameof(LicenseIssueDialog.DefaultCustomerId)] = _filterCustomerId ?? CustomerId
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not CreateLicenseRequest request)
            return;

        var result = await Api.CreateLicenseAsync(request);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to issue license.", Severity.Error);
            return;
        }

        Snackbar.Add("License issued (Pending).", Severity.Success);
        await ReloadGrid();
    }

    private async Task ActivateAsync(LicenseDto license)
    {
        var dialog = await DialogService.ShowAsync<ActivateLicenseDialog>("Activate License");
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not ActivateLicenseRequest request)
            return;

        var apiResult = await Api.ActivateLicenseAsync(license.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Activation failed.", Severity.Error);
            return;
        }

        await ShowResultDialog(apiResult.Data!, "License Activated");
        await ReloadGrid();
    }

    private async Task RenewAsync(LicenseDto license)
    {
        var dialog = await DialogService.ShowAsync<RenewLicenseDialog>("Renew License", new DialogParameters
        {
            [nameof(RenewLicenseDialog.CurrentExpiresAt)] = license.ExpiresAt
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not RenewLicenseRequest request)
            return;

        var apiResult = await Api.RenewLicenseAsync(license.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Renewal failed.", Severity.Error);
            return;
        }

        await ShowResultDialog(apiResult.Data!, "License Renewed");
        await ReloadGrid();
    }

    private async Task EditAsync(LicenseDto license)
    {
        var dialog = await DialogService.ShowAsync<LicenseEditDialog>("Edit License", new DialogParameters
        {
            [nameof(LicenseEditDialog.License)] = license
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not UpdateLicenseRequest request)
            return;

        var apiResult = await Api.UpdateLicenseAsync(license.Id, request);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Update failed.", Severity.Error);
            return;
        }

        Snackbar.Add("License updated.", Severity.Success);
        await ReloadGrid();
    }

    private async Task ShowResultDialog(LicenseDto license, string title)
    {
        await DialogService.ShowAsync<LicenseActionResultDialog>(title, new DialogParameters
        {
            [nameof(LicenseActionResultDialog.License)] = license,
            [nameof(LicenseActionResultDialog.Title)] = title
        });
    }

    private async Task SuspendAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend License", new DialogParameters
        {
            ["Title"] = "Suspend License",
            ["Message"] = "This license will be denied immediately. Continue?",
            ["ConfirmText"] = "Suspend"
        }, PlatformDialogOptions.Confirm);
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var apiResult = await Api.SuspendLicenseAsync(id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Suspend failed.", Severity.Error);
            return;
        }

        Snackbar.Add("License suspended.", Severity.Success);
        await ReloadGrid();
    }

    private async Task RevokeAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Revoke License", new DialogParameters
        {
            ["Title"] = "Revoke License",
            ["Message"] = "This will permanently revoke this license. This cannot be undone. Continue?",
            ["ConfirmText"] = "Revoke"
        }, PlatformDialogOptions.Confirm);
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var apiResult = await Api.RevokeLicenseAsync(id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Revoke failed.", Severity.Error);
            return;
        }

        Snackbar.Add("License revoked.", Severity.Success);
        await ReloadGrid();
    }

    private Task BulkResendKeysAsync()
    {
        Snackbar.Add("Resend keys is not available yet. Activate or renew licenses to email keys.", Severity.Info);
        return Task.CompletedTask;
    }

    private async Task BulkRenewAsync()
    {
        var renewable = _selected.Where(l => l.Status is LicenseStatus.Active or LicenseStatus.Expired).ToList();
        if (renewable.Count == 0)
        {
            Snackbar.Add("No renewable licenses selected.", Severity.Warning);
            return;
        }

        if (renewable.Count > 1)
        {
            Snackbar.Add("Select one license at a time to renew with billing details.", Severity.Info);
            return;
        }

        await RenewAsync(renewable[0]);
        _selected.Clear();
    }

    private async Task BulkRevokeAsync()
    {
        var revokable = _selected.Where(l => l.Status is LicenseStatus.Active or LicenseStatus.Suspended).ToList();
        if (revokable.Count == 0)
        {
            Snackbar.Add("No revokable licenses selected.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Revoke Licenses", new DialogParameters
        {
            ["Title"] = "Revoke Licenses",
            ["Message"] = $"Permanently revoke {revokable.Count} license(s)? This cannot be undone.",
            ["ConfirmText"] = "Revoke"
        }, PlatformDialogOptions.Confirm);
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var results = await Task.WhenAll(revokable.Select(l => Api.RevokeLicenseAsync(l.Id)));
        var success = results.Count(r => r.IsSuccess);

        Snackbar.Add($"Revoked {success} of {revokable.Count} license(s).", success == revokable.Count ? Severity.Success : Severity.Warning);
        _selected.Clear();
        await ReloadGrid();
    }

    private string GetServiceLabel(LicenseDto license)
    {
        var product = _products.FirstOrDefault(p => p.Id == license.ServiceProductId);
        return product?.Name ?? license.ServiceProductCode ?? "—";
    }

    private static bool KeyWasSent(LicenseDto license) => license.LicenseKeySentAt.HasValue;

    private static string GetStatusClass(LicenseStatus status) => status switch
    {
        LicenseStatus.Active => "license-status-active",
        LicenseStatus.Expired => "license-status-expired",
        LicenseStatus.Pending => "license-status-pending",
        LicenseStatus.Suspended => "license-status-suspended",
        LicenseStatus.Revoked => "license-status-revoked",
        _ => "license-status-revoked"
    };

    private static string FormatCustomerRef(LicenseDto license)
    {
        var idPart = FormatShortId(license.CustomerId);
        if (string.IsNullOrWhiteSpace(license.CustomerName))
            return $"ID: {idPart}";

        var nameToken = license.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
        if (nameToken.Length > 4)
            nameToken = nameToken[..4];

        return $"ID: {idPart}-{nameToken.ToUpperInvariant()}";
    }

    private static string FormatShortId(string id)
    {
        var compact = id.Replace("-", "", StringComparison.Ordinal);
        return compact[..Math.Min(8, compact.Length)].ToUpperInvariant();
    }
}
