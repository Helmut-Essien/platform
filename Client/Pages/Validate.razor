@page "/validate"
@page "/tools/validate"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar

<PageHeader Title="Validate License (dev tool)" />
<MudText Typo="Typo.body2" Class="mb-4">Tests the public validation API with an integration key header.</MudText>

<MudForm @ref="_form" Model="_request" @bind-IsValid="_formValid">
    <MudTextField @bind-Value="_integrationKey"
                  Label="X-Integration-Key"
                  Variant="Variant.Outlined"
                  Required="true"
                  RequiredError="Integration key is required"
                  Disabled="_busy"
                  Class="mb-2"
                  OnKeyUp="OnKeyUp" />
    <MudTextField @bind-Value="_request.LicenseKey"
                  For="@(() => _request.LicenseKey)"
                  Label="License key"
                  Variant="Variant.Outlined"
                  Required="true"
                  RequiredError="License key is required"
                  Disabled="_busy"
                  Class="mb-2"
                  OnKeyUp="OnKeyUp" />
    <MudTextField @bind-Value="_request.ServiceCode"
                  For="@(() => _request.ServiceCode)"
                  Label="Service code (optional)"
                  Variant="Variant.Outlined"
                  Disabled="_busy"
                  Class="mb-2"
                  OnKeyUp="OnKeyUp" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ValidateAsync" Disabled="_busy">
        @(_busy ? "Validating..." : "Validate")
    </MudButton>
    <MudButton Variant="Variant.Text" Color="Color.Default" Class="ml-2" Disabled="_busy" OnClick="Clear">Clear</MudButton>
</MudForm>

@if (_result is not null)
{
    <MudPaper Class="pa-4 mt-4" Style="@(_result.IsValid ? "border-left:4px solid #71e215" : "border-left:4px solid #ef4444")">
        <MudText Typo="Typo.subtitle1">Valid: <strong>@_result.IsValid</strong></MudText>
        @if (!string.IsNullOrEmpty(_result.Message))
        {
            <MudText>@_result.Message</MudText>
        }
        @if (_result.IsValid)
        {
            <MudText>Plan: @_result.PlanName</MudText>
            <MudText>Expires: @_result.ExpiresAt</MudText>
        }
    </MudPaper>
}

@code {
    private MudForm? _form;
    private bool _formValid;
    private string _integrationKey = "";
    private ValidateLicenseRequest _request = new() { LicenseKey = "" };
    private ValidateLicenseResponse? _result;
    private bool _busy;

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" && !_busy)
            await ValidateAsync();
    }

    private async Task ValidateAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _busy = true;
        try
        {
            var payload = new ValidateLicenseRequest
            {
                LicenseKey = _request.LicenseKey,
                ServiceCode = string.IsNullOrWhiteSpace(_request.ServiceCode) ? null : _request.ServiceCode.Trim()
            };

            var result = await Api.ValidateLicenseAsync(_integrationKey.Trim(), payload);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Validation request failed.", Severity.Error);
                _result = null;
                return;
            }

            _result = result.Data;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Clear()
    {
        _integrationKey = "";
        _request = new ValidateLicenseRequest { LicenseKey = "" };
        _result = null;
        _form?.ResetValidation();
    }
}
