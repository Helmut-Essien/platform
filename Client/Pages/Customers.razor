@page "/customers"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageHeader Title="Customers" />

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="Add customer" Expanded="_addPanelExpanded">
        <MudForm @ref="_form" Model="_newCustomer" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_newCustomer.Name"
                          For="@(() => _newCustomer.Name)"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Name is required"
                          MaxLength="200"
                          Counter="200"
                          Disabled="_busy"
                          Class="mb-2" />
            <MudTextField @bind-Value="_newCustomer.ContactEmail"
                          For="@(() => _newCustomer.ContactEmail)"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="Email is required"
                          Error="@(!string.IsNullOrEmpty(_emailFieldError))"
                          ErrorText="@_emailFieldError"
                          Disabled="_busy"
                          Class="mb-2" />
            <MudTextField @bind-Value="_newCustomer.ContactPhone"
                          For="@(() => _newCustomer.ContactPhone)"
                          Label="Phone (optional)"
                          Variant="Variant.Outlined"
                          MaxLength="50"
                          Counter="50"
                          Disabled="_busy"
                          Class="mb-2" />
            <MudTextField @bind-Value="_newCustomer.InternalNotes"
                          For="@(() => _newCustomer.InternalNotes)"
                          Label="Internal notes (optional)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLength="4000"
                          Counter="4000"
                          Disabled="_busy"
                          Class="mb-2" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_busy"
                       OnClick="CreateAsync">
                @(_busy ? "Creating..." : "Create")
            </MudButton>
        </MudForm>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField @bind-Value="_search" Label="Search name or email" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Clearable="true">
            <MudSelectItem Value="@("active")">Active</MudSelectItem>
            <MudSelectItem Value="@("suspended")">Suspended</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
        <MudButton Variant="Variant.Outlined" OnClick="ReloadGrid">Apply filters</MudButton>
    </MudItem>
</MudGrid>

<MudDataGrid @ref="_grid"
             T="CustomerDto"
             ServerData="LoadServerData"
             Hover="true"
             Dense="true"
             RowClick="OnRowClick"
             RowsPerPage="25">
    <Columns>
        <TemplateColumn Title="Name">
            <CellTemplate>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0" OnClick="@(() => ViewCustomer(context.Item))">@context.Item.Name</MudButton>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.ContactEmail" Title="Email" />
        <PropertyColumn Property="x => x.ContactPhone" Title="Phone" />
        <TemplateColumn Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Class="@(context.Item.IsSuspended ? "chip-suspended" : "")" Color="@(context.Item.IsSuspended ? Color.Default : Color.Success)">
                    @(context.Item.IsSuspended ? "Suspended" : "Active")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.LicenseCount" Title="Licenses" />
        <TemplateColumn Title="Created">
            <CellTemplate>
                @context.Item.CreatedAt.ToString("yyyy-MM-dd")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <CellTemplate>
                @{
                    var customer = context.Item;
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ViewCustomer(customer))">View</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditAsync(customer))">Edit</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/licenses?customerId={customer.Id}")">Licenses</MudButton>
                @if (customer.IsSuspended)
                {
                    <MudButton Size="Size.Small" OnClick="@(() => ReactivateAsync(customer.Id))">Reactivate</MudButton>
                }
                else
                {
                    <MudButton Size="Size.Small" Color="Color.Warning" OnClick="@(() => SuspendAsync(customer.Id))">Suspend</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Typo="Typo.subtitle1" Class="pa-4">No customers yet.</MudText>
        <MudText Typo="Typo.body2" Class="px-4 pb-2">Add your first customer to start issuing licenses.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ma-4" OnClick="OpenAddPanel">Add Customer</MudButton>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="CustomerDto" />
    </PagerContent>
</MudDataGrid>

<CustomerDetailDrawer @bind-Open="_drawerOpen"
                      Customer="_selectedCustomer"
                      OnCustomerUpdated="OnCustomerUpdated" />

@code {
    private bool _busy;
    private bool _formValid;
    private bool _addPanelExpanded;
    private bool _drawerOpen;
    private string? _emailFieldError;
    private string _search = "";
    private string? _statusFilter;
    private MudForm? _form;
    private MudDataGrid<CustomerDto>? _grid;
    private CustomerDto? _selectedCustomer;
    private CreateCustomerRequest _newCustomer = new() { Name = "", ContactEmail = "" };

    protected override void OnInitialized()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.Contains("add=", StringComparison.OrdinalIgnoreCase))
            _addPanelExpanded = true;
    }

    private async Task<GridData<CustomerDto>> LoadServerData(GridState<CustomerDto> state)
    {
        var result = await Api.GetCustomersPagedAsync(state.Page + 1, state.PageSize);
        var items = result.Items.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            items = items.Where(c =>
                c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                c.ContactEmail.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }

        if (_statusFilter == "active")
            items = items.Where(c => !c.IsSuspended);
        else if (_statusFilter == "suspended")
            items = items.Where(c => c.IsSuspended);

        return new GridData<CustomerDto>
        {
            Items = items.ToList(),
            TotalItems = string.IsNullOrWhiteSpace(_search) && string.IsNullOrEmpty(_statusFilter)
                ? result.TotalCount
                : items.Count()
        };
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private void OnRowClick(DataGridRowClickEventArgs<CustomerDto> args) => ViewCustomer(args.Item);

    private void ViewCustomer(CustomerDto customer)
    {
        _selectedCustomer = customer;
        _drawerOpen = true;
    }

    private async Task OnCustomerUpdated()
    {
        await ReloadGrid();
        if (_selectedCustomer is not null)
            _selectedCustomer = await Api.GetCustomerAsync(_selectedCustomer.Id);
    }

    private async Task CreateAsync()
    {
        _emailFieldError = null;

        if (_form is null)
            return;

        await _form.Validate();

        if (!_formValid)
        {
            Snackbar.Add("Please fix the errors in the form.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.CreateCustomerAsync(_newCustomer);

            if (!result.IsSuccess)
            {
                var message = result.ErrorMessage ?? "Failed to create customer.";
                Snackbar.Add(message, Severity.Error);

                _emailFieldError = FieldErrorHelper.GetFieldError(result.FieldErrors, "ContactEmail", "request.ContactEmail")
                    ?? FieldErrorHelper.GetFieldError(result.FieldErrors, "Name", "request.Name")
                    ?? (message.Contains("email", StringComparison.OrdinalIgnoreCase) ? message : null);

                return;
            }

            Snackbar.Add("Customer created.", Severity.Success);
            _newCustomer = new CreateCustomerRequest { Name = "", ContactEmail = "" };
            _form.ResetValidation();
            await ReloadGrid();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenAddPanel() => _addPanelExpanded = true;

    private async Task EditAsync(CustomerDto customer)
    {
        var dialog = await DialogService.ShowAsync<CustomerEditDialog>("Edit Customer", new DialogParameters
        {
            [nameof(CustomerEditDialog.Customer)] = customer
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not UpdateCustomerRequest request)
            return;

        var result = await Api.UpdateCustomerAsync(customer.Id, request);
        if (!result.IsSuccess)
        {
            var fieldMessage = FieldErrorHelper.GetFieldError(result.FieldErrors, "ContactEmail", "Name")
                ?? result.ErrorMessage;
            Snackbar.Add(fieldMessage ?? "Failed to update customer.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer updated.", Severity.Success);
        await ReloadGrid();
    }

    private async Task SuspendAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend Customer", new DialogParameters
        {
            ["Title"] = "Suspend Customer",
            ["Message"] = "This will block all licenses for this customer. Continue?",
            ["ConfirmText"] = "Suspend"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var result = await Api.SuspendCustomerAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Suspend failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer suspended.", Severity.Success);
        await ReloadGrid();
    }

    private async Task ReactivateAsync(string id)
    {
        var result = await Api.ReactivateCustomerAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Reactivate failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer reactivated.", Severity.Success);
        await ReloadGrid();
    }
}
