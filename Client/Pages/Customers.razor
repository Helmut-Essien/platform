@page "/customers"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="customers-page page-content">
    <header class="customers-header">
        <div>
            <h1 class="page-title">Customers</h1>
            <p class="page-subtitle">Manage platform accounts, licensing, and billing entities.</p>
        </div>
        <button type="button" class="btn-primary-cta" @onclick="OpenCreateDialogAsync">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            New Customer
        </button>
    </header>

    <section class="customers-filters" aria-label="Filters">
        <MudTextField @bind-Value="_search"
                      Placeholder="Search by name, email or ID..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="flex-grow-1"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="ReloadGrid" />
        <div class="customers-filters-actions">
            <MudSelect T="string" Value="_statusFilter" ValueChanged="OnStatusFilterChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 10rem;">
                <MudSelectItem Value="@("all")">All Statuses</MudSelectItem>
                <MudSelectItem Value="@("active")">Active</MudSelectItem>
                <MudSelectItem Value="@("suspended")">Suspended</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Value="_dateFilter" ValueChanged="OnDateFilterChanged" Label="Created" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 10rem;">
                <MudSelectItem Value="@("all")">All Time</MudSelectItem>
                <MudSelectItem Value="@("30d")">Last 30 Days</MudSelectItem>
            </MudSelect>
        </div>
    </section>

    <div class="customers-table-panel">
        <MudDataGrid @ref="_grid"
                     T="CustomerDto"
                     Class="customers-grid"
                     ServerData="LoadServerData"
                     Hover="true"
                     Dense="false"
                     RowClick="OnRowClick"
                     RowsPerPage="25">
                <Columns>
                    <TemplateColumn Title="Name">
                        <CellTemplate>
                            @{
                                var c = context.Item;
                            }
                            <div class="customer-name-cell">
                                <div class="customer-avatar @(c.IsSuspended ? "suspended" : "")">@GetInitials(c.Name)</div>
                                <div>
                                    <div class="customer-name-text">@c.Name</div>
                                    <div class="customer-id-text">ID: @FormatShortId(c.Id)</div>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.ContactEmail" Title="Contact Email" />
                    <TemplateColumn Title="Contact Phone">
                        <CellTemplate>
                            @(string.IsNullOrWhiteSpace(context.Item.ContactPhone) ? "—" : context.Item.ContactPhone)
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <CellTemplate>
                            <div class="cell-center">
                                <StatusBadge CustomerSuspended="context.Item.IsSuspended" />
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Licenses">
                        <CellTemplate>
                            <div class="cell-center cell-mono">@context.Item.LicenseCount</div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Created At">
                        <CellTemplate>
                            @context.Item.CreatedAt.ToString("MMM dd, yyyy")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="" Sortable="false">
                        <CellTemplate>
                            @{
                                var customer = context.Item;
                            }
                            <div class="d-flex justify-end" @onclick:stopPropagation="true">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                    <MudMenuItem OnClick="@(() => ViewCustomer(customer))">View profile</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => EditAsync(customer))">Edit</MudMenuItem>
                                    <MudMenuItem Href="@($"/licenses?customerId={customer.Id}")">View licenses</MudMenuItem>
                                    @if (customer.IsSuspended)
                                    {
                                        <MudMenuItem OnClick="@(() => ReactivateAsync(customer))">Reactivate</MudMenuItem>
                                    }
                                    else
                                    {
                                        <MudMenuItem OnClick="@(() => SuspendAsync(customer.Id))">Suspend</MudMenuItem>
                                    }
                                </MudMenu>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <div class="customers-empty">
                        <h2>No customers yet</h2>
                        <p>Add your first customer to start issuing licenses.</p>
                        <button type="button" class="btn-primary-cta" @onclick="OpenCreateDialogAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                            New Customer
                        </button>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudDataGridPager T="CustomerDto" />
                </PagerContent>
            </MudDataGrid>
    </div>
</div>

<CustomerDetailDrawer @bind-Open="_drawerOpen"
                      Customer="_selectedCustomer"
                      OnCustomerUpdated="OnCustomerUpdated" />

@code {
    private bool _drawerOpen;
    private string _search = "";
    private string _statusFilter = "all";
    private string _dateFilter = "all";
    private MudDataGrid<CustomerDto>? _grid;
    private CustomerDto? _selectedCustomer;

    [SupplyParameterFromQuery] public string? Add { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Add))
            await OpenCreateDialogAsync();
    }

    private async Task<GridData<CustomerDto>> LoadServerData(GridState<CustomerDto> state)
    {
        var result = await Api.GetCustomersPagedAsync(
            state.Page + 1,
            state.PageSize,
            search: _search,
            status: _statusFilter,
            created: _dateFilter);

        return new GridData<CustomerDto>
        {
            Items = result.Items,
            TotalItems = result.TotalCount
        };
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = string.IsNullOrEmpty(value) ? "all" : value;
        await ReloadGrid();
    }

    private async Task OnDateFilterChanged(string? value)
    {
        _dateFilter = value ?? "all";
        await ReloadGrid();
    }

    private void OnRowClick(DataGridRowClickEventArgs<CustomerDto> args) => ViewCustomer(args.Item);

    private void ViewCustomer(CustomerDto customer)
    {
        _selectedCustomer = customer;
        _drawerOpen = true;
    }

    private async Task OnCustomerUpdated()
    {
        await ReloadGrid();
        if (_selectedCustomer is not null)
            _selectedCustomer = await Api.GetCustomerAsync(_selectedCustomer.Id);
    }

    private async Task OpenCreateDialogAsync()
    {
        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("New Customer");
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not CreateCustomerRequest request)
            return;

        var result = await Api.CreateCustomerAsync(request);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to create customer.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer created.", Severity.Success);
        await ReloadGrid();
    }

    private async Task EditAsync(CustomerDto customer)
    {
        var dialog = await DialogService.ShowAsync<CustomerEditDialog>("Edit Customer", new DialogParameters
        {
            [nameof(CustomerEditDialog.Customer)] = customer
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not UpdateCustomerRequest request)
            return;

        var result = await Api.UpdateCustomerAsync(customer.Id, request);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to update customer.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer updated.", Severity.Success);
        await ReloadGrid();
        if (_selectedCustomer?.Id == customer.Id)
            _selectedCustomer = await Api.GetCustomerAsync(customer.Id);
    }

    private async Task SuspendAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend Customer", new DialogParameters
        {
            ["Title"] = "Suspend Customer",
            ["Message"] = "All licenses for this customer will be denied immediately. Continue?",
            ["ConfirmText"] = "Suspend",
            ["IsDestructive"] = true
        }, PlatformDialogOptions.Confirm);
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var result = await Api.SuspendCustomerAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Suspend failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer suspended.", Severity.Success);
        await OnCustomerUpdated();
    }

    private async Task ReactivateAsync(CustomerDto customer)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Reactivate Customer", new DialogParameters
        {
            ["Title"] = "Reactivate Customer",
            ["Message"] = $"Reactivate {customer.Name}? Deny-lists will be cleared.",
            ["ConfirmText"] = "Reactivate"
        }, PlatformDialogOptions.Confirm);
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var result = await Api.ReactivateCustomerAsync(customer.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Reactivate failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer reactivated.", Severity.Success);
        await OnCustomerUpdated();
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "?";
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private static string FormatShortId(string id)
    {
        var compact = id.Replace("-", "", StringComparison.Ordinal);
        return compact[..Math.Min(8, compact.Length)].ToUpperInvariant();
    }
}
