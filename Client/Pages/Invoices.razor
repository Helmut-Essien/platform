@page "/invoices"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
<PageTitle>Invoices · HelmutCode Admin</PageTitle>

<div class="invoices-page page-content">
    <header class="invoices-header">
        <div>
            <h1 class="page-title">Invoices</h1>
            <p class="page-subtitle">Manage billing, customer accounts, and transaction history.</p>
        </div>
        <div class="invoices-header-actions">
            <button type="button" class="btn-create-invoice" @onclick="CreateInvoiceAsync">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                CREATE INVOICE
            </button>
            <button type="button" class="btn-export-csv" @onclick="ExportCsvAsync">
                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                EXPORT CSV
            </button>
        </div>
    </header>

    @if (_stats is not null && _stats.Currencies.Count > 0)
    {
        <section class="invoices-stats-grid" aria-label="Invoice statistics">
            <div class="invoices-stat-card">
                <span class="invoices-stat-label">TOTAL REVENUE</span>
                <span class="invoices-stat-value">@FormatMoney(PrimaryStats?.TotalRevenue ?? 0, PrimaryCurrency)</span>
                @if (OtherCurrencyNote(s => s.TotalRevenue) is { } revenueNote)
                {
                    <div class="invoices-stat-footnote"><span>@revenueNote</span></div>
                }
            </div>
            <div class="invoices-stat-card">
                <span class="invoices-stat-label">OUTSTANDING</span>
                <span class="invoices-stat-value">@FormatMoney(PrimaryStats?.Outstanding ?? 0, PrimaryCurrency)</span>
                <div class="invoices-stat-footnote warning">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                    <span>@_stats.OverdueCount Overdue Invoices</span>
                </div>
                @if (OtherCurrencyNote(s => s.Outstanding) is { } outstandingNote)
                {
                    <div class="invoices-stat-footnote"><span>@outstandingNote</span></div>
                }
            </div>
            <div class="invoices-stat-card">
                <span class="invoices-stat-label">PAID THIS MONTH</span>
                <span class="invoices-stat-value">@FormatMoney(PrimaryStats?.PaidThisMonth ?? 0, PrimaryCurrency)</span>
                <div class="invoices-stat-footnote">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    <span>@(PrimaryStats?.PaidThisMonthCount ?? 0) Transactions</span>
                </div>
                @if (OtherCurrencyNote(s => s.PaidThisMonth) is { } monthNote)
                {
                    <div class="invoices-stat-footnote"><span>@monthNote</span></div>
                }
            </div>
            <div class="invoices-stat-card">
                <span class="invoices-stat-label">QUICK FILTER</span>
                <div class="invoices-quick-filters">
                    <button type="button" class="invoices-quick-chip @(_quickFilter == "all" ? "active" : "")" @onclick='() => SetQuickFilter("all")'>ALL</button>
                    <button type="button" class="invoices-quick-chip @(_quickFilter == "unpaid" ? "active" : "")" @onclick='() => SetQuickFilter("unpaid")'>UNPAID</button>
                    <button type="button" class="invoices-quick-chip @(_quickFilter == "sent" ? "active" : "")" @onclick='() => SetQuickFilter("sent")'>SENT</button>
                </div>
            </div>
        </section>
    }

    <section class="invoices-filters-panel" aria-label="Filters">
        <div class="invoices-filters-grid">
            <div class="invoices-filter-field">
                <span class="invoices-filter-label">CUSTOMER</span>
                <MudTextField @bind-Value="_customerSearch"
                              Placeholder="Search customer..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </div>
            <div class="invoices-filter-field">
                <span class="invoices-filter-label">STATUS</span>
                <MudSelect T="InvoiceStatus?" Value="_statusFilter" ValueChanged="OnStatusFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem Value="@((InvoiceStatus?)null)">All Statuses</MudSelectItem>
                    @foreach (var status in Enum.GetValues<InvoiceStatus>())
                    {
                        <MudSelectItem Value="@((InvoiceStatus?)status)">@status</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="invoices-filter-field">
                <span class="invoices-filter-label">DATE RANGE</span>
                <MudDateRangePicker @bind-DateRange="_dateRange"
                                    Variant="Variant.Outlined"
                                    Margin="Margin.Dense"
                                    Placeholder="Start — End" />
            </div>
            <div class="invoices-filter-actions">
                <button type="button" class="btn-filter-reset" @onclick="ResetFiltersAsync">RESET</button>
                <button type="button" class="btn-filter-apply" @onclick="ReloadGrid">FILTER</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_customerFilter))
        {
            <div class="invoices-active-filters" aria-label="Active filters">
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                         OnClose="@(_ => ClearCustomerFilterAsync())" CloseIcon="@Icons.Material.Filled.Close">
                    Customer: @CustomerFilterLabel
                </MudChip>
            </div>
        }
    </section>

    <div class="invoices-table-panel">
        <MudDataGrid @ref="_grid"
                     T="InvoiceDto"
                     SortMode="SortMode.Single"
                     Class="invoices-grid"
                     ServerData="LoadServerData"
                     Hover="true"
                     Dense="false"
                     RowClick="OnRowClick"
                     RowClassFunc="GetRowClass"
                     RowsPerPage="25">
            <Columns>
                <TemplateColumn Title="Invoice #" Sortable="true">
                    <CellTemplate>
                        <span class="invoice-number-link">@context.Item.InvoiceNumber</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Customer" Sortable="true">
                    <CellTemplate>
                        @{
                            var invoice = context.Item;
                        }
                        <div class="invoice-customer-cell">
                            <div class="invoice-customer-avatar">@GetInitials(invoice.CustomerName)</div>
                            <span class="invoice-customer-name">@(invoice.CustomerName ?? "—")</span>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Total" Sortable="true">
                    <CellTemplate>
                        <div class="cell-right amount-mono">@FormatMoney(context.Item.TotalAmount, context.Item.Currency)</div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Paid" Sortable="false">
                    <CellTemplate>
                        @{
                            var paidClass = context.Item.AmountPaid > 0 ? "amount-mono" : "amount-mono amount-mono-muted";
                        }
                        <div class="cell-right @paidClass">@FormatMoney(context.Item.AmountPaid, context.Item.Currency)</div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Due" Sortable="false">
                    <CellTemplate>
                        @{
                            var dueClass = context.Item.Status == InvoiceStatus.Overdue
                                ? "amount-mono amount-mono-overdue"
                                : context.Item.AmountDue > 0 ? "amount-mono" : "amount-mono amount-mono-muted";
                        }
                        <div class="cell-right @dueClass">@FormatMoney(context.Item.AmountDue, context.Item.Currency)</div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="true">
                    <CellTemplate>
                        <StatusBadge InvoiceStatus="context.Item.Status" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Issue Date" Sortable="true">
                    <CellTemplate>
                        @context.Item.IssueDate.ToString("MMM dd, yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" Sortable="false">
                    <CellTemplate>
                        @{
                            var invoice = context.Item;
                        }
                        <div class="cell-right" @onclick:stopPropagation="true">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="More actions" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                <MudMenuItem OnClick="@(() => ViewInvoice(invoice))">View invoice</MudMenuItem>
                                @if (invoice.Status is not InvoiceStatus.Void and not InvoiceStatus.Paid)
                                {
                                    <MudMenuItem OnClick="@(() => ViewInvoice(invoice))">Record payment</MudMenuItem>
                                }
                                @if (invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Sent or InvoiceStatus.Overdue && invoice.AmountPaid == 0)
                                {
                                    <MudMenuItem OnClick="@(() => VoidAsync(invoice))">Void invoice</MudMenuItem>
                                }
                            </MudMenu>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="invoices-empty">
                    <h2>No invoices found</h2>
                    <p>Create an invoice or activate a license to generate billing.</p>
                    <button type="button" class="btn-create-invoice" @onclick="CreateInvoiceAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        CREATE INVOICE
                    </button>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="InvoiceDto" />
            </PagerContent>
            </MudDataGrid>
    </div>
</div>

@code {
    private MudDataGrid<InvoiceDto>? _grid;
    private List<CustomerDto> _customers = [];
    private List<InvoiceDto> _statsInvoices = [];
    private InvoiceStatus? _statusFilter;
    private string? _customerFilter;
    private string _customerSearch = "";
    private string _quickFilter = "all";
    private DateRange? _dateRange;

    [SupplyParameterFromQuery] public string? Filter { get; set; }
    [SupplyParameterFromQuery] public string? CustomerId { get; set; }

    // Aggregates come from the server (B1): they cover every invoice, not the first page.
    // Amounts in different currencies are never summed (E7); the primary currency is USD when present,
    // otherwise the currency with the most outstanding value, and the others are listed in a footnote.
    private InvoiceStatsDto? _stats;

    private InvoiceCurrencyStatsDto? PrimaryStats =>
        _stats?.Currencies.FirstOrDefault(c => c.Currency.Equals("USD", StringComparison.OrdinalIgnoreCase))
        ?? _stats?.Currencies.OrderByDescending(c => c.Outstanding + c.TotalRevenue).FirstOrDefault();

    private string PrimaryCurrency => PrimaryStats?.Currency ?? "USD";

    private string? OtherCurrencyNote(Func<InvoiceCurrencyStatsDto, decimal> selector)
    {
        var others = _stats?.Currencies
            .Where(c => PrimaryStats is not null && c != PrimaryStats && selector(c) != 0)
            .Select(c => FormatMoney(selector(c), c.Currency))
            .ToList();
        return others is { Count: > 0 } ? "Also: " + string.Join(", ", others) : null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.Equals(Filter, "unpaid", StringComparison.OrdinalIgnoreCase))
            _quickFilter = "unpaid";
        if (!string.IsNullOrWhiteSpace(CustomerId))
            _customerFilter = CustomerId.Trim();

        var customersTask = Api.GetAllCustomersAsync();
        var statsTask = Api.GetInvoiceStatsAsync();
        await Task.WhenAll(customersTask, statsTask);

        _customers = customersTask.Result;
        _stats = statsTask.Result;
    }

    // Grid column title/property → whitelisted API sort key (unlisted columns are not sortable).
    private static readonly IReadOnlyDictionary<string, string> SortColumns =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Invoice #"] = "number",
            ["Customer"] = "customer",
            ["Total"] = "total",
            ["Status"] = "status",
            ["Issue Date"] = "issueDate"
        };

    private async Task<GridData<InvoiceDto>> LoadServerData(GridState<InvoiceDto> state)
    {
        var (sortBy, sortDesc) = GridSort.From(state, SortColumns, _grid?.RenderedColumns);
        var result = await Api.GetInvoicesPagedAsync(
            _customerFilter,
            page: state.Page + 1,
            pageSize: state.PageSize,
            unpaidOnly: _statusFilter is null && _quickFilter == "unpaid",
            status: _statusFilter ?? (_quickFilter == "sent" ? InvoiceStatus.Sent : null),
            search: _customerSearch,
            issuedFrom: _dateRange?.Start,
            issuedTo: _dateRange?.End,
            sortBy: sortBy,
            sortDesc: sortDesc);

        return new GridData<InvoiceDto>
        {
            Items = result.Items,
            TotalItems = result.TotalCount
        };
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task OnStatusFilterChanged(InvoiceStatus? value)
    {
        _statusFilter = value;
        await ReloadGrid();
    }

    private async Task SetQuickFilter(string filter)
    {
        _quickFilter = filter;
        await ReloadGrid();
    }

    private string CustomerFilterLabel =>
        _customers.FirstOrDefault(c => c.Id == _customerFilter)?.Name ?? "Selected customer";

    private async Task ClearCustomerFilterAsync()
    {
        _customerFilter = null;
        DropCustomerIdFromUrl();
        await ReloadGrid();
    }

    // Keep the URL in sync (replace: no extra history entry) so refresh doesn't bring the filter back.
    private void DropCustomerIdFromUrl()
    {
        if (!string.IsNullOrEmpty(CustomerId))
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("customerId", (string?)null), replace: true);
    }

    private async Task ResetFiltersAsync()
    {
        _statusFilter = null;
        _customerFilter = null;
        DropCustomerIdFromUrl();
        _customerSearch = "";
        _quickFilter = "all";
        _dateRange = null;
        await ReloadGrid();
    }

    private void OnRowClick(DataGridRowClickEventArgs<InvoiceDto> args) =>
        Navigation.NavigateTo($"/invoices/{args.Item.Id}");

    private void ViewInvoice(InvoiceDto invoice) =>
        Navigation.NavigateTo($"/invoices/{invoice.Id}");

    private string? GetRowClass(InvoiceDto invoice, int _) =>
        invoice.Status == InvoiceStatus.Overdue ? "invoice-row-overdue" : null;

    private async Task CreateInvoiceAsync()
    {
        // Saved inside the dialog (busy state, closes only on success); result captured here for feedback.
        ApiResult<InvoiceDto>? apiResult = null;
        Task<ApiResult<InvoiceDto>>? pending = null;
        Func<CreateInvoiceRequest, Task<string?>> submit = async request =>
        {
            pending = Api.CreateInvoiceAsync(request);
            apiResult = await pending;
            return apiResult.IsSuccess ? null : apiResult.ErrorMessage ?? "Failed to create invoice.";
        };
        var dialog = await DialogService.ShowAsync<CreateInvoiceDialog>("New Invoice", new DialogParameters
        {
            [nameof(CreateInvoiceDialog.Customers)] = _customers,
            [nameof(CreateInvoiceDialog.Submit)] = submit
        });
        await dialog.Result;
        if (pending is not null && apiResult is null)
        {
            // Dialog dismissed (Esc/backdrop) while saving: still report the outcome.
            try { apiResult = await pending; } catch { return; }
            if (!apiResult.IsSuccess)
                Snackbar.Add(apiResult.ErrorMessage ?? "Failed to create invoice.", Severity.Error);
        }
        if (apiResult is not { IsSuccess: true })
            return;

        Snackbar.Add("Invoice created.", Severity.Success);
        await RefreshStatsAsync();
        Navigation.NavigateTo($"/invoices/{apiResult.Data!.Id}");
    }

    private async Task VoidAsync(InvoiceDto invoice)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Void Invoice", new DialogParameters
        {
            ["Title"] = "Void Invoice",
            ["Message"] = $"Void invoice {invoice.InvoiceNumber}? This cannot be undone.",
            ["ConfirmText"] = "Void",
            ["IsDestructive"] = true
        }, PlatformDialogOptions.Confirm);
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var apiResult = await Api.VoidInvoiceAsync(invoice.Id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Void failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Invoice voided.", Severity.Success);
        await RefreshStatsAsync();
        await ReloadGrid();
    }

    private async Task ExportCsvAsync()
    {
        // Export every invoice matching the current filters, not just the visible page.
        var rows = await PlatformApiClient.ReadAllPagesAsync((page, size) => Api.GetInvoicesPagedAsync(
            _customerFilter,
            page,
            size,
            unpaidOnly: _statusFilter is null && _quickFilter == "unpaid",
            status: _statusFilter ?? (_quickFilter == "sent" ? InvoiceStatus.Sent : null),
            search: _customerSearch,
            issuedFrom: _dateRange?.Start,
            issuedTo: _dateRange?.End));

        if (rows.Count == 0)
        {
            Snackbar.Add("No invoices to export.", Severity.Info);
            return;
        }

        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var csv = new System.Text.StringBuilder("InvoiceNumber,Customer,Total,Paid,Due,Status,IssueDate,Currency\n");
        foreach (var invoice in rows)
        {
            csv.Append('"').Append(Escape(invoice.InvoiceNumber)).Append("\",\"")
                .Append(Escape(invoice.CustomerName)).Append("\",")
                .Append(invoice.TotalAmount.ToString(inv)).Append(',')
                .Append(invoice.AmountPaid.ToString(inv)).Append(',')
                .Append(invoice.AmountDue.ToString(inv)).Append(",\"")
                .Append(invoice.Status).Append("\",\"")
                .Append(invoice.IssueDate.ToString("yyyy-MM-dd", inv)).Append("\",\"")
                .Append(Escape(invoice.Currency)).Append("\"\n");
        }

        await JSRuntime.InvokeVoidAsync("platformDownloadText", "invoices.csv", csv.ToString());
        Snackbar.Add($"Exported {rows.Count} invoices.", Severity.Success);
    }

    private async Task RefreshStatsAsync()
    {
        _stats = await Api.GetInvoiceStatsAsync();
    }

    // E14: neutralise spreadsheet formula injection (customer names are user-controlled).
    private static string Escape(string? value)
    {
        var text = (value ?? "").Replace("\"", "\"\"");
        return text.Length > 0 && text[0] is '=' or '+' or '-' or '@' or '\t' or '\r' ? "'" + text : text;
    }

    private static string FormatMoney(decimal amount, string currency) =>
        currency.Equals("USD", StringComparison.OrdinalIgnoreCase)
            ? $"${amount:N2}"
            : $"{amount:N2} {currency}";

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "?";
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }
}
