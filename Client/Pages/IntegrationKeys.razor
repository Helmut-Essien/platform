@page "/integration-keys"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageHeader Title="Integration Keys" />

<MudAlert Severity="Severity.Warning" Class="mb-4">
    Integration keys cannot be recovered after creation. Copy them immediately and store them securely.
</MudAlert>

<MudForm @ref="_form" @bind-IsValid="_formValid" Class="mb-4">
    <MudSelect T="string" Value="_selectedProductId" ValueChanged="OnProductChanged"
               Label="Service product"
               Variant="Variant.Outlined"
               Required="true"
               RequiredError="Service product is required"
               Disabled="_busy"
               Class="mb-2">
        @foreach (var p in _products)
        {
            <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
        }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_formValid || _busy)" OnClick="RotateAsync">
        @(_busy ? "Creating..." : "Rotate / create key")
    </MudButton>
</MudForm>

@if (!string.IsNullOrEmpty(_plainKey))
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        <MudText Class="mb-2">Copy this key now — it will not be shown again:</MudText>
        <div class="d-flex align-center mt-2">
            <span class="license-key mr-2">@_plainKey</span>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Inherit"
                           OnClick="CopyKeyToClipboard" aria-label="Copy key to clipboard" />
        </div>
    </MudAlert>
}

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Class="mb-2" />
    @for (var i = 0; i < 5; i++)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="36px" Class="mb-1" />
    }
}
else if (_keys.Count == 0)
{
    <MudText Typo="Typo.subtitle1" Class="pa-4">No integration keys found.</MudText>
    <MudText Typo="Typo.body2" Class="px-4 pb-4">Select a service above and click Rotate / create key.</MudText>
}
else
{
    <MudTable Items="_keys" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Service</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Last used</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ServiceProductCode</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="@(context.IsActive ? Variant.Filled : Variant.Text)" Color="Color.Primary">
                    @(context.IsActive ? "Active" : "Revoked")
                </MudChip>
            </MudTd>
            <MudTd>@context.CreatedAt.ToString("g")</MudTd>
            <MudTd>@(context.LastUsedAt?.ToString("g") ?? "—")</MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => RevokeAsync(context.Id)">Revoke</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public string? ProductId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _formValid;
    private MudForm? _form;
    private List<IntegrationKeyDto> _keys = [];
    private List<ServiceProductDto> _products = [];
    private string? _selectedProductId;
    private string? _plainKey;

    protected override async Task OnInitializedAsync()
    {
        _products = await Api.GetServiceProductsAsync();

        if (!string.IsNullOrEmpty(ProductId) && _products.Any(p => p.Id == ProductId))
            _selectedProductId = ProductId;

        _selectedProductId ??= _products.FirstOrDefault()?.Id;
        await ReloadKeysAsync();
        _loading = false;
    }

    private async Task OnProductChanged(string? productId)
    {
        _selectedProductId = productId;
        await ReloadKeysAsync();
    }

    private async Task ReloadKeysAsync()
    {
        _keys = await Api.GetIntegrationKeysAsync(_selectedProductId);
    }

    private async Task RotateAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_formValid)
                return;
        }

        if (string.IsNullOrEmpty(_selectedProductId))
        {
            Snackbar.Add("Please select a service product.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Rotate Integration Key", new DialogParameters
        {
            ["Title"] = "Rotate Integration Key",
            ["Message"] = "Creating a new key will revoke the existing active key for this service. Any app using the old key will fail validation. Continue?",
            ["ConfirmText"] = "Rotate"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        _busy = true;
        try
        {
            var result = await Api.CreateIntegrationKeyAsync(_selectedProductId);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to create integration key.", Severity.Error);
                return;
            }

            _plainKey = result.Data!.PlainKey;
            Snackbar.Add("Integration key created.", Severity.Success);
            await ReloadKeysAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(string id)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Revoke Integration Key", new DialogParameters
        {
            ["Title"] = "Revoke Integration Key",
            ["Message"] = "External apps using this key will fail validation. This cannot be undone. Continue?",
            ["ConfirmText"] = "Revoke"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var result = await Api.RevokeIntegrationKeyAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to revoke key.", Severity.Error);
            return;
        }

        Snackbar.Add("Integration key revoked.", Severity.Success);
        await ReloadKeysAsync();
    }

    private async Task CopyKeyToClipboard()
    {
        if (string.IsNullOrEmpty(_plainKey))
            return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _plainKey);
        Snackbar.Add("Key copied to clipboard.", Severity.Success);
    }
}
