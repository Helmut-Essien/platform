@page "/integration-keys"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" Class="mb-4">Integration Keys</MudText>

<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
    Copy integration keys immediately after creation — they cannot be recovered.
</MudAlert>

<MudForm @ref="_form" @bind-IsValid="_formValid" Class="mb-4">
    <MudSelect T="string" @bind-Value="_productId"
               Label="Service product"
               Variant="Variant.Outlined"
               Required="true"
               RequiredError="Service product is required"
               Disabled="_busy"
               Class="mb-2">
        @foreach (var p in _products)
        {
            <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
        }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="RotateAsync">
        @(_busy ? "Creating..." : "Rotate / create key")
    </MudButton>
</MudForm>

@if (!string.IsNullOrEmpty(_plainKey))
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Copy this key now — it will not be shown again:
        <div class="d-flex align-center mt-2">
            <span class="license-key mr-2">@_plainKey</span>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Inherit"
                           OnClick="CopyKeyToClipboard" aria-label="Copy key to clipboard" />
        </div>
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_keys.Count == 0)
{
    <MudText Typo="Typo.subtitle1" Class="pa-4">No integration keys found.</MudText>
    <MudText Typo="Typo.body2" Class="px-4 pb-4">Select a service above and click Rotate / create key.</MudText>
}
else
{
    <MudTable Items="_keys" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Service</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Last used</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ServiceProductCode</MudTd>
            <MudTd>@(context.IsActive ? "Yes" : "No")</MudTd>
            <MudTd>@context.CreatedAt.ToString("g")</MudTd>
            <MudTd>@(context.LastUsedAt?.ToString("g") ?? "—")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public string? ProductId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private bool _formValid;
    private MudForm? _form;
    private List<IntegrationKeyDto> _keys = [];
    private List<ServiceProductDto> _products = [];
    private string? _productId;
    private string? _plainKey;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(ProductId) && _products.Any(p => p.Id == ProductId))
            _productId = ProductId;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _keys = await Api.GetIntegrationKeysAsync();
        _products = await Api.GetServiceProductsAsync();
        _productId ??= _products.FirstOrDefault()?.Id;

        if (!string.IsNullOrEmpty(ProductId) && _products.Any(p => p.Id == ProductId))
            _productId = ProductId;

        _loading = false;
    }

    private async Task RotateAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_formValid)
                return;
        }

        if (string.IsNullOrEmpty(_productId))
        {
            Snackbar.Add("Please select a service product.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Rotate Integration Key", new DialogParameters
        {
            ["Title"] = "Rotate Integration Key",
            ["Message"] = "This will invalidate the existing key for this service. Continue?",
            ["ConfirmText"] = "Rotate"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false) return;

        _busy = true;
        try
        {
            var result = await Api.CreateIntegrationKeyAsync(_productId);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to create integration key.", Severity.Error);
                return;
            }

            _plainKey = result.Data!.PlainKey;
            Snackbar.Add("Integration key created.", Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyKeyToClipboard()
    {
        if (string.IsNullOrEmpty(_plainKey)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _plainKey);
        Snackbar.Add("Key copied to clipboard.", Severity.Success);
    }
}
