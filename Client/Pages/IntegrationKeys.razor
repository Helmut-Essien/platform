@page "/integration-keys"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<div class="integration-keys-page">
    <header class="integration-keys-header">
        <div>
            <h1>Integration Keys</h1>
            <p>Manage API credentials and authentication tokens for your enterprise services.</p>
        </div>
        <button type="button" class="btn-generate-key" @onclick="OpenGenerateDialogAsync">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            Generate New Key
        </button>
    </header>

    <div class="integration-keys-alert" role="alert">
        <MudIcon Icon="@Icons.Material.Filled.Warning" />
        <p class="integration-keys-alert-text">
            <strong>Security Notice:</strong> Integration keys cannot be recovered after creation. Ensure you have stored them securely in your vault before closing the generation prompt.
        </p>
    </div>

    @if (_loading)
    {
        <div class="integration-keys-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        @if (_keys.Count > 0)
        {
            <section class="integration-keys-stats" aria-label="Integration key statistics">
                <div class="integration-keys-stat-card">
                    <span class="integration-keys-stat-label">Active Keys</span>
                    <span class="integration-keys-stat-value">@ActiveKeyCount</span>
                </div>
                <div class="integration-keys-stat-card">
                    <span class="integration-keys-stat-label">Requests / 24h</span>
                    <span class="integration-keys-stat-value">1.2M</span>
                </div>
                <div class="integration-keys-stat-card">
                    <span class="integration-keys-stat-label">Avg Latency</span>
                    <span class="integration-keys-stat-value">14ms</span>
                </div>
            </section>

            <section class="integration-keys-bento">
                @foreach (var (key, index) in _keys.Select((k, i) => (k, i)))
                {
                    var product = GetProduct(key);
                    <article class="integration-key-card @(key.IsActive ? "" : "revoked")">
                        <div>
                            <div class="integration-key-card-header">
                                <div class="integration-key-card-title">
                                    <div class="integration-key-card-icon">
                                        <MudIcon Icon="@GetServiceIcon(index)" />
                                    </div>
                                    <div>
                                        <h3 class="integration-key-card-name">@(product?.Name ?? key.ServiceProductCode ?? "Service")</h3>
                                        <p class="integration-key-card-subtitle">@GetSubtitle(product)</p>
                                    </div>
                                </div>
                                <span class="integration-key-status-badge @(key.IsActive ? "integration-key-status-active" : "integration-key-status-revoked")">
                                    @(key.IsActive ? "Active" : "Revoked")
                                </span>
                            </div>
                            <label class="integration-key-field-label">Service Key</label>
                            <div class="integration-key-masked">
                                <code>@MaskKey(key.ServiceProductCode)</code>
                                <button type="button" class="integration-key-copy-btn" aria-label="Copy key" @onclick="() => CopyMaskedKeyAsync(key)">
                                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                                </button>
                            </div>
                        </div>
                        <div class="integration-key-card-footer">
                            <span class="integration-key-created">Created: @key.CreatedAt.ToString("MMM dd, yyyy")</span>
                            @if (key.IsActive)
                            {
                                <button type="button" class="btn-revoke-key" @onclick="() => RevokeAsync(key.Id)">
                                    <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" />
                                    Revoke
                                </button>
                            }
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <div class="integration-keys-empty">
                <h2>No integration keys yet</h2>
                <p>Generate a key for a service product to authorize external license validation.</p>
                <button type="button" class="btn-generate-key" @onclick="OpenGenerateDialogAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    Generate New Key
                </button>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public string? ProductId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private List<IntegrationKeyDto> _keys = [];
    private List<ServiceProductDto> _products = [];

    private int ActiveKeyCount => _keys.Count(k => k.IsActive);

    private static readonly string[] ServiceIcons =
    [
        Icons.Material.Filled.Storage,
        Icons.Material.Filled.Payments,
        Icons.Material.Filled.BugReport,
        Icons.Material.Filled.Insights,
        Icons.Material.Filled.Api,
        Icons.Material.Filled.Cloud
    ];

    protected override async Task OnInitializedAsync()
    {
        _products = (await Api.GetServiceProductsAsync()).ToList();
        await ReloadKeysAsync();
        _loading = false;

        if (!string.IsNullOrEmpty(ProductId))
            await OpenGenerateDialogAsync(ProductId);
    }

    private async Task ReloadKeysAsync()
    {
        _keys = await Api.GetIntegrationKeysAsync();
    }

    private async Task OpenGenerateDialogAsync() =>
        await OpenGenerateDialogAsync(null);

    private async Task OpenGenerateDialogAsync(string? defaultProductId)
    {
        if (_busy)
            return;

        var dialog = await DialogService.ShowAsync<IntegrationKeyGenerateDialog>(
            "Generate Integration Key",
            new DialogParameters
            {
                [nameof(IntegrationKeyGenerateDialog.Products)] = _products,
                [nameof(IntegrationKeyGenerateDialog.DefaultProductId)] = defaultProductId ?? ProductId
            });

        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false || dialogResult.Data is not string serviceProductId)
            return;

        var existingActive = _keys.Any(k => k.ServiceProductId == serviceProductId && k.IsActive);
        if (existingActive)
        {
            var confirm = await DialogService.ShowAsync<ConfirmDialog>("Rotate Integration Key", new DialogParameters
            {
                ["Title"] = "Rotate Integration Key",
                ["Message"] = "Creating a new key will revoke the existing active key for this service. Any app using the old key will fail validation. Continue?",
                ["ConfirmText"] = "Generate"
            });
            var confirmResult = await confirm.Result;
            if (confirmResult?.Canceled is not false)
                return;
        }

        _busy = true;
        try
        {
            var result = await Api.CreateIntegrationKeyAsync(serviceProductId);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to create integration key.", Severity.Error);
                return;
            }

            var product = GetProduct(result.Data!.Key);
            await ShowRevealDialogAsync(
                result.Data.PlainKey,
                product?.Name ?? result.Data.Key.ServiceProductCode ?? "Service",
                result.Data.Key.ServiceProductCode ?? product?.Code ?? "—");

            Snackbar.Add("Integration key created.", Severity.Success);
            await ReloadKeysAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ShowRevealDialogAsync(string plainKey, string serviceName, string serviceCode)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<IntegrationKeyRevealDialog>(
            "Integration Key Created",
            new DialogParameters
            {
                [nameof(IntegrationKeyRevealDialog.PlainKey)] = plainKey,
                [nameof(IntegrationKeyRevealDialog.ServiceName)] = serviceName,
                [nameof(IntegrationKeyRevealDialog.ServiceCode)] = serviceCode
            },
            options);
    }

    private async Task RevokeAsync(string id)
    {
        var key = _keys.FirstOrDefault(k => k.Id == id);
        var product = key is null ? null : GetProduct(key);

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Revoke Integration Key", new DialogParameters
        {
            ["Title"] = "Revoke Integration Key",
            ["Message"] = $"Are you absolutely sure you want to revoke this key for {product?.Name ?? "this service"}? This action is irreversible and will immediately disconnect the associated service.",
            ["ConfirmText"] = "Revoke"
        });
        var dialogResult = await dialog.Result;
        if (dialogResult?.Canceled is not false)
            return;

        var result = await Api.RevokeIntegrationKeyAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to revoke key.", Severity.Error);
            return;
        }

        Snackbar.Add("Integration key revoked.", Severity.Success);
        await ReloadKeysAsync();
    }

    private Task CopyMaskedKeyAsync(IntegrationKeyDto key)
    {
        Snackbar.Add("Full key cannot be recovered. Generate a new key to rotate credentials.", Severity.Info);
        return Task.CompletedTask;
    }

    private ServiceProductDto? GetProduct(IntegrationKeyDto key) =>
        _products.FirstOrDefault(p => p.Id == key.ServiceProductId);

    private static string GetSubtitle(ServiceProductDto? product) =>
        string.IsNullOrWhiteSpace(product?.Description) ? "Enterprise API" : product.Description;

    private static string MaskKey(string? code)
    {
        var prefix = string.IsNullOrWhiteSpace(code) ? "SERVICE" : code.ToUpperInvariant();
        return $"pk_{prefix}_••••••••••••";
    }

    private static string GetServiceIcon(int index) =>
        ServiceIcons[index % ServiceIcons.Length];
}
