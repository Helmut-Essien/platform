@page "/forgot-password"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject PlatformApiClient Api
@inject NavigationManager Navigation

<MudPaper Class="login-card pa-5 pa-sm-8" Elevation="0">
    <div class="login-brand">
        <img src="images/login-logo.png" alt="HelmutCode" class="login-logo" />
        <MudText Typo="Typo.body2" Class="login-subtitle">
            Reset your admin password
        </MudText>
    </div>

    <MudDivider Class="login-divider" />

    @if (_submitted)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="login-error">
            If an account exists for that email, a reset link has been sent. Check your inbox.
        </MudAlert>
    }
    else
    {
        @if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="login-error"
                      CloseIconClicked="@(() => _hasError = false)"
                      ShowCloseIcon="true">
                @_errorMessage
            </MudAlert>
        }

        <form class="login-form" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          FullWidth="true"
                          Required="true"
                          Disabled="_busy"
                          AutoFocus="true" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="login-submit"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">
                @if (_busy)
                {
                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send reset link</span>
                }
            </MudButton>
        </form>
    }

    <MudLink Href="/login" Class="mt-4 d-block">Back to sign in</MudLink>
</MudPaper>

@code {
    private bool _busy;
    private bool _hasError;
    private bool _submitted;
    private string _errorMessage = "";
    private string _email = "";

    private async Task HandleSubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_email))
            return;

        _busy = true;
        _hasError = false;
        try
        {
            var result = await Api.ForgotPasswordAsync(new ForgotPasswordRequest { Email = _email.Trim() });
            if (!result.IsSuccess)
            {
                _hasError = true;
                _errorMessage = result.ErrorMessage ?? "Could not send reset email.";
                return;
            }

            _submitted = true;
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = "Request failed. Check that the API is running and try again.";
            Console.Error.WriteLine($"Forgot password error: {ex}");
        }
        finally
        {
            _busy = false;
        }
    }
}
