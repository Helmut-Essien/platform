@page "/audit"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageHeader Title="Audit Log">
    <MudButton Variant="Variant.Outlined" Disabled="_loading || _logs.Count == 0" OnClick="ExportCsvAsync">Export CSV</MudButton>
</PageHeader>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="AuditAction?" @bind-Value="_actionFilter" Label="Action" Variant="Variant.Outlined" Clearable="true">
            @foreach (var action in Enum.GetValues<AuditAction>())
            {
                <MudSelectItem Value="@((AuditAction?)action)">@action</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string" @bind-Value="_customerFilter" Label="Customer" Variant="Variant.Outlined" Clearable="true">
            @foreach (var c in _customers)
            {
                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudTextField @bind-Value="_search" Label="Search" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Class="d-flex align-end gap-2">
        <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">Apply filters</MudButton>
    </MudItem>
</MudGrid>

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Class="mb-2" />
    @for (var i = 0; i < 8; i++)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="36px" Class="mb-1" />
    }
}
else if (_filteredLogs.Count == 0)
{
    <MudText Typo="Typo.subtitle1" Class="pa-4">@(_logs.Count == 0 ? "No audit events recorded yet." : "No results match your filters.")</MudText>
    @if (_logs.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="px-4 pb-4">Audit events are logged automatically when licenses and customers are managed.</MudText>
    }
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var log in _filteredLogs)
        {
            <MudExpansionPanel Text="@($"{log.Timestamp:g} — {log.Action}")">
                <MudText Typo="Typo.body2"><strong>By:</strong> @log.PerformedBy</MudText>
                <MudText Typo="Typo.body2"><strong>Customer:</strong> @ResolveCustomer(log.CustomerId)</MudText>
                <MudText Typo="Typo.body2"><strong>License:</strong> @ResolveLicense(log.LicenseId)</MudText>
                @if (!string.IsNullOrEmpty(log.DetailsJson))
                {
                    <pre class="text-code mt-2">@log.DetailsJson</pre>
                }
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private bool _loading = true;
    private List<AuditLogDto> _logs = [];
    private List<CustomerDto> _customers = [];
    private Dictionary<string, string> _customerNames = [];
    private Dictionary<string, string> _licenseLabels = [];
    private AuditAction? _actionFilter;
    private string? _customerFilter;
    private string _search = "";
    private List<AuditLogDto>? _cachedFilteredLogs;
    private bool _filterDirty = true;

    private List<AuditLogDto> _filteredLogs
    {
        get
        {
            if (!_filterDirty)
                return _cachedFilteredLogs!;

            List<AuditLogDto> result;
            if (string.IsNullOrWhiteSpace(_search))
                result = _logs;
            else
            {
                result = _logs.Where(l =>
                    l.Action.ToString().Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (l.PerformedBy?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (ResolveCustomer(l.CustomerId)?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (ResolveLicense(l.LicenseId)?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
            }

            _cachedFilteredLogs = result;
            _filterDirty = false;
            return result;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var customersTask = Api.GetCustomersPagedAsync(page: 1, pageSize: 500);
        var licensesTask = Api.GetLicensesPagedAsync(page: 1, pageSize: 500);
        var logsTask = Api.GetAuditLogsAsync(
            customerId: _customerFilter,
            action: _actionFilter,
            limit: 200);

        await Task.WhenAll(customersTask, licensesTask, logsTask);

        _customers = customersTask.Result.Items.ToList();
        _customerNames = _customers.ToDictionary(c => c.Id, c => c.Name);
        var licenses = await licensesTask;
        _licenseLabels = licenses.Items.ToDictionary(
            l => l.Id,
            l => $"{l.CustomerName} / {l.ServiceProductCode}");
        _logs = await logsTask;

        _filterDirty = true;
        _loading = false;
    }

    private async Task ExportCsvAsync()
    {
        var rows = _filteredLogs;
        if (rows.Count == 0)
            return;

        var csv = "Timestamp,Action,PerformedBy,Customer,License,Details\n";
        foreach (var log in rows)
        {
            csv += $"\"{log.Timestamp:O}\",\"{log.Action}\",\"{Escape(log.PerformedBy)}\",\"{Escape(ResolveCustomer(log.CustomerId))}\",\"{Escape(ResolveLicense(log.LicenseId))}\",\"{Escape(log.DetailsJson)}\"\n";
        }

        await JSRuntime.InvokeVoidAsync("platformDownloadText", "audit-log.csv", csv);
        Snackbar.Add("CSV exported.", Severity.Success);
    }

    private static string Escape(string? value) =>
        (value ?? "").Replace("\"", "\"\"");

    private string ResolveCustomer(string? id) =>
        string.IsNullOrEmpty(id) ? "—"
        : _customerNames.TryGetValue(id, out var name) ? name
        : ShortId(id);

    private string ResolveLicense(string? id) =>
        string.IsNullOrEmpty(id) ? "—"
        : _licenseLabels.TryGetValue(id, out var label) ? label
        : ShortId(id);

    private static string ShortId(string id) =>
        id.Length <= 12 ? id : $"{id[..8]}…";
}
