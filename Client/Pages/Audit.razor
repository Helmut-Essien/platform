@page "/audit"
@attribute [Authorize]
@inject PlatformApiClient Api
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
<div class="audit-page page-content">
    <header class="audit-header">
        <div>
            <h1 class="page-title">Audit Log</h1>
            <p class="page-subtitle">Comprehensive tracking of all administrative actions and security events.</p>
        </div>
        <div class="audit-header-tools">
            <div class="audit-search-wrap">
                <MudTextField @bind-Value="_search"
                              Placeholder="Search logs..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="OnSearchChanged" />
            </div>
            <button type="button" class="btn-export-csv" disabled="@(_loading || _total == 0)" @onclick="ExportCsvAsync">
                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                Export CSV
            </button>
        </div>
    </header>

    <section class="audit-filters-panel" aria-label="Filters">
        <MudSelect T="AuditAction?" Value="_actionFilter" ValueChanged="OnActionFilterChanged" Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width: 12rem;">
            <MudSelectItem Value="@((AuditAction?)null)">All Actions</MudSelectItem>
            @foreach (var action in Enum.GetValues<AuditAction>())
            {
                <MudSelectItem Value="@((AuditAction?)action)">@FormatAction(action)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Value="_customerFilter" ValueChanged="OnCustomerFilterChanged" Label="Customer" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width: 12rem;">
            <MudSelectItem Value="@((string?)null)">All Customers</MudSelectItem>
            @foreach (var c in _customers)
            {
                <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">Refresh</MudButton>
    </section>

    @if (_loading)
    {
        <div class="audit-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_total == 0)
    {
        <div class="audit-empty">
            <h2>@(HasActiveFilters ? "No results match your filters" : "No audit events recorded yet")</h2>
            <p>@(HasActiveFilters ? "Try adjusting your search or filters." : "Audit events are logged automatically when licenses and customers are managed.")</p>
        </div>
    }
    else
    {
        <div class="audit-table-panel">
            <div style="overflow-x: auto;">
                <table class="audit-table">
                    <thead>
                        <tr>
                            <th class="cell-center"></th>
                            <th>Timestamp</th>
                            <th>Admin</th>
                            <th>Action</th>
                            <th>Target</th>
                            <th>IP Address</th>
                            <th class="cell-right"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _logs)
                        {
                            var expanded = _expandedIds.Contains(log.Id);
                            <tr class="audit-row" @onclick="() => ToggleExpanded(log.Id)">
                                <td class="cell-center">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="@($"audit-chevron {(expanded ? "expanded" : "")}")" />
                                </td>
                                <td class="audit-timestamp">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="audit-admin-cell">
                                        <div class="audit-admin-avatar @GetAvatarClass(log)">@GetAdminInitials(log.PerformedBy)</div>
                                        <span class="audit-admin-name">@log.PerformedBy</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="audit-action-badge @GetActionClass(log.Action)">@FormatAction(log.Action)</span>
                                </td>
                                <td>@GetTargetLabel(log)</td>
                                <td class="audit-ip">@(string.IsNullOrWhiteSpace(log.IpAddress) ? "—" : log.IpAddress)</td>
                                <td class="cell-right" @onclick:stopPropagation="true">
                                    <div class="audit-row-menu">
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight">
                                            @if (!string.IsNullOrEmpty(log.CustomerId))
                                            {
                                                <MudMenuItem Href="@($"/customers?highlight={log.CustomerId}")">View customer</MudMenuItem>
                                            }
                                            @if (!string.IsNullOrEmpty(log.LicenseId))
                                            {
                                                <MudMenuItem Href="@($"/licenses?highlight={log.LicenseId}")">View license</MudMenuItem>
                                            }
                                            @if (!string.IsNullOrEmpty(log.InvoiceId))
                                            {
                                                <MudMenuItem Href="@($"/invoices/{log.InvoiceId}")">View invoice</MudMenuItem>
                                            }
                                            <MudMenuItem OnClick="@(() => CopyJsonAsync(log))">Copy details</MudMenuItem>
                                        </MudMenu>
                                    </div>
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                <tr class="audit-details-row">
                                    <td colspan="7">
                                        <div class="audit-details-panel">
                                            @if (!string.IsNullOrWhiteSpace(log.DetailsJson))
                                            {
                                                <div class="audit-details-header">
                                                    <span class="audit-details-label">DETAILS_JSON</span>
                                                    <button type="button" class="btn-copy-json" @onclick="() => CopyJsonAsync(log)" @onclick:stopPropagation="true">
                                                        <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                                                        Copy
                                                    </button>
                                                </div>
                                                <pre class="audit-json-pre">@FormatJson(log.DetailsJson)</pre>
                                            }
                                            else
                                            {
                                                <span class="audit-details-label">No additional details recorded.</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="audit-table-footer">
                <div class="audit-pagination-info">
                    <div class="audit-page-size">
                        <span>Items per page:</span>
                        <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 5rem;">
                            @foreach (var size in PageSizes)
                            {
                                <MudSelectItem Value="@size">@size</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <span>@PaginationLabel</span>
                </div>
                <div class="audit-pagination-controls">
                    <button type="button" class="audit-page-btn" disabled="@(_page <= 1)" @onclick="() => GoToPage(1)" aria-label="First page">
                        <MudIcon Icon="@Icons.Material.Filled.FirstPage" Size="Size.Small" />
                    </button>
                    <button type="button" class="audit-page-btn" disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)" aria-label="Previous page">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                    </button>
                    @foreach (var pageNum in VisiblePages)
                    {
                        <button type="button" class="audit-page-btn @(pageNum == _page ? "active" : "")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button type="button" class="audit-page-btn" disabled="@(_page >= TotalPages)" @onclick="() => GoToPage(_page + 1)" aria-label="Next page">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </button>
                    <button type="button" class="audit-page-btn" disabled="@(_page >= TotalPages)" @onclick="() => GoToPage(TotalPages)" aria-label="Last page">
                        <MudIcon Icon="@Icons.Material.Filled.LastPage" Size="Size.Small" />
                    </button>
                </div>
            </div>
        </div>

        @if (_stats is not null)
        {
            <section class="audit-stats-grid" aria-label="Audit statistics">
                <div class="audit-stat-card">
                    <span class="audit-stat-label">Total Logs</span>
                    <div class="audit-stat-value">@_stats.TotalCount.ToString("N0")</div>
                    <div class="audit-stat-footnote positive">+@_stats.TodayCount.ToString("N0") today (UTC)</div>
                </div>
                <div class="audit-stat-card">
                    <span class="audit-stat-label">Security Flags</span>
                    <div class="audit-stat-value">@_stats.SecurityFlagCount.ToString("N0")</div>
                    <div class="audit-stat-footnote danger">@_stats.CriticalFlagCount.ToString("N0") critical needs review</div>
                </div>
            </section>
        }
    }
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50, 100];

    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 25;
    private int _total;
    private int _requestId;
    private List<AuditLogDto> _logs = [];
    private List<CustomerDto> _customers = [];
    private AuditLogStatsDto? _stats;
    private HashSet<string> _expandedIds = [];
    private AuditAction? _actionFilter;
    private string? _customerFilter;
    private string _search = "";

    [SupplyParameterFromQuery] public string? CustomerId { get; set; }
    [SupplyParameterFromQuery] public string? LicenseId { get; set; }
    [SupplyParameterFromQuery] public string? InvoiceId { get; set; }

    private bool HasActiveFilters =>
        _actionFilter is not null
        || !string.IsNullOrEmpty(_customerFilter)
        || !string.IsNullOrWhiteSpace(_search)
        || !string.IsNullOrEmpty(LicenseId)
        || !string.IsNullOrEmpty(InvoiceId);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    private string PaginationLabel
    {
        get
        {
            if (_total == 0)
                return "0 items";

            var start = (_page - 1) * _pageSize + 1;
            var end = Math.Min(_page * _pageSize, _total);
            return $"{start}–{end} of {_total:N0} items";
        }
    }

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var pages = new List<int>();
            var start = Math.Max(1, _page - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);

            for (var i = start; i <= end; i++)
                pages.Add(i);

            return pages;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(CustomerId))
            _customerFilter = CustomerId;

        // Customers feed the filter dropdown only; names in the table come with each log entry.
        var customersTask = Api.GetAllCustomersAsync();
        await Task.WhenAll(LoadAsync(), customersTask);
        _customers = await customersTask;
    }

    private async Task LoadAsync()
    {
        // Ignore out-of-order responses when the user changes filters quickly.
        var request = ++_requestId;
        _loading = true;
        StateHasChanged();

        var logsTask = Api.GetAuditLogsPagedAsync(
            _page,
            _pageSize,
            customerId: _customerFilter,
            licenseId: LicenseId,
            invoiceId: InvoiceId,
            action: _actionFilter,
            search: _search);
        var statsTask = Api.GetAuditLogStatsAsync();
        await Task.WhenAll(logsTask, statsTask);

        if (request != _requestId)
            return;

        var result = await logsTask;
        _logs = result.Items.ToList();
        _total = result.TotalCount;
        _stats = await statsTask;
        _loading = false;
    }

    private void ToggleExpanded(string id)
    {
        if (!_expandedIds.Add(id))
            _expandedIds.Remove(id);
    }

    private async Task GoToPage(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages);
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnActionFilterChanged(AuditAction? value)
    {
        _actionFilter = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnCustomerFilterChanged(string? value)
    {
        _customerFilter = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnSearchChanged()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ExportCsvAsync()
    {
        // Export everything matching the current filters, not only the visible page.
        var rows = await PlatformApiClient.ReadAllPagesAsync((page, size) => Api.GetAuditLogsPagedAsync(
            page,
            size,
            customerId: _customerFilter,
            licenseId: LicenseId,
            invoiceId: InvoiceId,
            action: _actionFilter,
            search: _search));
        if (rows.Count == 0)
            return;

        var csv = new System.Text.StringBuilder("Timestamp,Action,PerformedBy,Target,IpAddress,Details\n");
        foreach (var log in rows)
        {
            csv.Append($"\"{log.Timestamp:O}\",\"{FormatAction(log.Action)}\",\"{Escape(log.PerformedBy)}\",\"{Escape(GetTargetLabel(log))}\",\"{Escape(log.IpAddress)}\",\"{Escape(log.DetailsJson)}\"\n");
        }

        await JSRuntime.InvokeVoidAsync("platformDownloadText", "audit-log.csv", csv.ToString());
        Snackbar.Add($"Exported {rows.Count} entries.", Severity.Success);
    }

    private async Task CopyJsonAsync(AuditLogDto log)
    {
        var text = string.IsNullOrWhiteSpace(log.DetailsJson) ? "{}" : FormatJson(log.DetailsJson);
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add("Details copied.", Severity.Success);
    }

    private static string? GetTargetLabel(AuditLogDto log)
    {
        if (!string.IsNullOrEmpty(log.LicenseId))
            return log.LicenseLabel ?? ShortId(log.LicenseId);

        if (!string.IsNullOrEmpty(log.InvoiceId))
            return ShortId(log.InvoiceId);

        if (!string.IsNullOrEmpty(log.CustomerId))
            return log.CustomerName ?? ShortId(log.CustomerId);

        return "—";
    }

    private static string GetActionClass(AuditAction action) => action switch
    {
        AuditAction.LicenseRevoked or AuditAction.LicenseSuspended or AuditAction.CustomerSuspended
            or AuditAction.IntegrationKeyRevoked or AuditAction.InvoiceVoided => "audit-action-danger",
        AuditAction.LicenseActivated or AuditAction.LicenseRenewed or AuditAction.IntegrationKeyCreated
            or AuditAction.LicenseIssued or AuditAction.CustomerCreated => "audit-action-primary",
        _ => "audit-action-neutral"
    };

    private static string GetAvatarClass(AuditLogDto log) =>
        GetActionClass(log.Action) == "audit-action-danger" ? "neutral" : "";

    private static string FormatAction(AuditAction action) =>
        System.Text.RegularExpressions.Regex.Replace(action.ToString(), "([a-z])([A-Z])", "$1_$2").ToUpperInvariant();

    private static string FormatJson(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string GetAdminInitials(string performedBy)
    {
        if (string.IsNullOrWhiteSpace(performedBy))
            return "?";

        var local = performedBy.Split('@')[0];
        var parts = local.Split(['.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return local.Length >= 2 ? local[..2].ToUpperInvariant() : local.ToUpperInvariant();
    }

    // E14: neutralise spreadsheet formula injection in exported cells.
    private static string Escape(string? value)
    {
        var text = (value ?? "").Replace("\"", "\"\"");
        return text.Length > 0 && text[0] is '=' or '+' or '-' or '@' or '\t' or '\r' ? "'" + text : text;
    }

    private static string ShortId(string id) =>
        id.Length <= 12 ? id : $"{id[..8]}…";
}
