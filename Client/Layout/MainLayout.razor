@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject TokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthState
@inject IJSRuntime JSRuntime

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Toggle navigation menu" />
        <MudLink Href="/" Underline="Underline.None" Class="d-flex align-center">
            <MudImage Src="images/helmutcode-icon.png" Alt="HelmutCode" Class="brand-logo mr-2" />
            <MudText Typo="Typo.h6" Color="Color.Inherit">Platform Admin</MudText>
        </MudLink>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-4">@(_email ?? "")</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Logout">Logout</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="_drawerVariant"
               ClipMode="DrawerClipMode.Always"
               Class="app-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private DrawerVariant _drawerVariant = DrawerVariant.Temporary;
    private string? _email;

    protected override async Task OnInitializedAsync()
    {
        _email = await TokenStorage.GetEmailAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
        if (width >= 1280)
        {
            _drawerOpen = true;
            _drawerVariant = DrawerVariant.Mini;
        }
        else
        {
            _drawerOpen = false;
            _drawerVariant = DrawerVariant.Temporary;
        }
        StateHasChanged();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task Logout()
    {
        await TokenStorage.ClearAsync();
        AuthState.NotifyStateChanged();
        Navigation.NavigateTo("/login");
    }
}
