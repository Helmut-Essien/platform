@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject TokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ApiFailureNotifier ApiFailures
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<a href="#main-content" class="skip-link">Skip to content</a>

<MudLayout Class="platform-shell">
    <MudAppBar Elevation="0" Class="app-bar" Dense="true">
        @* Compact app bar (< 1024px) *@
        <div class="app-bar-compact">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Primary"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer"
                           aria-label="Open navigation menu"
                           aria-expanded="@_drawerOpen"
                           Class="menu-btn overlay-menu-btn" />
            <MudLink Href="/dashboard" Underline="Underline.None" Class="app-bar-brand">
                <MudText Typo="Typo.h6" Class="app-bar-title">HelmutCode</MudText>
            </MudLink>
            <MudSpacer />
            <div class="app-bar-actions">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true"
                         AriaLabel="Account menu" Class="account-menu">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" aria-label="Account menu" />
                    </ActivatorContent>
                    <ChildContent>
                        <div class="account-menu-header">
                            <p class="account-menu-name">@DisplayName</p>
                            @if (!string.IsNullOrWhiteSpace(_email))
                            {
                                <p class="account-menu-email">@_email</p>
                            }
                            <p class="account-menu-role">@_role</p>
                        </div>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Log out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </div>

        @* Desktop app bar (≥ 1024px) *@
        <div class="app-bar-desktop">
            <div class="app-bar-desktop-start">
                <div class="app-bar-logo-badge" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Medium" />
                </div>
                <MudLink Href="/dashboard" Underline="Underline.None" Class="app-bar-brand">
                    <MudText Typo="Typo.h6" Class="app-bar-title">HelmutCode</MudText>
                </MudLink>
            </div>
            <MudSpacer />
            <div class="app-bar-desktop-end">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true"
                         AriaLabel="Account menu" Class="account-menu">
                    <ActivatorContent>
                        <button type="button" class="app-bar-user-cluster account-menu-trigger" aria-label="Account menu">
                            <span class="app-bar-user-meta">
                                <span class="app-bar-user-name">@DisplayName</span>
                                <span class="app-bar-user-role">@_role</span>
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="account-menu-header">
                            <p class="account-menu-name">@DisplayName</p>
                            @if (!string.IsNullOrWhiteSpace(_email))
                            {
                                <p class="account-menu-email">@_email</p>
                            }
                            <p class="account-menu-role">@_role</p>
                        </div>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Log out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </div>
    </MudAppBar>

    @* Desktop (≥1024px): Stitch-style CSS rail — width 64px → 280px on hover *@
    <aside class="platform-sidebar-rail" tabindex="-1" aria-label="Main navigation panel">
        <NavMenu Email="@(_email ?? "")" Role="@_role" />
    </aside>

    @* Tablet/mobile (<1024px): temporary overlay drawer *@
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Temporary"
               Anchor="Anchor.Start"
               Elevation="0"
               ClipMode="DrawerClipMode.Always"
               Class="platform-sidebar platform-sidebar-overlay"
               Width="280px">
        <div class="drawer-header drawer-header-overlay">
            <span class="drawer-admin-menu-title">Menu</span>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="Color.Inherit"
                           OnClick="CloseOverlayDrawer"
                           aria-label="Close navigation menu"
                           Class="drawer-close-btn" />
        </div>

        <NavMenu Email="@(_email ?? "")"
                 Role="@_role"
                 OnNavigate="CloseDrawerIfOverlay" />
    </MudDrawer>

    <MudMainContent Class="platform-main-content">
        <div id="main-content" class="platform-main-inner" tabindex="-1">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private string? _email;
    private string _role = UserDisplay.NoRoleLabel;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private string DisplayName => UserDisplay.Name(_email);

    protected override async Task OnInitializedAsync()
    {
        ApiFailures.Failed += OnApiFailure;
        _email = await TokenStorage.GetEmailAsync();
        if (AuthenticationStateTask is not null)
            _role = UserDisplay.Role((await AuthenticationStateTask).User);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("platformShell.registerNavShell", _dotNetRef);
            await SyncDrawerToViewportAsync();
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task CloseDrawerIfOverlay()
    {
        if (await IsNavOverlayAsync())
            _drawerOpen = false;
    }

    private async Task CloseOverlayDrawer()
    {
        if (await IsNavOverlayAsync())
            _drawerOpen = false;
    }

    [JSInvokable]
    public void CloseDrawerFromEscape()
    {
        _drawerOpen = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task SyncDrawerFromViewport(bool isDesktop)
    {
        // Overlay drawer is closed on desktop; rail is always visible via CSS.
        if (isDesktop && _drawerOpen)
        {
            _drawerOpen = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SyncDrawerToViewportAsync()
    {
        try
        {
            var isDesktop = await JS.InvokeAsync<bool>("platformShell.isDesktopNav");
            if (isDesktop)
                _drawerOpen = false;
        }
        catch
        {
            // JS not ready
        }
    }

    private async Task<bool> IsNavOverlayAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("platformShell.isNavOverlay");
        }
        catch
        {
            return false;
        }
    }

    private async Task Logout()
    {
        await TokenStorage.ClearAsync();
        AuthState.NotifyStateChanged();
        Navigation.NavigateTo("/login", replace: true);
    }

    private void OnApiFailure(string message) => Snackbar.Add(message, Severity.Warning);

    public async ValueTask DisposeAsync()
    {
        ApiFailures.Failed -= OnApiFailure;
        if (_dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("platformShell.unregisterNavShell");
            }
            catch
            {
                // component teardown
            }
            _dotNetRef.Dispose();
        }
    }
}
