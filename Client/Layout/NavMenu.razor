<nav class="platform-nav" aria-label="Main navigation">
    <div class="platform-nav-links">
        @foreach (var navSection in NavItems.GroupBy(i => i.Section))
        {
            @if (!string.IsNullOrEmpty(navSection.Key))
            {
                <div class="platform-nav-section" role="presentation">
                    <span class="platform-nav-section-title">@navSection.Key</span>
                </div>
            }
            @foreach (var item in navSection)
            {
                <NavLink href="@item.Href"
                         Match="@item.Match"
                         class="platform-nav-item"
                         ActiveClass="active"
                         title="@item.Label"
                         @onclick="HandleNavClick">
                    <span class="platform-nav-icon-slot" aria-hidden="true">
                        <MudIcon Icon="@item.Icon" Size="Size.Large" Color="Color.Inherit" />
                    </span>
                    <span class="platform-nav-label">@item.Label</span>
                </NavLink>
            }
        }
    </div>

    <footer class="platform-nav-profile">
        <div class="platform-nav-profile-avatar" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" Color="Color.Inherit" />
        </div>
        <div class="platform-nav-profile-meta">
            <span class="platform-nav-profile-name">@DisplayName</span>
            <span class="platform-nav-profile-role">@Role</span>
        </div>
    </footer>
</nav>

@inject IJSRuntime JS

@code {
    [Parameter] public string Email { get; set; } = "";
    [Parameter] public string Role { get; set; } = UserDisplay.NoRoleLabel;
    [Parameter] public EventCallback OnNavigate { get; set; }

    private string DisplayName => UserDisplay.Name(Email);

    private sealed record NavItem(string Section, string Href, string Label, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);

    private const string Operations = "Operations";
    private const string Configuration = "Configuration";
    private const string Tools = "Tools";

    private static readonly NavItem[] NavItems =
    [
        new("", "/dashboard", "Dashboard", Icons.Material.Filled.Dashboard, NavLinkMatch.All),
        new(Operations, "/customers", "Customers", Icons.Material.Filled.Group),
        new(Operations, "/licenses", "Licenses", Icons.Material.Filled.VpnKey),
        new(Operations, "/invoices", "Invoices", Icons.Material.Filled.ReceiptLong),
        new(Configuration, "/services", "Service Catalog", Icons.Material.Filled.Inventory2),
        new(Configuration, "/integration-keys", "Integration Keys", Icons.Material.Filled.Key),
        new(Configuration, "/settings", "Settings", Icons.Material.Filled.Settings),
        new(Tools, "/audit", "Audit Log", Icons.Material.Filled.History),
        new(Tools, "/validate", "Validate License", Icons.Material.Filled.VerifiedUser)
    ];

    private async Task HandleNavClick()
    {
        if (OnNavigate.HasDelegate)
            await OnNavigate.InvokeAsync();

        try
        {
            await JS.InvokeVoidAsync("platformShell.collapseRailAfterNav");
            await JS.InvokeVoidAsync("platformShell.blurNavFocus");
        }
        catch
        {
            // JS not ready
        }
    }
}
