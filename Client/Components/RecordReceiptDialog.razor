<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Record Payment</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudNumericField @bind-Value="_model.AmountPaid"
                             Label="Amount paid"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Required="true"
                             RequiredError="Amount is required"
                             Class="mb-2" />
            <MudSelect T="PaymentMethod" @bind-Value="_model.PaymentMethod"
                       Label="Payment method"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var method in Enum.GetValues<PaymentMethod>())
                {
                    <MudSelectItem Value="@method">@method</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.PaymentReference"
                          Label="Reference (optional)"
                          Variant="Variant.Outlined"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.Notes"
                          Label="Notes (optional)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_paidAt"
                           Label="Paid at"
                           Variant="Variant.Outlined" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Record</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public decimal AmountDue { get; set; }

    private MudForm? _form;
    private bool _formValid;
    private DateTime? _paidAt = DateTime.UtcNow;
    private RecordReceiptRequest _model = new() { PaymentMethod = PaymentMethod.BankTransfer };

    protected override void OnInitialized()
    {
        _model.AmountPaid = AmountDue > 0 ? AmountDue : 0;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid || _model.AmountPaid <= 0)
            return;

        _model.PaidAt = _paidAt ?? DateTime.UtcNow;
        MudDialog.Close(DialogResult.Ok(_model));
    }
}
