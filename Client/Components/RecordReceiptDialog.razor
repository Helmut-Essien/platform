@using Platform.Shared.Enums
@using Platform.Shared.Dtos.Billing

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Record Payment</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Balance due: <strong>@AmountDue.ToString("N2")</strong>
        </MudText>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudNumericField @bind-Value="_model.AmountPaid"
                             For="@(() => _model.AmountPaid)"
                             Label="Amount paid"
                             Variant="Variant.Outlined"
                             Min="0.01m"
                             Max="@AmountDue"
                             Class="mb-2" />
            <MudSelect T="PaymentMethod" @bind-Value="_model.PaymentMethod"
                       For="@(() => _model.PaymentMethod)"
                       Label="Payment method"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var method in Enum.GetValues<PaymentMethod>())
                {
                    <MudSelectItem Value="@method">@method</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.PaymentReference"
                          For="@(() => _model.PaymentReference)"
                          Label="@(RequiresReference(_model.PaymentMethod) ? "Reference" : "Reference (optional)")"
                          Variant="Variant.Outlined"
                          Required="@RequiresReference(_model.PaymentMethod)"
                          RequiredError="Reference is required for this payment method"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.Notes"
                          For="@(() => _model.Notes)"
                          Label="Notes (optional)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_model.PaidAt"
                           For="@(() => _model.PaidAt)"
                           Label="Paid at"
                           Variant="Variant.Outlined" />
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-2">@_error</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Record
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public decimal AmountDue { get; set; }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<RecordReceiptRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private MudForm? _form;
    private bool _formValid;
    private string? _error;
    private readonly string _idempotencyKey = Guid.NewGuid().ToString("N");
    private RecordReceiptRequest _model = new()
    {
        IdempotencyKey = "",
        PaymentMethod = PaymentMethod.BankTransfer,
        PaidAt = DateTime.UtcNow
    };

    protected override void OnInitialized()
    {
        _model.IdempotencyKey = _idempotencyKey;
        _model.AmountPaid = AmountDue > 0 ? AmountDue : 0.01m;
    }

    private static bool RequiresReference(PaymentMethod method) => method != PaymentMethod.Cash;

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        _error = null;
        await _form.Validate();
        if (!_formValid)
            return;

        if (_model.AmountPaid > AmountDue)
        {
            _error = $"Amount cannot exceed balance due of {AmountDue:N2}.";
            return;
        }

        if (RequiresReference(_model.PaymentMethod) && string.IsNullOrWhiteSpace(_model.PaymentReference))
        {
            _error = "Reference is required for this payment method.";
            return;
        }

        _model.IdempotencyKey = _idempotencyKey;
        _model.PaidAt ??= DateTime.UtcNow;
        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(RecordReceiptRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
