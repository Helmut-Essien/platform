@inject PlatformApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDrawer @bind-Open="Open"
           Anchor="Anchor.Right"
           Elevation="0"
           Width="480px"
           Overlay="true"
           Class="customer-drawer-root">
    @if (Customer is not null)
    {
        <header class="customer-drawer-header">
            <div class="customer-drawer-identity">
                <div class="customer-drawer-avatar @(Customer.IsSuspended ? "suspended" : "")">@GetInitials(Customer.Name)</div>
                <div class="min-width-0">
                    <h2 class="page-title-drawer">@Customer.Name</h2>
                    <StatusBadge CustomerSuspended="Customer.IsSuspended" />
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="Color.Inherit"
                           aria-label="Close"
                           OnClick="CloseDrawer" />
        </header>

        <nav class="customer-drawer-tabs" aria-label="Customer sections">
            @foreach (var tab in _tabs)
            {
                <button type="button"
                        class="customer-drawer-tab @(_activeTab == tab.Key ? "active" : "")"
                        @onclick="() => SelectTabAsync(tab.Key)">
                    @tab.Label
                </button>
            }
        </nav>

        <div class="customer-drawer-body">
            @if (_loadingTab)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_activeTab == "profile")
            {
                <section>
                    <h3 class="customer-drawer-section-title">General Information</h3>
                    <div class="customer-drawer-info-grid">
                        <div class="customer-drawer-info-card">
                            <label>Contact email</label>
                            <span>@Customer.ContactEmail</span>
                        </div>
                        <div class="customer-drawer-info-card">
                            <label>Technical email</label>
                            <span>@(Customer.TechnicalEmail ?? $"{Customer.ContactEmail} (fallback)")</span>
                        </div>
                        <div class="customer-drawer-info-card">
                            <label>Billing email</label>
                            <span>@(Customer.BillingEmail ?? $"{Customer.ContactEmail} (fallback)")</span>
                        </div>
                        <div class="customer-drawer-info-card">
                            <label>Contact phone</label>
                            <span>@(Customer.ContactPhone ?? "—")</span>
                        </div>
                        <div class="customer-drawer-info-card">
                            <label>Customer ID</label>
                            <span class="mono">@FormatShortId(Customer.Id)</span>
                        </div>
                        <div class="customer-drawer-info-card">
                            <label>Created</label>
                            <span>@Customer.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="customer-drawer-info-card">
                            <label>Licenses</label>
                            <span class="mono">@Customer.LicenseCount</span>
                        </div>
                    </div>
                </section>
                @if (!string.IsNullOrWhiteSpace(Customer.InternalNotes))
                {
                    <section>
                        <h3 class="customer-drawer-section-title">Notes</h3>
                        <div class="customer-drawer-notes">"@Customer.InternalNotes"</div>
                    </section>
                }
            }
            else if (_activeTab == "licenses")
            {
                @if (_licenses.Count == 0)
                {
                    <div class="customer-drawer-tab-empty">
                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" />
                        <p>No licenses for this customer.</p>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@($"/licenses?customerId={Customer.Id}")">Issue license</MudButton>
                    </div>
                }
                else
                {
                    <MudTable Items="_licenses" Dense="true" Hover="true" Class="customer-drawer-table">
                        <HeaderContent>
                            <MudTh>Service</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Expires</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ServiceProductCode</MudTd>
                            <MudTd><LicenseStatusChip Status="context.Status" /></MudTd>
                            <MudTd>@(context.ExpiresAt?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
            else if (_activeTab == "invoices")
            {
                @if (_invoices.Count == 0)
                {
                    <div class="customer-drawer-tab-empty">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                        <p>No invoices for this customer.</p>
                    </div>
                }
                else
                {
                    <MudTable Items="_invoices" Dense="true" Hover="true" Class="customer-drawer-table">
                        <HeaderContent>
                            <MudTh>Invoice #</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><MudLink Href="@($"/invoices/{context.Id}")">@context.InvoiceNumber</MudLink></MudTd>
                            <MudTd>@context.Status</MudTd>
                            <MudTd>@context.TotalAmount.ToString("N2")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
            else if (_activeTab == "audit")
            {
                @if (_audit.Count == 0)
                {
                    <div class="customer-drawer-tab-empty">
                        <MudIcon Icon="@Icons.Material.Filled.History" />
                        <p>No audit events for this customer.</p>
                    </div>
                }
                else
                {
                    <MudTable Items="_audit" Dense="true" Hover="true" Class="customer-drawer-table">
                        <HeaderContent>
                            <MudTh>Timestamp</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Timestamp.ToString("g")</MudTd>
                            <MudTd>@context.Action</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
            else if (_activeTab == "communications")
            {
                <DeliveryTimeline CustomerId="@Customer.Id" />
            }
        </div>

        <footer class="customer-drawer-footer">
            <button type="button" class="btn-drawer-edit" @onclick="EditAsync">Edit Record</button>
            @if (Customer.IsSuspended)
            {
                <button type="button" class="btn-drawer-reactivate" @onclick="ReactivateAsync">Reactivate</button>
            }
            else
            {
                <button type="button" class="btn-drawer-suspend" @onclick="SuspendAsync">Suspend</button>
            }
        </footer>
    }
</MudDrawer>

@code {
    private readonly (string Key, string Label)[] _tabs =
    [
        ("profile", "Profile"),
        ("licenses", "Licenses"),
        ("invoices", "Invoices"),
        ("communications", "Communications"),
        ("audit", "Audit")
    ];

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public CustomerDto? Customer { get; set; }

    [Parameter] public EventCallback OnCustomerUpdated { get; set; }

    private string _activeTab = "profile";
    private bool _loadingTab;
    private List<LicenseDto> _licenses = [];
    private List<InvoiceDto> _invoices = [];
    private List<AuditLogDto> _audit = [];
    private string? _lastCustomerId;

    protected override void OnParametersSet()
    {
        if (Customer?.Id != _lastCustomerId)
        {
            _lastCustomerId = Customer?.Id;
            _licenses = [];
            _invoices = [];
            _audit = [];
            _activeTab = "profile";
        }
    }

    private async Task SelectTabAsync(string tab)
    {
        _activeTab = tab;
        if (tab != "profile")
            await LoadTabAsync();
    }

    private async Task LoadTabAsync()
    {
        if (Customer is null)
            return;

        _loadingTab = true;
        StateHasChanged();

        switch (_activeTab)
        {
            case "licenses":
                _licenses = (await Api.GetLicensesPagedAsync(Customer.Id, page: 1, pageSize: 50)).Items.ToList();
                break;
            case "invoices":
                _invoices = (await Api.GetInvoicesPagedAsync(Customer.Id, page: 1, pageSize: 50)).Items.ToList();
                break;
            case "audit":
                _audit = await Api.GetAuditLogsAsync(customerId: Customer.Id, limit: 50);
                break;
        }

        _loadingTab = false;
        StateHasChanged();
    }

    private async Task CloseDrawer()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    private async Task EditAsync()
    {
        if (Customer is null)
            return;

        var dialog = await DialogService.ShowAsync<CustomerEditDialog>("Edit Customer", new DialogParameters
        {
            [nameof(CustomerEditDialog.Customer)] = Customer
        });
        var result = await dialog.Result;
        if (result?.Canceled is not false || result.Data is not UpdateCustomerRequest request)
            return;

        var update = await Api.UpdateCustomerAsync(Customer.Id, request);
        if (!update.IsSuccess)
        {
            Snackbar.Add(update.ErrorMessage ?? "Update failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer updated.", Severity.Success);
        await OnCustomerUpdated.InvokeAsync();
    }

    private async Task SuspendAsync()
    {
        if (Customer is null)
            return;

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Suspend Customer", new DialogParameters
        {
            ["Title"] = "Suspend Customer",
            ["Message"] = $"Suspend {Customer.Name}? All licenses will be denied immediately.",
            ["ConfirmText"] = "Suspend",
            ["IsDestructive"] = true
        }, PlatformDialogOptions.Confirm);
        var result = await dialog.Result;
        if (result?.Canceled is not false)
            return;

        var apiResult = await Api.SuspendCustomerAsync(Customer.Id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Suspend failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer suspended.", Severity.Success);
        await OnCustomerUpdated.InvokeAsync();
    }

    private async Task ReactivateAsync()
    {
        if (Customer is null)
            return;

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Reactivate Customer", new DialogParameters
        {
            ["Title"] = "Reactivate Customer",
            ["Message"] = $"Reactivate {Customer.Name}? Deny-lists will be cleared.",
            ["ConfirmText"] = "Reactivate"
        }, PlatformDialogOptions.Confirm);
        var result = await dialog.Result;
        if (result?.Canceled is not false)
            return;

        var apiResult = await Api.ReactivateCustomerAsync(Customer.Id);
        if (!apiResult.IsSuccess)
        {
            Snackbar.Add(apiResult.ErrorMessage ?? "Reactivate failed.", Severity.Error);
            return;
        }

        Snackbar.Add("Customer reactivated.", Severity.Success);
        await OnCustomerUpdated.InvokeAsync();
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return "?";
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    private static string FormatShortId(string id) =>
        id.Replace("-", "", StringComparison.Ordinal)[..Math.Min(8, id.Length)].ToUpperInvariant();
}
