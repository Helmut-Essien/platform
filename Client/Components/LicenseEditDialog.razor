<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit License</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_model.PlanName"
                          For="@(() => _model.PlanName)"
                          Label="Plan"
                          Required="true"
                          RequiredError="Plan is required"
                          Variant="Variant.Outlined"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_model.ExpiresAt"
                           For="@(() => _model.ExpiresAt)"
                           Label="Expires"
                           Variant="Variant.Outlined" />
            <LicenseBillingFields Billing="_billing" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public required LicenseDto License { get; set; }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<UpdateLicenseRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private UpdateLicenseRequest _model = new() { PlanName = "" };
    private LicenseBillingDto _billing = new();

    protected override void OnInitialized()
    {
        _model = new UpdateLicenseRequest
        {
            PlanName = License.PlanName,
            ExpiresAt = License.ExpiresAt
        };
        _billing = LicenseBillingFields.Copy(License.Billing);
        _model.Billing = _billing;
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(UpdateLicenseRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
