<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Issue License</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_model.CustomerId"
                       For="@(() => _model.CustomerId)"
                       Label="Customer"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var c in Customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_model.ServiceProductId"
                       For="@(() => _model.ServiceProductId)"
                       Label="Service"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var p in Products)
                {
                    <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.PlanName"
                          For="@(() => _model.PlanName)"
                          Label="Plan name"
                          Variant="Variant.Outlined"
                          MaxLength="100"
                          Counter="100"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_model.ExpiresAt"
                           For="@(() => _model.ExpiresAt)"
                           Label="Expires (optional)"
                           Variant="Variant.Outlined"
                           Class="mb-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!_formValid)">
            Issue (Pending)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<CustomerDto> Customers { get; set; } = [];
    [Parameter] public List<ServiceProductDto> Products { get; set; } = [];
    [Parameter] public string? DefaultCustomerId { get; set; }

    private MudForm? _form;
    private bool _formValid;
    private CreateLicenseRequest _model = new() { CustomerId = "", ServiceProductId = "", PlanName = "Pro" };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(DefaultCustomerId))
            _model.CustomerId = DefaultCustomerId;
        else if (Customers.Count > 0)
            _model.CustomerId = Customers[0].Id;

        if (Products.Count > 0)
            _model.ServiceProductId = Products[0].Id;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }
}
