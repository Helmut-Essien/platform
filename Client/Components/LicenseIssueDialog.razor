<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Issue License</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_model.CustomerId"
                       For="@(() => _model.CustomerId)"
                       Label="Customer"
                       Required="true"
                       RequiredError="Customer is required"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var c in Customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_model.ServiceProductId"
                       For="@(() => _model.ServiceProductId)"
                       Label="Service"
                       Required="true"
                       RequiredError="Service is required"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var p in Products)
                {
                    <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.PlanName"
                          For="@(() => _model.PlanName)"
                          Label="Plan name"
                          Required="true"
                          RequiredError="Plan name is required"
                          Variant="Variant.Outlined"
                          MaxLength="100"
                          Counter="100"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_model.ExpiresAt"
                           For="@(() => _model.ExpiresAt)"
                           Label="Expires (optional)"
                           Variant="Variant.Outlined"
                           Class="mb-2" />
            <LicenseBillingFields Billing="_model.Billing!" Changed="OnBillingChanged" />
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">First invoice</MudText>
            <MudCheckBox T="bool" Value="_model.CreateInvoice" ValueChanged="OnCreateInvoiceChanged"
                         Label="Create invoice now"
                         Color="Color.Primary"
                         Class="mb-1" />
            @if (_model.CreateInvoice)
            {
                <MudCheckBox @bind-Value="_model.SendInvoice"
                             Label="Send invoice immediately"
                             Color="Color.Primary"
                             Class="mb-2" />
                @if (HasPrice)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        Bills @PriceSummary. The license activates automatically (and the key is emailed) once this invoice is paid in full.
                    </MudAlert>
                }
                else
                {
                    <MudNumericField @bind-Value="_model.InvoiceSubtotal"
                                     Label="Invoice subtotal"
                                     Variant="Variant.Outlined"
                                     Min="0m"
                                     Class="mb-2" />
                    <MudNumericField @bind-Value="_model.InvoiceTaxAmount"
                                     Label="Invoice tax"
                                     Variant="Variant.Outlined"
                                     Min="0m"
                                     Class="mb-2" />
                    <CurrencyField @bind-Value="_model.InvoiceCurrency" />
                    <MudText Typo="Typo.caption" Class="d-block mb-2">
                        With an amount above zero, paying this invoice in full activates the license automatically.
                    </MudText>
                }
                <MudDatePicker @bind-Date="_model.InvoiceDueDate"
                               Label="Invoice due date"
                               Variant="Variant.Outlined"
                               Class="mb-2" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Issue (Pending)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<CustomerDto> Customers { get; set; } = [];
    [Parameter] public List<ServiceProductDto> Products { get; set; } = [];
    [Parameter] public string? DefaultCustomerId { get; set; }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<CreateLicenseRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private CreateLicenseRequest _model = new()
    {
        CustomerId = "", ServiceProductId = "", PlanName = "Pro", Billing = LicenseBillingFields.Copy(null),
        CreateInvoice = false, SendInvoice = true, InvoiceCurrency = BillingDefaults.Currency,
        InvoiceDueDate = DateTime.UtcNow.Date.AddDays(14)
    };

    // Until the admin ticks/unticks it, "Create invoice now" follows whether a price is set.
    private bool _createInvoiceTouched;

    private bool HasPrice => _model.Billing?.Amount is > 0;

    private string PriceSummary
    {
        get
        {
            var b = _model.Billing!;
            var period = b.PeriodMonths switch { 1 => "1 month", 12 => "1 year", _ => $"{b.PeriodMonths} months" };
            var tax = b.TaxAmount > 0 ? $" + {b.TaxAmount:N2} tax" : "";
            return $"{b.Currency} {b.Amount:N2}{tax} for the first {period}";
        }
    }

    private void OnBillingChanged()
    {
        if (!_createInvoiceTouched)
            _model.CreateInvoice = HasPrice;
        StateHasChanged();
    }

    private void OnCreateInvoiceChanged(bool value)
    {
        _createInvoiceTouched = true;
        _model.CreateInvoice = value;
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(DefaultCustomerId))
            _model.CustomerId = DefaultCustomerId;
        else if (Customers.Count > 0)
            _model.CustomerId = Customers[0].Id;

        if (Products.Count > 0)
            _model.ServiceProductId = Products[0].Id;
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        if (_model.CreateInvoice && HasPrice)
        {
            // Zero amounts tell the server to bill the license price for its first period.
            _model.InvoiceSubtotal = 0;
            _model.InvoiceTaxAmount = 0;
        }

        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(CreateLicenseRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
