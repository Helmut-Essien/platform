<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Issue License</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_model.CustomerId"
                       For="@(() => _model.CustomerId)"
                       Label="Customer"
                       Required="true"
                       RequiredError="Customer is required"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var c in Customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_model.ServiceProductId"
                       @bind-Value:after="OnProductChanged"
                       For="@(() => _model.ServiceProductId)"
                       Label="Service"
                       Required="true"
                       RequiredError="Service is required"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var p in Products)
                {
                    <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
            @if (PlanCatalogActive)
            {
                @if (ActivePlans.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                        @SelectedProduct!.Code has no active plans. Add or activate one on the Services page first.
                    </MudAlert>
                }
                <MudSelect T="string" @bind-Value="_model.PlanName"
                           @bind-Value:after="OnPlanChanged"
                           For="@(() => _model.PlanName)"
                           Label="Plan"
                           Required="true"
                           RequiredError="Plan is required"
                           HelperText="@PlanPriceHelper"
                           Disabled="@(ActivePlans.Count == 0)"
                           Variant="Variant.Outlined"
                           Class="mb-2">
                    @foreach (var plan in ActivePlans)
                    {
                        <MudSelectItem Value="@plan.Code">@plan.DisplayName (@plan.Code)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="_model.PlanName"
                              For="@(() => _model.PlanName)"
                              Label="Plan name"
                              Required="true"
                              RequiredError="Plan name is required"
                              Variant="Variant.Outlined"
                              MaxLength="100"
                              Counter="100"
                              HelperText="This service has no plan list yet, so any name is accepted. Add plans on the Services page."
                              Class="mb-2" />
            }
            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">License type</MudText>
            <MudRadioGroup T="IssueKind" Value="_kind" ValueChanged="OnKindChanged" Class="mb-2">
                <MudRadio T="IssueKind" Value="IssueKind.Paid" Color="Color.Primary" Dense="true">Paid</MudRadio>
                <MudRadio T="IssueKind" Value="IssueKind.Trial" Color="Color.Primary" Dense="true">Free trial</MudRadio>
                <MudRadio T="IssueKind" Value="IssueKind.Complimentary" Color="Color.Primary" Dense="true">Complimentary (free)</MudRadio>
            </MudRadioGroup>
            @if (_kind == IssueKind.Trial)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Starts now and the key is emailed. The trial ends after @TrialLengthLabel.
                    @(HasPrice
                        ? $"{TrialReminderLabel} before it ends, the customer gets a reminder with the first invoice ({PriceSummaryShort}) and a pay link. Paying converts it to a paid license; their paid period starts when the trial ends."
                        : $"{TrialReminderLabel} before it ends, the customer gets a reminder email. Set a price to have the first invoice sent with it.")
                    One trial per customer and service.
                </MudAlert>
            }
            else if (_kind == IssueKind.Complimentary)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Free until you change it: starts now, the key is emailed, and it's never invoiced or suspended for non-payment.
                    Leave the expiry empty for no end date. Use "Switch to paid" on the license later to start billing.
                </MudAlert>
            }
            @if (_kind != IssueKind.Trial)
            {
                <MudDatePicker @bind-Date="_model.ExpiresAt"
                               For="@(() => _model.ExpiresAt)"
                               Label="Expires (optional)"
                               Variant="Variant.Outlined"
                               Class="mb-2" />
            }
            @if (_kind != IssueKind.Complimentary)
            {
                <MudNumericField T="int?" @bind-Value="_model.MaxDevices"
                                 Label="Max devices"
                                 HelperText="@MaxDevicesHelper"
                                 Min="0" Max="1000"
                                 Variant="Variant.Outlined"
                                 Class="mb-2" />
                <LicenseBillingFields Billing="_model.Billing!" Changed="OnBillingChanged" />
            }
            @if (_kind == IssueKind.Paid)
            {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">First invoice</MudText>
            <MudCheckBox T="bool" Value="_model.CreateInvoice" ValueChanged="OnCreateInvoiceChanged"
                         Label="Create invoice now"
                         Color="Color.Primary"
                         Class="mb-1" />
            @if (_model.CreateInvoice)
            {
                <MudCheckBox @bind-Value="_model.SendInvoice"
                             Label="Send invoice immediately"
                             Color="Color.Primary"
                             Class="mb-2" />
                @if (HasPrice)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        Bills @PriceSummary. The license activates automatically (and the key is emailed) once this invoice is paid in full.
                    </MudAlert>
                }
                else
                {
                    <MudNumericField @bind-Value="_model.InvoiceSubtotal"
                                     Label="Invoice subtotal"
                                     Variant="Variant.Outlined"
                                     Min="0m"
                                     Class="mb-2" />
                    <MudNumericField @bind-Value="_model.InvoiceTaxAmount"
                                     Label="Invoice tax"
                                     Variant="Variant.Outlined"
                                     Min="0m"
                                     Class="mb-2" />
                    <CurrencyField @bind-Value="_model.InvoiceCurrency" />
                    <MudText Typo="Typo.caption" Class="d-block mb-2">
                        With an amount above zero, paying this invoice in full activates the license automatically.
                    </MudText>
                }
                <MudDatePicker @bind-Date="_model.InvoiceDueDate"
                               Label="Invoice due date"
                               Variant="Variant.Outlined"
                               Class="mb-2" />
            }
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @(_kind switch { IssueKind.Trial => "Start trial", IssueKind.Complimentary => "Issue free license", _ => "Issue (Pending)" })
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<CustomerDto> Customers { get; set; } = [];
    [Parameter] public List<ServiceProductDto> Products { get; set; } = [];
    [Parameter] public string? DefaultCustomerId { get; set; }

    /// <summary>Trial length and reminder lead time, as configured on the server (display only).</summary>
    [Parameter] public int TrialMonths { get; set; } = 1;
    [Parameter] public int TrialReminderDays { get; set; } = 7;

    private enum IssueKind { Paid, Trial, Complimentary }

    private IssueKind _kind = IssueKind.Paid;

    private string TrialLengthLabel => TrialMonths == 1 ? "1 month" : $"{TrialMonths} months";

    private string TrialReminderLabel => TrialReminderDays == 1 ? "1 day" : $"{TrialReminderDays} days";

    private string PriceSummaryShort
    {
        get
        {
            var b = _model.Billing!;
            var period = b.PeriodMonths switch { 1 => "month", 12 => "year", _ => $"{b.PeriodMonths} months" };
            return $"{b.Currency} {b.Amount + b.TaxAmount:N2} per {period}";
        }
    }

    private void OnKindChanged(IssueKind kind)
    {
        var wasComplimentary = _kind == IssueKind.Complimentary;
        _kind = kind;
        // Coming back from complimentary (where the price was hidden): fill the plan's price if none is typed.
        if (wasComplimentary && kind != IssueKind.Complimentary && _model.Billing?.Amount is not > 0)
            ApplyPlanPrice();
        _model.Trial = kind == IssueKind.Trial;
        _model.Complimentary = kind == IssueKind.Complimentary;
        if (kind != IssueKind.Paid)
        {
            _model.CreateInvoice = false;
            if (kind == IssueKind.Trial)
                _model.ExpiresAt = null;
        }
        else if (!_createInvoiceTouched)
        {
            _model.CreateInvoice = HasPrice;
        }
    }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<CreateLicenseRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private CreateLicenseRequest _model = new()
    {
        CustomerId = "", ServiceProductId = "", PlanName = "", Billing = LicenseBillingFields.Copy(null),
        CreateInvoice = false, SendInvoice = true, InvoiceCurrency = BillingDefaults.Currency,
        InvoiceDueDate = DateTime.UtcNow.Date.AddDays(14)
    };

    // Until the admin ticks/unticks it, "Create invoice now" follows whether a price is set.
    private bool _createInvoiceTouched;

    private ServiceProductDto? SelectedProduct => Products.FirstOrDefault(p => p.Id == _model.ServiceProductId);

    /// <summary>True once the chosen service defines at least one plan: then only its active plans can be picked.</summary>
    private bool PlanCatalogActive => SelectedProduct is { Plans.Count: > 0 };

    private List<ProductPlanDto> ActivePlans =>
        SelectedProduct?.Plans.Where(p => p.IsActive).OrderBy(p => p.SortOrder).ThenBy(p => p.Code).ToList() ?? [];

    private string MaxDevicesHelper => SelectedProduct?.DefaultMaxDevices switch
    {
        null => "Leave empty for the default; 0 = unlimited",
        0 => "Leave empty for this service's default (unlimited); 0 = unlimited",
        1 => "Leave empty for this service's default (1 device); 0 = unlimited",
        var n => $"Leave empty for this service's default ({n} devices); 0 = unlimited"
    };

    private void OnProductChanged()
    {
        // A plan belongs to one service: never carry the previous service's plan (or its untouched price) over.
        _model.PlanName = "";
        ApplyPlanPrice();
    }

    private ProductPlanDto? SelectedPlan => ActivePlans.FirstOrDefault(p => p.Code == _model.PlanName);

    private string? PlanPriceHelper => SelectedPlan?.DefaultPrice is { } price
        ? $"Default price {PriceText.Format(price)}" + (_kind == IssueKind.Complimentary ? " (not used: complimentary is free)" : ", filled in below; you can change it")
        : null;

    /// <summary>
    /// Picking a plan fills the price fields from its default price (the admin can still change them). Not for
    /// complimentary licenses, which have no price; a trial gets it as the price after the trial, as if typed.
    /// </summary>
    private void OnPlanChanged()
    {
        if (_kind != IssueKind.Complimentary)
            ApplyPlanPrice();
    }

    // The price last filled in from a plan; while the fields still hold it, picking another plan may replace or clear it.
    private LicenseBillingDto? _prefill;

    private bool StillPrefilled => _prefill is { } p && _model.Billing is { } b && p.Amount == b.Amount && p.TaxAmount == b.TaxAmount
        && string.Equals(p.Currency, b.Currency, StringComparison.OrdinalIgnoreCase) && p.PeriodMonths == b.PeriodMonths;

    private void ApplyPlanPrice()
    {
        var b = _model.Billing!;
        if (SelectedPlan?.DefaultPrice is not { } price)
        {
            // A plan without a default price: don't leave the previous plan's price behind (unless it was edited).
            if (StillPrefilled)
            {
                var empty = LicenseBillingFields.Copy(null);
                b.Amount = empty.Amount;
                b.TaxAmount = empty.TaxAmount;
                b.Currency = empty.Currency;
                b.PeriodMonths = empty.PeriodMonths;
                OnBillingChanged();
            }
            _prefill = null;
            return;
        }
        b.Amount = price.Amount;
        b.TaxAmount = price.TaxAmount;
        b.Currency = price.Currency ?? BillingDefaults.Currency;
        b.PeriodMonths = price.PeriodMonths;
        _prefill = LicenseBillingFields.Copy(b);
        OnBillingChanged();
    }

    private bool HasPrice => _model.Billing?.Amount is > 0;

    private string PriceSummary
    {
        get
        {
            var b = _model.Billing!;
            var period = b.PeriodMonths switch { 1 => "1 month", 12 => "1 year", _ => $"{b.PeriodMonths} months" };
            var tax = b.TaxAmount > 0 ? $" + {b.TaxAmount:N2} tax" : "";
            return $"{b.Currency} {b.Amount:N2}{tax} for the first {period}";
        }
    }

    private void OnBillingChanged()
    {
        if (!_createInvoiceTouched && _kind == IssueKind.Paid)
            _model.CreateInvoice = HasPrice;
        StateHasChanged();
    }

    private void OnCreateInvoiceChanged(bool value)
    {
        _createInvoiceTouched = true;
        _model.CreateInvoice = value;
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(DefaultCustomerId))
            _model.CustomerId = DefaultCustomerId;
        else if (Customers.Count > 0)
            _model.CustomerId = Customers[0].Id;

        if (Products.Count > 0)
            _model.ServiceProductId = Products[0].Id;
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        if (_kind != IssueKind.Paid)
            _model.CreateInvoice = false;

        if (_model.CreateInvoice && HasPrice)
        {
            // Zero amounts tell the server to bill the license price for its first period.
            _model.InvoiceSubtotal = 0;
            _model.InvoiceTaxAmount = 0;
        }

        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(CreateLicenseRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
