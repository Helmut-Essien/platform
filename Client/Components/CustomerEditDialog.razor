<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Customer</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_model.Name"
                          For="@(() => _model.Name)"
                          Label="Name"
                          Variant="Variant.Outlined"
                          MaxLength="200"
                          Counter="200"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.ContactEmail"
                          For="@(() => _model.ContactEmail)"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.TechnicalEmail"
                          For="@(() => _model.TechnicalEmail)"
                          Label="Technical email (optional)"
                          HelperText="Receives license keys and lifecycle notices."
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.BillingEmail"
                          For="@(() => _model.BillingEmail)"
                          Label="Billing email (optional)"
                          HelperText="Receives invoices and receipts."
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.ContactPhone"
                          For="@(() => _model.ContactPhone)"
                          Label="Phone (optional)"
                          Variant="Variant.Outlined"
                          MaxLength="50"
                          Counter="50"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.InternalNotes"
                          For="@(() => _model.InternalNotes)"
                          Label="Internal notes (optional)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLength="4000"
                          Counter="4000" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!_formValid)">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public required CustomerDto Customer { get; set; }

    private MudForm? _form;
    private bool _formValid;
    private UpdateCustomerRequest _model = new() { Name = "", ContactEmail = "" };

    protected override void OnInitialized()
    {
        _model = new UpdateCustomerRequest
        {
            Name = Customer.Name,
            ContactEmail = Customer.ContactEmail,
            TechnicalEmail = Customer.TechnicalEmail,
            BillingEmail = Customer.BillingEmail,
            ContactPhone = Customer.ContactPhone,
            InternalNotes = Customer.InternalNotes
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }
}
