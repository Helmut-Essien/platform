@using Platform.Shared.Enums

<MudChip T="string" Size="Size.Small" Variant="@GetVariant()" Color="Color.Primary">@Status</MudChip>

@code {
    [Parameter] public LicenseStatus Status { get; set; }

    private Variant GetVariant() => Status switch
    {
        LicenseStatus.Active => Variant.Filled,
        LicenseStatus.Pending => Variant.Outlined,
        LicenseStatus.Suspended => Variant.Outlined,
        LicenseStatus.Revoked => Variant.Text,
        LicenseStatus.Expired => Variant.Text,
        _ => Variant.Text
    };
}
