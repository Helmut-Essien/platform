@using Platform.Shared.Enums

<MudChip T="string" Size="Size.Small" Color="@GetColor()" Class="@GetClass()">@Status</MudChip>

@code {
    [Parameter] public LicenseStatus Status { get; set; }

    private Color GetColor() => Status switch
    {
        LicenseStatus.Active => Color.Success,
        LicenseStatus.Pending => Color.Warning,
        LicenseStatus.Suspended => Color.Default,
        LicenseStatus.Revoked => Color.Error,
        LicenseStatus.Expired => Color.Default,
        _ => Color.Default
    };

    private string GetClass() => Status == LicenseStatus.Suspended ? "chip-suspended" : "";
}
