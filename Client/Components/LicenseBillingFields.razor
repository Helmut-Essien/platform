@* Recurring price used for automatic renewal invoices (edited in place on the passed DTO). *@
<MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Recurring billing</MudText>
<MudText Typo="Typo.caption" Class="d-block mb-2">
    With a price set, a renewal invoice (with a pay-online link) is emailed before the license expires,
    and paying it extends the license by one period. Leave the price empty for no automatic invoices.
</MudText>
<MudGrid Spacing="2">
    <MudItem xs="6" sm="4">
        <MudNumericField T="decimal?" @bind-Value="Billing.Amount" @bind-Value:after="NotifyAsync" Label="Price per period" Min="0" Format="N2"
                         Variant="Variant.Outlined" Clearable="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="decimal" @bind-Value="Billing.TaxAmount" @bind-Value:after="NotifyAsync" Label="Tax" Min="0" Format="N2" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="6" sm="2">
        <MudTextField T="string" Value="Billing.Currency" ValueChanged="@(async v => { Billing.Currency = v?.Trim().ToUpperInvariant(); await NotifyAsync(); })"
                      Label="Currency" MaxLength="3" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudSelect T="int" @bind-Value="Billing.PeriodMonths" @bind-Value:after="NotifyAsync" Label="Period" Variant="Variant.Outlined">
            <MudSelectItem Value="1">Monthly</MudSelectItem>
            <MudSelectItem Value="3">Quarterly</MudSelectItem>
            <MudSelectItem Value="6">6 months</MudSelectItem>
            <MudSelectItem Value="12">Yearly</MudSelectItem>
            <MudSelectItem Value="24">2 years</MudSelectItem>
            <MudSelectItem Value="36">3 years</MudSelectItem>
        </MudSelect>
    </MudItem>
</MudGrid>
@if (Billing.Amount is > 0 && BillingDefaults.LacksPayLink(Billing.Currency))
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@BillingDefaults.NonPayLinkWarning</MudAlert>
}
<MudCheckBox @bind-Value="Billing.AutoRenewInvoice" Label="Send renewal invoices automatically" Color="Color.Primary"
             Disabled="@(Billing.Amount is not > 0)" />

@code {
    [Parameter, EditorRequired] public required LicenseBillingDto Billing { get; set; }

    /// <summary>Raised after any field changes, so a parent can react (e.g. the first invoice follows the price).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private Task NotifyAsync() => Changed.InvokeAsync();

    public static LicenseBillingDto Copy(LicenseBillingDto? source, string defaultCurrency = BillingDefaults.Currency) => new()
    {
        Amount = source?.Amount,
        TaxAmount = source?.TaxAmount ?? 0m,
        Currency = source?.Currency ?? defaultCurrency,
        PeriodMonths = source?.PeriodMonths is >= 1 and <= 36 ? source.PeriodMonths : 12,
        AutoRenewInvoice = source?.AutoRenewInvoice ?? true
    };
}
