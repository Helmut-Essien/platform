<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Customer</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_model.Name"
                          For="@(() => _model.Name)"
                          Label="Name"
                          Required="true"
                          RequiredError="Name is required"
                          Variant="Variant.Outlined"
                          MaxLength="200"
                          Counter="200"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.ContactEmail"
                          For="@(() => _model.ContactEmail)"
                          Label="Contact email"
                          Required="true"
                          RequiredError="Contact email is required"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.TechnicalEmail"
                          For="@(() => _model.TechnicalEmail)"
                          Label="Technical email (optional)"
                          HelperText="Receives license keys and lifecycle notices; falls back to contact email."
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.BillingEmail"
                          For="@(() => _model.BillingEmail)"
                          Label="Billing email (optional)"
                          HelperText="Receives invoices and receipts; falls back to contact email."
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.ContactPhone"
                          For="@(() => _model.ContactPhone)"
                          Label="Contact phone (optional)"
                          Variant="Variant.Outlined"
                          MaxLength="50"
                          Counter="50"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.InternalNotes"
                          For="@(() => _model.InternalNotes)"
                          Label="Internal notes (optional)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLength="4000"
                          Counter="4000" />
            <MudCheckBox @bind-Value="_model.SendWelcomeEmail"
                         Label="Send welcome email"
                         Color="Color.Primary"
                         Class="mt-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<CreateCustomerRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private CreateCustomerRequest _model = new() { Name = "", ContactEmail = "" };

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(CreateCustomerRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
