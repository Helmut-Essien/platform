<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Rotate &amp; Email License Key</MudText>
    </TitleContent>
    <DialogContent>
        @if (_busy)
        {
            <div class="license-action-busy">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                <MudText Typo="Typo.body2" Class="mt-3">Generating a new key and queuing delivery…</MudText>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                The current key will stop working immediately.
            </MudAlert>
            <MudText>
                A new key for <strong>@CustomerLabel</strong> will be encrypted in the delivery queue and
                emailed to the technical contact.
            </MudText>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" Variant="Variant.Outlined">@_error</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmAsync" Disabled="_busy">
            @(_busy ? "Queuing…" : "Rotate & Email")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }
    [Parameter] public required string LicenseId { get; set; }
    [Parameter] public string CustomerLabel { get; set; } = "this license";
    [Inject] private PlatformApiClient Api { get; set; } = default!;

    private bool _busy;
    private string? _error;

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task ConfirmAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.RotateLicenseKeyAsync(LicenseId);
            if (!result.IsSuccess || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Failed to rotate the key.";
                return;
            }
            MudDialog.Close(DialogResult.Ok(result.Data));
        }
        catch (Exception ex)
        {
            _error = $"Failed to rotate the key: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
