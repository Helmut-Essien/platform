<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Invoice</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_model.CustomerId"
                       For="@(() => _model.CustomerId)"
                       Label="Customer"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var c in Customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.Currency"
                          For="@(() => _model.Currency)"
                          Label="Currency"
                          Variant="Variant.Outlined"
                          Class="mb-2" />
            <MudNumericField @bind-Value="_model.Subtotal"
                             For="@(() => _model.Subtotal)"
                             Label="Subtotal"
                             Variant="Variant.Outlined"
                             Min="0m"
                             Class="mb-2" />
            <MudNumericField @bind-Value="_model.TaxAmount"
                             For="@(() => _model.TaxAmount)"
                             Label="Tax"
                             Variant="Variant.Outlined"
                             Min="0m"
                             Class="mb-2" />
            <MudDatePicker @bind-Date="_model.DueDate"
                           For="@(() => _model.DueDate)"
                           Label="Due date"
                           Variant="Variant.Outlined"
                           Class="mb-2" />
            <MudTextField @bind-Value="_model.PlanName"
                          For="@(() => _model.PlanName)"
                          Label="Plan (optional)"
                          Variant="Variant.Outlined"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description (optional)"
                          Variant="Variant.Outlined"
                          Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!_formValid)">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<CustomerDto> Customers { get; set; } = [];

    private MudForm? _form;
    private bool _formValid;
    private CreateInvoiceRequest _model = new()
    {
        CustomerId = "",
        Currency = "USD",
        DueDate = DateTime.UtcNow.AddDays(30)
    };

    protected override void OnInitialized()
    {
        _model.CustomerId = Customers.FirstOrDefault()?.Id ?? "";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _model.Status = InvoiceStatus.Sent;
        MudDialog.Close(DialogResult.Ok(_model));
    }
}
