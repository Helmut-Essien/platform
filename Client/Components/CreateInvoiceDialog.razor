<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Invoice</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_model.CustomerId"
                       For="@(() => _model.CustomerId)"
                       Label="Customer"
                       Required="true"
                       RequiredError="Customer is required"
                       Variant="Variant.Outlined"
                       Class="mb-2">
                @foreach (var c in Customers)
                {
                    <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.Currency"
                          For="@(() => _model.Currency)"
                          Label="Currency"
                          Required="true"
                          RequiredError="Currency is required"
                          Variant="Variant.Outlined"
                          Class="mb-2" />
            <MudNumericField @bind-Value="_model.Subtotal"
                             For="@(() => _model.Subtotal)"
                             Label="Subtotal"
                             Variant="Variant.Outlined"
                             Min="0m"
                             Class="mb-2" />
            <MudNumericField @bind-Value="_model.TaxAmount"
                             For="@(() => _model.TaxAmount)"
                             Label="Tax"
                             Variant="Variant.Outlined"
                             Min="0m"
                             Class="mb-2" />
            <MudDatePicker @bind-Date="_model.DueDate"
                           For="@(() => _model.DueDate)"
                           Label="Due date"
                           Variant="Variant.Outlined"
                           Class="mb-2" />
            <MudTextField @bind-Value="_model.PlanName"
                          For="@(() => _model.PlanName)"
                          Label="Plan (optional)"
                          Variant="Variant.Outlined"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description (optional)"
                          Variant="Variant.Outlined"
                          Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   OnClick="@(() => SaveAsync(false))" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Save Draft
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => SaveAsync(true))" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Create &amp; Send
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<CustomerDto> Customers { get; set; } = [];

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<CreateInvoiceRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private CreateInvoiceRequest _model = new()
    {
        CustomerId = "",
        Currency = "USD",
        DueDate = DateTime.UtcNow.AddDays(30)
    };

    protected override void OnInitialized()
    {
        _model.CustomerId = Customers.FirstOrDefault()?.Id ?? "";
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync(bool sendImmediately)
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _model.SendImmediately = sendImmediately;
        _model.Status = sendImmediately ? InvoiceStatus.Sent : InvoiceStatus.Draft;
        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(CreateInvoiceRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
