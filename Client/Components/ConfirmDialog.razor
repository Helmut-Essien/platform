@inject IDialogService DialogService

<MudDialog DefaultFocus="DefaultFocus.FirstChild" Class="@(IsDestructive ? "confirm-dialog-destructive" : null)">
    <TitleContent>
        <div class="confirm-dialog-title">
            @if (IsDestructive)
            {
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Class="confirm-dialog-warning-icon" />
            }
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText>@Message</MudText>
        @if (ShowReason)
        {
            <MudTextField @bind-Value="_reason"
                          Label="@ReasonLabel"
                          HelperText="Optional. Included in the email to the customer."
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="500"
                          Class="mt-4" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Class="confirm-dialog-cancel" OnClick="Cancel">Cancel</MudButton>
        @if (IsDestructive)
        {
            <MudButton Variant="Variant.Filled" Class="confirm-dialog-confirm-destructive" OnClick="Confirm">@ConfirmText</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">@ConfirmText</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public bool IsDestructive { get; set; }
    [Parameter] public bool ShowReason { get; set; }
    [Parameter] public string ReasonLabel { get; set; } = "Reason";

    private string? _reason;

    private void Cancel() => MudDialog.Cancel();
    // With a reason field the result data is the (possibly empty) reason text; otherwise true as before.
    private void Confirm() => MudDialog.Close(ShowReason ? DialogResult.Ok(_reason?.Trim() ?? string.Empty) : DialogResult.Ok(true));
}
