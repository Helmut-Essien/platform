<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Renew License</MudText>
    </TitleContent>
    <DialogContent>
        @if (_busy)
        {
            <div class="license-action-busy">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                <MudText Typo="Typo.body2" Class="mt-3">Renewing license and queuing selected deliveries…</MudText>
            </div>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mb-4">
                The current key remains valid unless you explicitly rotate it.
            </MudText>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">@_error</MudAlert>
            }
            <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
                <MudDatePicker @bind-Date="_model.ExpiresAt"
                               For="@(() => _model.ExpiresAt)"
                               Label="New expiry date"
                               Variant="Variant.Outlined"
                               Class="mb-2" />
                <MudCheckBox @bind-Value="_model.RotateLicenseKey"
                             Label="Rotate key (invalidates the current key)"
                             Color="Color.Primary"
                             Class="mb-2" />
                <MudCheckBox @bind-Value="_model.EmailLicenseKey"
                             Label="@(_model.RotateLicenseKey ? "Email new key to technical contact" : "Email renewal confirmation")"
                             Color="Color.Primary"
                             Class="mb-2" />
                <MudCheckBox @bind-Value="_model.CreateInvoice"
                             Label="Create renewal invoice"
                             Color="Color.Primary"
                             Class="mb-2" />
                @if (_model.CreateInvoice)
                {
                    <MudCheckBox @bind-Value="_model.SendInvoice"
                                 Label="Send invoice immediately"
                                 Color="Color.Primary"
                                 Class="mb-3" />
                <MudNumericField @bind-Value="_model.Subtotal"
                                 For="@(() => _model.Subtotal)"
                                 Label="Subtotal"
                                 Variant="Variant.Outlined"
                                 Min="0m"
                                 Class="mb-2" />
                <MudNumericField @bind-Value="_model.TaxAmount"
                                 For="@(() => _model.TaxAmount)"
                                 Label="Tax"
                                 Variant="Variant.Outlined"
                                 Min="0m"
                                 Class="mb-2" />
                <MudTextField @bind-Value="_model.Currency"
                              For="@(() => _model.Currency)"
                              Label="Currency"
                              Variant="Variant.Outlined"
                              Class="mb-2" />
                <MudDatePicker @bind-Date="_model.DueDate"
                               For="@(() => _model.DueDate)"
                               Label="Invoice due date"
                               Variant="Variant.Outlined"
                               Class="mb-2" />
                <MudTextField @bind-Value="_model.Description"
                              For="@(() => _model.Description)"
                              Label="Description (optional)"
                              Variant="Variant.Outlined"
                              Lines="2" />
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Sending…</span>
            }
            else
            {
                <span>Renew</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public required string LicenseId { get; set; }

    [Parameter] public DateTime? CurrentExpiresAt { get; set; }

    [Inject] private PlatformApiClient Api { get; set; } = default!;

    private MudForm? _form;
    private bool _formValid;
    private bool _busy;
    private string? _error;
    private RenewLicenseRequest _model = new()
    {
        Subtotal = 99m,
        Currency = "USD",
        DueDate = DateTime.UtcNow.AddDays(30)
    };

    protected override void OnInitialized()
    {
        _model.ExpiresAt = CurrentExpiresAt?.AddYears(1) ?? DateTime.UtcNow.AddYears(1);
    }

    private void Cancel()
    {
        if (_busy)
            return;

        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy || _form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _busy = true;
        _error = null;
        StateHasChanged();

        try
        {
            var apiResult = await Api.RenewLicenseAsync(LicenseId, _model);
            if (!apiResult.IsSuccess || apiResult.Data is null)
            {
                _error = apiResult.ErrorMessage ?? "Renewal failed. The license key email was not sent.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(apiResult.Data));
        }
        catch (Exception ex)
        {
            _error = $"Renewal failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
