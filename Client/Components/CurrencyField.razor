@* Currency code input (defaults to GHS) with a warning when online pay links won't be available. *@
<MudTextField T="string" Value="Value" ValueChanged="OnChanged" Immediate="true"
              Label="@Label" Variant="Variant.Outlined" MaxLength="3" Class="@Class"
              HelperText="3-letter code, e.g. GHS" />
@if (BillingDefaults.LacksPayLink(Value))
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@BillingDefaults.NonPayLinkWarning</MudAlert>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Currency";
    [Parameter] public string Class { get; set; } = "mb-2";

    private Task OnChanged(string? value) => ValueChanged.InvokeAsync(value?.Trim().ToUpperInvariant());
}
