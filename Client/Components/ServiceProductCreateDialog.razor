<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Service</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            Integration keys cannot be recovered after generation. You'll be prompted to generate one after creating the service.
        </MudAlert>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_model.Name"
                          For="@(() => _model.Name)"
                          Label="Name"
                          Variant="Variant.Outlined"
                          MaxLength="200"
                          Counter="200"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.Code"
                          For="@(() => _model.Code)"
                          Label="Code"
                          Variant="Variant.Outlined"
                          HelperText="Uppercase identifier, e.g. HOSTEL"
                          MaxLength="50"
                          Counter="50"
                          Class="mb-2"
                          @bind-Value:after="OnCodeChanged" />
            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description (optional)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="2000"
                          Counter="2000"
                          Class="mb-2" />
            <MudSwitch @bind-Value="_model.IsAvailableForSale"
                       Label="Available for sale"
                       Color="Color.Primary" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(!_formValid)">
            Add Service
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    private MudForm? _form;
    private bool _formValid;
    private CreateServiceProductRequest _model = new() { Name = "", Code = "" };

    private void OnCodeChanged()
    {
        if (!string.IsNullOrEmpty(_model.Code))
            _model.Code = _model.Code.Trim().ToUpperInvariant();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        OnCodeChanged();

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        MudDialog.Close(DialogResult.Ok(_model));
    }
}
