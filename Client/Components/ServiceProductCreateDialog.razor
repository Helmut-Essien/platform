<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Service</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            Integration keys cannot be recovered after generation. You'll be prompted to generate one after creating the service.
        </MudAlert>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_model.Name"
                          For="@(() => _model.Name)"
                          Label="Name"
                          Required="true"
                          RequiredError="Name is required"
                          Variant="Variant.Outlined"
                          MaxLength="200"
                          Counter="200"
                          Class="mb-2" />
            <MudTextField @bind-Value="_model.Code"
                          For="@(() => _model.Code)"
                          Label="Code"
                          Required="true"
                          RequiredError="Code is required"
                          Variant="Variant.Outlined"
                          HelperText="Uppercase identifier, e.g. HOSTEL"
                          MaxLength="50"
                          Counter="50"
                          Class="mb-2"
                          @bind-Value:after="OnCodeChanged" />
            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Description (optional)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLength="2000"
                          Counter="2000"
                          Class="mb-2" />
            <MudSwitch @bind-Value="_model.IsAvailableForSale"
                       Label="Available for sale"
                       Color="Color.Primary" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Add Service
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<CreateServiceProductRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private CreateServiceProductRequest _model = new() { Name = "", Code = "" };

    private void OnCodeChanged()
    {
        if (!string.IsNullOrEmpty(_model.Code))
            _model.Code = _model.Code.Trim().ToUpperInvariant();
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        OnCodeChanged();

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(CreateServiceProductRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
