<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Activate License</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudNumericField @bind-Value="_model.Subtotal"
                             Label="Subtotal"
                             Variant="Variant.Outlined"
                             Min="0m"
                             Required="true"
                             Class="mb-2" />
            <MudNumericField @bind-Value="_model.TaxAmount"
                             Label="Tax"
                             Variant="Variant.Outlined"
                             Min="0m"
                             Class="mb-2" />
            <MudTextField @bind-Value="_model.Currency"
                          Label="Currency"
                          Variant="Variant.Outlined"
                          Required="true"
                          Class="mb-2" />
            <MudDatePicker @bind-Date="_dueDate"
                           Label="Invoice due date"
                           Variant="Variant.Outlined"
                           Class="mb-2" />
            <MudTextField @bind-Value="_model.Description"
                          Label="Description (optional)"
                          Variant="Variant.Outlined"
                          Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Activate</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    private MudForm? _form;
    private bool _formValid;
    private DateTime? _dueDate = DateTime.UtcNow.AddDays(30);
    private ActivateLicenseRequest _model = new() { Subtotal = 99m, Currency = "USD", Description = "Activation" };

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _model.DueDate = _dueDate;
        MudDialog.Close(DialogResult.Ok(_model));
    }
}
