@using Platform.Shared.Dtos.Billing

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reverse Payment</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudText Typo="Typo.body2" Class="mb-3">
            This permanently reverses receipt <strong>@ReceiptNumber</strong> for
            <strong>@Amount.ToString("N2")</strong>. The original receipt remains for audit.
        </MudText>
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudTextField @bind-Value="_model.Reason"
                          For="@(() => _model.Reason)"
                          Label="Reason"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Reason is required"
                          Lines="3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="SaveAsync" Disabled="@(_busy || !_formValid)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Reverse
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public string ReceiptNumber { get; set; } = "";

    [Parameter] public decimal Amount { get; set; }

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<ReverseReceiptRequest, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private readonly string _idempotencyKey = Guid.NewGuid().ToString("N");
    private ReverseReceiptRequest _model = new()
    {
        IdempotencyKey = "",
        Reason = ""
    };

    protected override void OnInitialized()
    {
        _model.IdempotencyKey = _idempotencyKey;
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid)
            return;

        _model.IdempotencyKey = _idempotencyKey;
        await SubmitAndCloseAsync(_model);
    }

    private async Task SubmitAndCloseAsync(ReverseReceiptRequest value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
