<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Generate Integration Key</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model" @bind-IsValid="_formValid">
            <MudSelect T="string" @bind-Value="_model.ServiceProductId"
                       For="@(() => _model.ServiceProductId)"
                       Label="Service"
                       Variant="Variant.Outlined">
                @foreach (var p in Products)
                {
                    <MudSelectItem Value="@p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
        @if (WillRotate)
        {
            @* Rotation confirmation lives inside the dialog so the save can happen in place. *@
            <MudAlert Severity="Severity.Warning" Class="mt-4" Dense="true">
                This service already has an active key. Generating a new one revokes it immediately, and any app using the old key will fail validation.
            </MudAlert>
            <MudCheckBox T="bool" @bind-Value="_rotateConfirmed" Disabled="_busy" Color="Color.Error"
                         Label="I understand the existing key will be revoked" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="GenerateAsync" Disabled="@(_busy || !_formValid || (WillRotate && !_rotateConfirmed))"
                   Color="@(WillRotate ? Color.Error : Color.Primary)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @(WillRotate ? "Revoke old key & generate" : "Generate")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<ServiceProductDto> Products { get; set; } = [];
    [Parameter] public string? DefaultProductId { get; set; }

    /// <summary>Services that already have an active key (generating one rotates it).</summary>
    [Parameter] public IReadOnlyCollection<string> ActiveKeyProductIds { get; set; } = [];

    private bool _rotateConfirmed;
    private bool WillRotate => ActiveKeyProductIds.Contains(_model.ServiceProductId);

    /// <summary>Saves inside the dialog; returns an error message to show, or null on success (dialog then closes).</summary>
    [Parameter] public Func<string, Task<string?>>? Submit { get; set; }

    private bool _busy;
    private string? _error;
    private MudForm? _form;
    private bool _formValid;
    private GenerateIntegrationKeyRequest _model = new();

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(DefaultProductId) && Products.Any(p => p.Id == DefaultProductId))
            _model.ServiceProductId = DefaultProductId;
        else if (Products.Count > 0)
            _model.ServiceProductId = Products[0].Id;
    }

    private void Cancel()
    {
        if (!_busy)
            MudDialog.Cancel();
    }

    private async Task GenerateAsync()
    {
        if (_busy)
            return;

        if (_form is null)
            return;

        await _form.Validate();
        if (!_formValid || (WillRotate && !_rotateConfirmed))
            return;

        await SubmitAndCloseAsync(_model.ServiceProductId);
    }

    private async Task SubmitAndCloseAsync(string value)
    {
        if (Submit is null)
        {
            MudDialog.Close(DialogResult.Ok(value));
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();
        try
        {
            var error = await Submit(value);
            if (error is not null)
            {
                _error = error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(value));
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
