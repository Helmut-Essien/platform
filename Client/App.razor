<CascadingAuthenticationState>
    <MudThemeProvider Theme="PlatformTheme.Theme" IsDarkMode="true" />
    <MudPopoverProvider />
    <MudDialogProvider MaxWidth="MaxWidth.Medium" FullWidth="true" />
    <MudSnackbarProvider />
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <PageTitle>Not authorized · HelmutCode Admin</PageTitle>
                            <div class="page-content">
                                <h1 class="page-title">Not authorized</h1>
                                <p class="page-subtitle">Your account doesn't have access to this page.</p>
                                <MudLink Href="/" Class="mt-4 d-inline-block">← Back to dashboard</MudLink>
                            </div>
                        </LayoutView>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <PageTitle>Page not found · HelmutCode Admin</PageTitle>
                <div class="page-content">
                    <h1 class="page-title">Page not found</h1>
                    <p class="page-subtitle">The link may be wrong or the page may have moved.</p>
                    <MudLink Href="/" Class="mt-4 d-inline-block">← Back to dashboard</MudLink>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
