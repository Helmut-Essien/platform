# Used by Docker Compose in free lab / production-style deploys.
# Copy to .env on the server and fill in real values. Never commit .env.

POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_KEY=change-me-to-at-least-32-random-characters-long
# Dedicated AES key for encrypted email outbox payloads (32+ random chars, or 32-byte base64).
# Do not reuse JWT_KEY in production.
EMAIL_OUTBOX_ENCRYPTION_KEY=change-me-to-a-separate-outbox-encryption-secret
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=ChangeMeToAStrongPassword1
# Optional: comma-separated SPA origins if the Blazor UI is hosted on a different host than the API.
# CORS_ORIGINS=https://admin.example.com
