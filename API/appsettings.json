{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Platform.Api",
    "Audience": "Platform.Client",
    "ExpiryMinutes": 60
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "Email": {
    "Provider": "Logging",
    "FromAddress": "noreply@platform.local",
    "FromName": "Platform License Hub",
    "ResendApiKey": "",
    "Outbox": {
      "PollIntervalSeconds": 10,
      "BatchSize": 20,
      "MaxAttempts": 10,
      "EncryptionKey": ""
    }
  },
  "Lifecycle": {
    "ExpiryReminderEnabled": true,
    "ExpiryReminderDays": 30,
    "ExpiryReminderAdditionalSteps": [
      7,
      1
    ],
    "ExpiryReminderPollHours": 24,
    "AutoSuspendOnOverdue": false,
    "OverduePollMinutes": 60
  },
  "Redis": {
    "ConnectionString": "",
    "ValidationCacheSeconds": 60,
    "IntegrationKeyLastUsedUpdateMinutes": 15
  },
  "RateLimiting": {
    "LicenseValidatePermitLimit": 60,
    "LicenseValidateWindowMinutes": 1,
    "AuthLoginPermitLimit": 10,
    "AuthLoginWindowMinutes": 5
  },
  "Auth": {
    "ClientBaseUrl": "http://localhost:5154"
  },
  "Cors": {
    "Origins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true,
        "IncludeScopes": false
      }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
